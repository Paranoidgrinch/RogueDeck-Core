@* The standalone WebAssembly host routes over the exact same pages/layout as the server Studio — they live in
   the Sandbox.Run RCL. *@
<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="new[] { typeof(RogueDeck.Sandbox.Run.Components.Pages.Home).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(RogueDeck.Sandbox.Run.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(RogueDeck.Sandbox.Run.Components.Layout.MainLayout)">
            <h1>Not found</h1>
            <p class="muted">There's nothing at this address. Try <a href="">Home</a>.</p>
        </LayoutView>
    </NotFound>
</Router>
