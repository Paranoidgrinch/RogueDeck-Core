@* The pages and layout live in the Sandbox.Run RCL so the server host (this app) and the standalone WebAssembly
   host route over the exact same components. *@
<Router AppAssembly="typeof(Program).Assembly"
        AdditionalAssemblies="new[] { typeof(RogueDeck.Sandbox.Run.Components.Pages.Home).Assembly }"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(RogueDeck.Sandbox.Run.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
