@inject RunDocument Doc
@inject ProjectDraft Draft
@implements IDisposable

@* The Map Rules tab: authors RunBlueprint.MapGeneration — the rules a run's map is generated from, per run, at
   start. Per-path minimums are guaranteed by construction; combat nodes draw a balanced encounter (see Balance
   tab). When generation is off the authored Run-tab map is used as-is. *@
<section style="padding:1rem; max-width:64rem">
    <TabIntro Title="Map Rules (procedural generation)"
              Text="Generate the run's map from rules instead of hand-authoring it. Guarantee per-path minimums (e.g. 2 elites, 2 shops), a minimum enemy count, and let each fight's difficulty be drawn to match the deck. Off means the Run-tab map is used unchanged."
              Connects="Uses the Encounters, Shops, Events, Workbenches and Balance tabs' content." />

    <label class="chk"><input type="checkbox" checked="@Enabled" @onchange="ToggleEnabled" />
        Generate the map per run</label>

    @if (_blueprint.MapGeneration is { } spec)
    {
        <div class="editor-card" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:1rem; margin:.75rem 0">
            <strong>Shape</strong>
            <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.4rem">
                <label>Rows <input type="number" value="@spec.Rows" style="width:5rem"
                                   @onchange="e => Save(spec with { Rows = AsInt(e.Value) })" /></label>
                <label>Min width <input type="number" value="@spec.MinWidth" style="width:5rem"
                                        @onchange="e => Save(spec with { MinWidth = AsInt(e.Value) })" /></label>
                <label>Max width <input type="number" value="@spec.MaxWidth" style="width:5rem"
                                        @onchange="e => Save(spec with { MaxWidth = AsInt(e.Value) })" /></label>
                <label>Min enemies / path <input type="number" value="@spec.MinEnemiesPerPath" style="width:5rem"
                                                 @onchange="e => Save(spec with { MinEnemiesPerPath = AsInt(e.Value) })" /></label>
                <label>Boss rooms <input type="number" min="1" value="@spec.BossRooms" style="width:5rem"
                                         @onchange="e => Save(spec with { BossRooms = AsInt(e.Value) })" /></label>
            </div>
            <p class="muted" style="margin-top:.5rem">
                @spec.Rows wide branch row(s) carry the variety; guaranteed minimums are met by narrow funnel rows
                inserted between them (only as many as the worst path still needs), then the act's boss room(s).
                Any Rows ≥ 1 builds. Rows = 0 with several boss rooms is a GAUNTLET act: back-to-back bosses,
                each drawn without repeating, and no room in between (so it can promise nothing per path).
            </p>
        </div>

        <div class="editor-card" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:1rem; margin:.75rem 0">
            <strong>Per-path minimums</strong>
            <span class="muted"> — every entry→boss path is guaranteed at least this many (met by funnel rows)</span>
            <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.4rem">
                @foreach (var kind in Reservable)
                {
                    var k = kind;
                    <label>@k <input type="number" min="0" value="@Get(spec.PerPathMinimums, k)" style="width:4.5rem"
                                     @onchange="e => Save(spec with { PerPathMinimums = WithKind(spec.PerPathMinimums, k, AsInt(e.Value)) })" /></label>
                }
            </div>
        </div>

        <div class="editor-card" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:1rem; margin:.75rem 0">
            <label><input type="checkbox" checked="@spec.WideGuaranteeRows"
                          @onchange="e => Save(spec with { WideGuaranteeRows = e.Value is bool b && b })" />
                Wide guarantee rows</label>
            <span class="muted"> — a guaranteed kind fills a FULL row instead of pinching the map into a width-1 funnel; the promise is the same, the branching survives</span>
        </div>

        <div class="editor-card" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:1rem; margin:.75rem 0">
            <strong>Per-path maximums</strong>
            <span class="muted"> — no entry→boss path may hold more than this (0 = unlimited); overshooting nodes become ordinary fights</span>
            <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.4rem">
                @foreach (var kind in Reservable)
                {
                    var k = kind;
                    <label>@k <input type="number" min="0" value="@Get(spec.PerPathMaximums, k)" style="width:4.5rem"
                                     @onchange="e => Save(spec with { PerPathMaximums = WithKind(spec.PerPathMaximums, k, AsInt(e.Value)) })" /></label>
                }
            </div>
        </div>

        <div class="editor-card" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:1rem; margin:.75rem 0">
            <strong>Column lanes</strong>
            <span class="muted"> — give the columns different flavours so the routes diverge; with no lanes every column uses the weights below</span>
            @for (var laneIndex = 0; laneIndex < spec.LaneProfiles.Count; laneIndex++)
            {
                var li = laneIndex;
                var lane = spec.LaneProfiles[li];
                <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.4rem">
                    <label>name <input value="@lane.Name" style="width:8rem"
                                       @onchange="e => SaveLane(li, lane with { Name = AsString(e.Value) })" /></label>
                    @foreach (var kind in Reservable)
                    {
                        var k = kind;
                        <label>@k <input type="number" min="0" value="@Get(lane.KindWeights, k)" style="width:4.5rem"
                                         @onchange="e => SaveLane(li, lane with { KindWeights = WithKind(lane.KindWeights, k, AsInt(e.Value)) })" /></label>
                    }
                    <button class="mini" @onclick="() => RemoveLane(li)">✕</button>
                </div>
            }
            <button class="mini" style="margin-top:.4rem" @onclick="AddLane">+ lane</button>
        </div>

        <div class="editor-card" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:1rem; margin:.75rem 0">
            <strong>Varied-row kind weights</strong>
            <span class="muted"> — how the wide branch rows fill their columns (the map's variety)</span>
            <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.4rem">
                @foreach (var kind in Reservable)
                {
                    var k = kind;
                    <label>@k <input type="number" min="0" value="@Get(spec.KindWeights, k)" style="width:4.5rem"
                                     @onchange="e => Save(spec with { KindWeights = WithKind(spec.KindWeights, k, AsInt(e.Value)) })" /></label>
                }
            </div>
        </div>

        <div class="editor-card" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:1rem; margin:.75rem 0">
            <strong>Map-wide minimums</strong>
            <span class="muted"> — totals across the whole graph (optional)</span>
            <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.4rem">
                @foreach (var kind in Reservable)
                {
                    var k = kind;
                    <label>@k <input type="number" min="0" value="@Get(spec.MapWideMinimums, k)" style="width:4.5rem"
                                     @onchange="e => Save(spec with { MapWideMinimums = WithKind(spec.MapWideMinimums, k, AsInt(e.Value)) })" /></label>
                }
            </div>
        </div>

        <div class="editor-card" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:1rem; margin:.75rem 0">
            <strong>Encounter pools</strong>
            <span class="muted"> — which fights each combat role draws (weighted; narrowed to the balance band)</span>
            @foreach (var role in CombatRoles)
            {
                var r = role;
                <div style="margin:.5rem 0">
                    <em>@r</em>
                    @{
                        var entries = spec.Encounters.For(r);
                    }
                    @if (entries.Count == 0)
                    {
                        <span class="muted"> — none yet</span>
                    }
                    <table style="border-collapse:collapse; margin:.25rem 0">
                        <tbody>
                            @for (var i = 0; i < entries.Count; i++)
                            {
                                var index = i;
                                var entry = entries[index];
                                <tr>
                                    <td style="padding:.1rem .5rem .1rem 0"><code>@entry.Encounter.Value</code></td>
                                    <td style="padding:.1rem .5rem">weight
                                        <input type="number" min="1" value="@entry.Weight" style="width:5rem"
                                               @onchange="e => Save(SetEntry(spec, r, index, entry with { Weight = Math.Max(1, AsInt(e.Value)) }))" /></td>
                                    <td><button class="mini" @onclick="() => Save(RemoveEntry(spec, r, index))">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div class="run-bar" style="gap:.4rem">
                        <input list="encounter-ids" placeholder="encounter id" @bind="_newEncounter[r]" @bind:event="oninput" style="width:14rem" />
                        <button class="mini" disabled="@string.IsNullOrWhiteSpace(_newEncounter[r])"
                                @onclick="() => AddEntry(spec, r)">+ encounter</button>
                    </div>
                </div>
            }
            <datalist id="encounter-ids">
                @foreach (var id in EncounterIds) { <option value="@id" /> }
            </datalist>
        </div>

        <div class="editor-card" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:1rem; margin:.75rem 0">
            <strong>Non-combat node references</strong>
            <span class="muted"> — which authored content a Shop / Workbench / Event-family node points at</span>
            <div style="margin-top:.4rem">
                @foreach (var (kind, listId) in NonCombatRefs)
                {
                    var k = kind;
                    <div class="run-bar" style="gap:.5rem; margin:.2rem 0">
                        <span style="min-width:6rem">@k</span>
                        <input list="@listId" value="@GetRef(spec, k)" placeholder="id" style="width:14rem"
                               @onchange="e => Save(spec with { NodeRefs = WithRef(spec.NodeRefs, k, e.Value?.ToString()) })" />
                    </div>
                }
            </div>
            <datalist id="event-ids">@foreach (var id in _blueprint.Events.Keys) { <option value="@id" /> }</datalist>
            <datalist id="shop-ids">@foreach (var id in _blueprint.Shops.Keys) { <option value="@id" /> }</datalist>
            <datalist id="workbench-ids">@foreach (var id in _blueprint.Workbenches.Keys) { <option value="@id" /> }</datalist>
        </div>

        <div class="editor-card" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:1rem; margin:.75rem 0">
            <strong>Difficulty band</strong>
            <span class="muted"> — the net (loadout + threat) each fight aims for, and how it deepens</span>
            <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.4rem">
                <label>Start net <input type="number" value="@spec.BalanceTargets.StartNet" style="width:5.5rem"
                                        @onchange="e => Save(spec with { BalanceTargets = spec.BalanceTargets with { StartNet = AsInt(e.Value) } })" /></label>
                <label>Net drop / row <input type="number" value="@spec.BalanceTargets.NetDropPerRow" style="width:5.5rem"
                                             @onchange="e => Save(spec with { BalanceTargets = spec.BalanceTargets with { NetDropPerRow = AsInt(e.Value) } })" /></label>
                <label>Loadout growth / row <input type="number" value="@spec.BalanceTargets.LoadoutGrowthPerRow" style="width:5.5rem"
                                                   @onchange="e => Save(spec with { BalanceTargets = spec.BalanceTargets with { LoadoutGrowthPerRow = AsInt(e.Value) } })" /></label>
                <label>Tolerance <input type="number" min="0" value="@spec.BalanceTargets.Tolerance" style="width:5.5rem"
                                        @onchange="e => Save(spec with { BalanceTargets = spec.BalanceTargets with { Tolerance = AsInt(e.Value) } })" /></label>
            </div>
        </div>

        @if (MapRulesProblems.Count > 0)
        {
        @* ── The second generator (map rework S11) ─────────────────────────────────────────────────────────
           Shape rules only: how long the act is, how it branches, what each route tastes like, how many rooms
           of each kind it holds and where, what a single route has to be worth, and how much a fork has to
           decide. What stands IN a room is the content above — either generator fills its rooms from it. *@
        <div class="editor-card" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:1rem; margin:.75rem 0">
            <strong>Second generator (v0.0.1 — strategic)</strong>
            <span class="muted"> — the other generator a player can pick at “New run”. It draws the act's SHAPE first and then fills it: no funnel rows, act-wide budgets instead of per-path promises, and a floor of challenge every route has to clear.</span>
            <div style="margin-top:.5rem">
                <label class="chk"><input type="checkbox" checked="@StrategicEnabled" @onchange="ToggleStrategic" />
                    Author strategic map rules</label>
            </div>

            @if (_blueprint.StrategicMapGeneration is { } str)
            {
                <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.6rem">
                    <label>Rows (whole act) <input type="number" min="1" value="@str.Rows" style="width:5rem"
                                                   @onchange="e => SaveStrategic(str with { Rows = AsInt(e.Value) })" /></label>
                    <label>Boss rooms <input type="number" min="0" value="@str.BossRooms" style="width:4.5rem"
                                             @onchange="e => SaveStrategic(str with { BossRooms = AsInt(e.Value) })" /></label>
                    <label>Min width <input type="number" min="1" value="@str.MinWidth" style="width:4.5rem"
                                            @onchange="e => SaveStrategic(str with { MinWidth = AsInt(e.Value) })" /></label>
                    <label>Max width <input type="number" min="1" value="@str.MaxWidth" style="width:4.5rem"
                                            @onchange="e => SaveStrategic(str with { MaxWidth = AsInt(e.Value) })" /></label>
                </div>
                <p class="muted" style="margin-top:.4rem">
                    Rows counts EVERY row including the boss rooms — it is the number of rooms a route walks,
                    unlike the backbone above, which grows by however many funnels it needs.
                </p>

                <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.4rem">
                    <label>Continue <input type="number" min="0" value="@str.Topology.ContinueWeight" style="width:4.5rem"
                                           @onchange="e => SaveStrategic(str with { Topology = str.Topology with { ContinueWeight = AsInt(e.Value) } })" /></label>
                    <label>Split <input type="number" min="0" value="@str.Topology.SplitWeight" style="width:4.5rem"
                                        @onchange="e => SaveStrategic(str with { Topology = str.Topology with { SplitWeight = AsInt(e.Value) } })" /></label>
                    <label>Merge <input type="number" min="0" value="@str.Topology.MergeWeight" style="width:4.5rem"
                                        @onchange="e => SaveStrategic(str with { Topology = str.Topology with { MergeWeight = AsInt(e.Value) } })" /></label>
                    <label>Branch lives (rows) <input type="number" min="0" value="@str.Topology.MinBranchLifeRows" style="width:4.5rem"
                                                      @onchange="e => SaveStrategic(str with { Topology = str.Topology with { MinBranchLifeRows = AsInt(e.Value) } })" /></label>
                    <label>Attempts <input type="number" min="1" value="@str.MaxGenerationAttempts" style="width:4.5rem"
                                           @onchange="e => SaveStrategic(str with { MaxGenerationAttempts = Math.Max(1, AsInt(e.Value)) })" /></label>
                </div>
                <p class="muted" style="margin-top:.4rem">
                    A row CONTINUES, SPLITS or MERGES by these weights. A branch that must live three rows makes
                    choosing a side a commitment; the real width knob is Max width, since every split above it has
                    to be paid for by a merge.
                </p>

                <div style="margin-top:.8rem"><strong>Route flavours</strong>
                    <span class="muted"> — a route's own character, carried by the route and not by a column. Neighbours in this list are related flavours a fork may step between; a weight of 0 means “never on this route”.</span>
                </div>
                @for (var laneIndex = 0; laneIndex < str.LaneProfiles.Count; laneIndex++)
                {
                    var li = laneIndex;
                    var lane = str.LaneProfiles[li];
                    <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.4rem">
                        <label>name <input value="@lane.Name" style="width:8rem"
                                           @onchange="e => SaveStrategicLane(li, lane with { Name = AsString(e.Value) })" /></label>
                        @foreach (var kind in Reservable)
                        {
                            var k = kind;
                            <label>@k <input type="number" min="0" value="@Get(lane.KindWeights, k)" style="width:4.5rem"
                                             @onchange="e => SaveStrategicLane(li, lane with { KindWeights = WithKind(lane.KindWeights, k, AsInt(e.Value)) })" /></label>
                        }
                        <button class="mini" @onclick="() => RemoveStrategicLane(li)">✕</button>
                    </div>
                }
                <button class="mini" style="margin-top:.4rem" @onclick="AddStrategicLane">+ flavour</button>

                <div style="margin-top:.8rem"><strong>Room budgets</strong>
                    <span class="muted"> — how many of each the ACT holds: a target it aims at, a minimum it promises, a ceiling it may not pass. Nothing is inserted to keep these, so the act keeps its shape.</span>
                </div>
                <table style="border-collapse:collapse; margin-top:.3rem">
                    <thead><tr><th style="text-align:left; padding-right:1rem">Role</th><th style="padding-right:.6rem">Min</th><th style="padding-right:.6rem">Target</th><th style="padding-right:.6rem">Max</th><th style="text-align:left">Earliest depth %</th></tr></thead>
                    <tbody>
                        @foreach (var kind in Reservable)
                        {
                            var k = kind;
                            var budget = str.Rooms.BudgetOf(k) ?? new RoomBudget();
                            <tr>
                                <td style="padding-right:1rem">@k</td>
                                <td><input type="number" min="0" value="@budget.Min" style="width:4rem"
                                           @onchange="e => SaveBudget(k, budget with { Min = AsInt(e.Value) })" /></td>
                                <td><input type="number" min="0" value="@budget.Target" style="width:4rem"
                                           @onchange="e => SaveBudget(k, budget with { Target = AsInt(e.Value) })" /></td>
                                <td><input type="number" min="0" value="@Unbounded(budget.Max)" style="width:4rem"
                                           @onchange="e => SaveBudget(k, budget with { Max = Bounded(AsInt(e.Value)) })" /></td>
                                <td><input type="number" min="0" max="100" value="@Get(str.Rooms.RoleMinimumDepthPercent, k)" style="width:4rem"
                                           @onchange="e => SaveStrategic(str with { Rooms = str.Rooms with { RoleMinimumDepthPercent = WithKind(str.Rooms.RoleMinimumDepthPercent, k, AsInt(e.Value)) } })" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="muted" style="margin-top:.3rem">Max 0 means unlimited. A budget says what the act holds; it says nothing about where — that is what the bands below are for.</p>

                <div style="margin-top:.8rem"><strong>Depth bands</strong>
                    <span class="muted"> — the same counts over one slice of the act's depth, so “five shops” cannot all stand in the opening third. Bands may not overlap and need not cover the act.</span>
                </div>
                @for (var bandIndex = 0; bandIndex < str.Rooms.DepthBands.Count; bandIndex++)
                {
                    var bi = bandIndex;
                    var band = str.Rooms.DepthBands[bi];
                    <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.4rem; align-items:flex-start">
                        <label>from % <input type="number" min="0" max="100" value="@band.StartPercent" style="width:4.5rem"
                                             @onchange="e => SaveBand(bi, band with { StartPercent = AsInt(e.Value) })" /></label>
                        <label>to % <input type="number" min="0" max="100" value="@band.EndPercent" style="width:4.5rem"
                                           @onchange="e => SaveBand(bi, band with { EndPercent = AsInt(e.Value) })" /></label>
                        @foreach (var kind in Reservable)
                        {
                            var k = kind;
                            var budget = band.BudgetOf(k) ?? new RoomBudget();
                            <label>@k <input type="number" min="0" value="@budget.Min" style="width:3.5rem" title="minimum in this band"
                                             @onchange="e => SaveBand(bi, band with { Budgets = WithBudget(band.Budgets, k, budget with { Min = AsInt(e.Value) }) })" />
                                <input type="number" min="0" value="@Unbounded(budget.Max)" style="width:3.5rem" title="ceiling in this band (0 = unlimited)"
                                       @onchange="e => SaveBand(bi, band with { Budgets = WithBudget(band.Budgets, k, budget with { Max = Bounded(AsInt(e.Value)) }) })" /></label>
                        }
                        <button class="mini" @onclick="() => RemoveBand(bi)">✕</button>
                    </div>
                }
                <button class="mini" style="margin-top:.4rem" @onclick="AddBand">+ band</button>

                <div style="margin-top:.8rem"><strong>Path pressure</strong>
                    <span class="muted"> — what one ROUTE has to be worth, in points per room. This is what replaces “every path holds two elites”: a route must carry enough challenge, however it comes by it.</span>
                </div>
                <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.3rem">
                    @foreach (var kind in Reservable)
                    {
                        var k = kind;
                        <label>@k <input type="number" min="0" value="@Get(str.PathPressure.KindPressure, k)" style="width:4.5rem"
                                         @onchange="e => SaveStrategic(str with { PathPressure = str.PathPressure with { KindPressure = WithKind(str.PathPressure.KindPressure, k, AsInt(e.Value)) } })" /></label>
                    }
                    <label>floor <input type="number" min="0" value="@str.PathPressure.Minimum" style="width:5rem"
                                        @onchange="e => SaveStrategic(str with { PathPressure = str.PathPressure with { Minimum = AsInt(e.Value) } })" /></label>
                    <label>ceiling <input type="number" min="0" value="@Unbounded(str.PathPressure.Maximum)" style="width:5rem"
                                          @onchange="e => SaveStrategic(str with { PathPressure = str.PathPressure with { Maximum = Bounded(AsInt(e.Value)) } })" /></label>
                </div>
                <p class="muted" style="margin-top:.3rem">The floor is a promise the generator keeps or says it could not. The ceiling is only ever reported — whether a spike is too hard depends on the deck.</p>

                <div style="margin-top:.8rem"><strong>Forks</strong>
                    <span class="muted"> — how much a choice has to decide, judged over the next few rows rather than the next room.</span>
                </div>
                <div class="run-bar" style="gap:1rem; flex-wrap:wrap; margin-top:.3rem">
                    <label>Minimum contrast <input type="number" min="0" value="@str.ForkQuality.MinimumContrast" style="width:5rem"
                                                   @onchange="e => SaveStrategic(str with { ForkQuality = str.ForkQuality with { MinimumContrast = AsInt(e.Value) } })" /></label>
                    <label>Decision horizon (rows) <input type="number" min="1" max="6" value="@str.ForkQuality.HorizonRows" style="width:4.5rem"
                                                          @onchange="e => SaveStrategic(str with { ForkQuality = str.ForkQuality with { HorizonRows = Math.Clamp(AsInt(e.Value), 1, ForkQualityRules.MaximumHorizonRows) } })" /></label>
                </div>

                <div style="margin-top:.8rem"><strong>Can this act be built?</strong></div>
                <pre style="white-space:pre-wrap; margin:.3rem 0; font-size:.85rem">@StrategicReport</pre>
            }
        </div>

            <div class="editor-card" style="border:1px solid #c0392b; border-radius:6px; padding:1rem; margin:.75rem 0">
                <strong style="color:#c0392b">Problems</strong>
                <ul style="margin:.4rem 0">
                    @foreach (var problem in MapRulesProblems) { <li>@Strip(problem)</li> }
                </ul>
            </div>
        }
        <div class="editor-card" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:1rem; margin:.75rem 0">
            <div class="run-bar" style="gap:.5rem">
                <strong>Preview</strong>
                <span class="muted">seed</span>
                <input type="number" @bind="_previewSeed" style="width:6rem" />
                <select @bind="_previewGenerator" title="which generator draws the preview">
                    <option value="@MapGenerators.RuleBased">v0.0.0 — rule-based</option>
                    <option value="@MapGenerators.Strategic">v0.0.1 — strategic</option>
                </select>
                <button class="play" @onclick="() => GeneratePreview(spec)">Generate preview</button>
            </div>

            @if (_previewError is { } error)
            {
                <p style="color:#c0392b; margin-top:.5rem">Cannot generate: @error</p>
            }
            else if (_preview is { } preview)
            {
                var constraintProblems = MapConstraintValidator.Validate(preview, spec);
                <p style="margin-top:.5rem; @(constraintProblems.Count == 0 ? "color:#2e7d32" : "color:#c0392b")">
                    @(constraintProblems.Count == 0
                        ? $"All constraints satisfied ({preview.Map.Nodes.Count} nodes)."
                        : $"{constraintProblems.Count} constraint problem(s):")
                </p>
                @if (constraintProblems.Count > 0)
                {
                    <ul>@foreach (var p in constraintProblems) { <li>@p</li> }</ul>
                }

                <div style="overflow:auto; border:1px solid #0002; border-radius:4px; margin:.5rem 0">
                    <svg width="@_previewSize.Width" height="@_previewSize.Height"
                         style="min-width:@(_previewSize.Width)px; background:#0001">
                        @foreach (var edge in preview.Map.Edges)
                        {
                            var a = Center(edge.From);
                            var b = Center(edge.To);
                            <line x1="@a.X" y1="@a.Y" x2="@b.X" y2="@b.Y" stroke="#8888" stroke-width="1.5" />
                        }
                        @foreach (var node in preview.Map.Nodes)
                        {
                            var pos = _previewPositions[node.Id];
                            var role = preview.Roles.GetValueOrDefault(node.Id);
                            <g>
                                <rect x="@pos.X" y="@pos.Y" width="@MapGraphLayout.NodeWidth" height="@MapGraphLayout.NodeHeight"
                                      rx="6" fill="@RoleColor(role)" stroke="#0004" />
                                <text x="@(pos.X + MapGraphLayout.NodeWidth / 2)" y="@(pos.Y + 20)"
                                      text-anchor="middle" font-size="12" fill="#111">@role</text>
                                <text x="@(pos.X + MapGraphLayout.NodeWidth / 2)" y="@(pos.Y + 36)"
                                      text-anchor="middle" font-size="10" fill="#333">@node.Id.Value</text>
                            </g>
                        }
                    </svg>
                </div>

                <details>
                    <summary class="muted">Difficulty band per row (assumed loadout @_previewLoadout)</summary>
                    <table style="border-collapse:collapse; margin:.4rem 0">
                        <thead><tr><th style="text-align:left; padding-right:1rem">Row</th><th style="text-align:left; padding-right:1rem">Assumed loadout</th><th style="text-align:left">Target net</th></tr></thead>
                        <tbody>
                            @for (var r = 0; r <= spec.Rows; r++)
                            {
                                <tr>
                                    <td style="padding-right:1rem">@r@(r == spec.Rows ? " (boss)" : "")</td>
                                    <td style="padding-right:1rem">@spec.BalanceTargets.AssumedLoadout(_previewLoadout, r)</td>
                                    <td>@spec.BalanceTargets.TargetNet(r)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </details>
            }
        </div>
    }
</section>

@code {
    private RunBlueprint _blueprint = default!;
    private readonly Dictionary<MapNodeKind, string> _newEncounter = new();

    private int _previewSeed = 1;
    private string _previewGenerator = MapGenerators.RuleBased;
    private GeneratedMap? _preview;
    private IReadOnlyDictionary<NodeId, (int X, int Y)> _previewPositions = new Dictionary<NodeId, (int, int)>();
    private (int Width, int Height) _previewSize;
    private int _previewLoadout;
    private string? _previewError;

    private static readonly MapNodeKind[] Reservable = MapGenerationSpec.GateKinds.ToArray();
    private static readonly MapNodeKind[] CombatRoles =
        { MapNodeKind.Combat, MapNodeKind.Elite, MapNodeKind.Boss };
    private static readonly (MapNodeKind, string)[] NonCombatRefs =
    {
        (MapNodeKind.Event, "event-ids"), (MapNodeKind.Shop, "shop-ids"), (MapNodeKind.Rest, "event-ids"),
        (MapNodeKind.Treasure, "event-ids"), (MapNodeKind.Workbench, "workbench-ids"),
    };

    protected override void OnInitialized()
    {
        _blueprint = Doc.Load();
        foreach (var role in CombatRoles) _newEncounter[role] = "";
        Draft.Changed += OnDraftChanged;
    }

    private void OnDraftChanged() => _ = InvokeAsync(() =>
    {
        try { _blueprint = Doc.Load(); }
        catch (Exception) { return; }
        StateHasChanged();
    });

    public void Dispose() => Draft.Changed -= OnDraftChanged;

    private bool Enabled => _blueprint.MapGeneration is not null;
    private IEnumerable<string> EncounterIds => _blueprint.Encounters.Select(e => e.Id.Value);
    private IReadOnlyList<string> MapRulesProblems =>
        RunDocumentValidator.ForTab(_blueprint, RunDocumentValidator.MapRulesTab);

    private static string Strip(string problem)
    {
        const string prefix = "Map Rules:";
        return (problem.StartsWith(prefix, StringComparison.Ordinal) ? problem[prefix.Length..] : problem).Trim();
    }

    private static int AsInt(object? v) => int.TryParse(v?.ToString(), out var n) ? n : 0;
    private static string AsString(object? v) => v?.ToString() ?? "";
    private static int Get(IReadOnlyDictionary<MapNodeKind, int> d, MapNodeKind k) => d.TryGetValue(k, out var v) ? v : 0;
    private static string GetRef(MapGenerationSpec spec, MapNodeKind k) => spec.NodeRefs.TryGetValue(k, out var v) ? v : "";

    private void ToggleEnabled(ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        Save(on ? new MapGenerationSpec { Rows = 5 } : null);
    }

    private void Save(MapGenerationSpec? spec)
    {
        _blueprint = _blueprint with { MapGeneration = spec };
        Doc.Save(_blueprint);
    }

    // ── the second generator (map rework S11) ───────────────────────────────────────
    private bool StrategicEnabled => _blueprint.StrategicMapGeneration is not null;

    // A new strategic spec starts from the defaults that work: an act about as long as a real one, one flavour,
    // and nothing promised. An author who turns it on and changes nothing gets a playable act, not a refusal.
    private void ToggleStrategic(ChangeEventArgs e)
    {
        var on = e.Value is bool b && b;
        SaveStrategic(on
            ? new StrategicActSpec
            {
                Rows = 12,
                LaneProfiles = [new MapLaneProfile("the way through", new Dictionary<MapNodeKind, int>
                {
                    [MapNodeKind.Combat] = 7,
                    [MapNodeKind.Event] = 3,
                })],
            }
            : null);
    }

    private void SaveStrategic(StrategicActSpec? spec)
    {
        _blueprint = _blueprint with { StrategicMapGeneration = spec };
        Doc.Save(_blueprint);
    }

    private void SaveStrategicLane(int index, MapLaneProfile lane)
    {
        if (_blueprint.StrategicMapGeneration is not { } spec)
            return;
        var lanes = spec.LaneProfiles.ToList();
        lanes[index] = lane;
        SaveStrategic(spec with { LaneProfiles = lanes });
    }

    private void AddStrategicLane()
    {
        if (_blueprint.StrategicMapGeneration is not { } spec)
            return;
        var lanes = spec.LaneProfiles.ToList();
        lanes.Add(new MapLaneProfile($"flavour {lanes.Count + 1}", new Dictionary<MapNodeKind, int>
        {
            [MapNodeKind.Combat] = 5,
        }));
        SaveStrategic(spec with { LaneProfiles = lanes });
    }

    // An act needs at least one flavour to draw its rooms by, so the last one does not go.
    private void RemoveStrategicLane(int index)
    {
        if (_blueprint.StrategicMapGeneration is not { } spec || spec.LaneProfiles.Count <= 1)
            return;
        var lanes = spec.LaneProfiles.ToList();
        lanes.RemoveAt(index);
        SaveStrategic(spec with { LaneProfiles = lanes });
    }

    private void SaveBudget(MapNodeKind kind, RoomBudget budget)
    {
        if (_blueprint.StrategicMapGeneration is not { } spec)
            return;
        SaveStrategic(spec with
        {
            Rooms = spec.Rooms with { RoomBudgets = WithBudget(spec.Rooms.RoomBudgets, kind, budget) },
        });
    }

    private void SaveBand(int index, DepthBandBudget band)
    {
        if (_blueprint.StrategicMapGeneration is not { } spec)
            return;
        var bands = spec.Rooms.DepthBands.ToList();
        bands[index] = band;
        SaveStrategic(spec with { Rooms = spec.Rooms with { DepthBands = bands } });
    }

    private void AddBand()
    {
        if (_blueprint.StrategicMapGeneration is not { } spec)
            return;
        var bands = spec.Rooms.DepthBands.ToList();
        var from = bands.Count == 0 ? 0 : Math.Min(100, bands.Max(band => band.EndPercent));
        bands.Add(new DepthBandBudget { StartPercent = from, EndPercent = Math.Min(100, from + 25) });
        SaveStrategic(spec with { Rooms = spec.Rooms with { DepthBands = bands } });
    }

    private void RemoveBand(int index)
    {
        if (_blueprint.StrategicMapGeneration is not { } spec)
            return;
        var bands = spec.Rooms.DepthBands.Where((_, i) => i != index).ToList();
        SaveStrategic(spec with { Rooms = spec.Rooms with { DepthBands = bands } });
    }

    // A budget of nothing at all is no budget: an author clearing every field removes the row rather than
    // leaving a zero that reads as "never place one".
    private static IReadOnlyDictionary<MapNodeKind, RoomBudget> WithBudget(
        IReadOnlyDictionary<MapNodeKind, RoomBudget> budgets, MapNodeKind kind, RoomBudget budget)
    {
        var next = new Dictionary<MapNodeKind, RoomBudget>(budgets);
        if (budget.Min == 0 && budget.Target == 0 && budget.Max == int.MaxValue)
            next.Remove(kind);
        else
            next[kind] = budget with { Target = Math.Clamp(budget.Target, budget.Min, budget.Max) };
        return next;
    }

    // An empty ceiling field means "no ceiling", which the engine spells int.MaxValue and a number box cannot.
    private static int Unbounded(int max) => max == int.MaxValue ? 0 : max;
    private static int Bounded(int value) => value <= 0 ? int.MaxValue : value;

    // What the act can and cannot be asked for, before a seed is spent on finding out.
    private string StrategicReport
    {
        get
        {
            if (_blueprint.StrategicMapGeneration is not { } spec)
                return "";
            try
            {
                return StrategicActSpecValidator.Validate(spec).Render();
            }
            catch (Exception ex)
            {
                return ex.Message;
            }
        }
    }

    // ── column lanes ────────────────────────────────────────────────────────────────
    private void SaveLane(int index, MapLaneProfile lane)
    {
        if (_blueprint.MapGeneration is not { } spec)
            return;
        var lanes = spec.LaneProfiles.ToList();
        lanes[index] = lane;
        Save(spec with { LaneProfiles = lanes });
    }

    private void AddLane()
    {
        if (_blueprint.MapGeneration is not { } spec)
            return;
        var lanes = spec.LaneProfiles.ToList();
        lanes.Add(new MapLaneProfile($"lane {lanes.Count + 1}", new Dictionary<MapNodeKind, int>
        {
            [MapNodeKind.Combat] = 5,
        }));
        Save(spec with { LaneProfiles = lanes });
    }

    private void RemoveLane(int index)
    {
        if (_blueprint.MapGeneration is not { } spec)
            return;
        var lanes = spec.LaneProfiles.ToList();
        lanes.RemoveAt(index);
        Save(spec with { LaneProfiles = lanes });
    }

    private static IReadOnlyDictionary<MapNodeKind, int> WithKind(
        IReadOnlyDictionary<MapNodeKind, int> d, MapNodeKind k, int v)
    {
        var next = new Dictionary<MapNodeKind, int>(d);
        if (v <= 0) next.Remove(k); else next[k] = v;
        return next;
    }

    private static IReadOnlyDictionary<MapNodeKind, string> WithRef(
        IReadOnlyDictionary<MapNodeKind, string> d, MapNodeKind k, string? v)
    {
        var next = new Dictionary<MapNodeKind, string>(d);
        if (string.IsNullOrWhiteSpace(v)) next.Remove(k); else next[k] = v.Trim();
        return next;
    }

    // ── Encounter-pool edits (rebuild the role's list) ──
    private static MapGenerationSpec WithEntries(
        MapGenerationSpec spec, MapNodeKind role, IReadOnlyList<EncounterPoolEntry> entries)
    {
        var byRole = new Dictionary<MapNodeKind, IReadOnlyList<EncounterPoolEntry>>(spec.Encounters.ByRole);
        if (entries.Count == 0) byRole.Remove(role); else byRole[role] = entries;
        return spec with { Encounters = spec.Encounters with { ByRole = byRole } };
    }

    private static MapGenerationSpec SetEntry(MapGenerationSpec spec, MapNodeKind role, int index, EncounterPoolEntry entry)
    {
        var list = spec.Encounters.For(role).ToList();
        if (index >= 0 && index < list.Count) list[index] = entry;
        return WithEntries(spec, role, list);
    }

    private static MapGenerationSpec RemoveEntry(MapGenerationSpec spec, MapNodeKind role, int index)
    {
        var list = spec.Encounters.For(role).Where((_, i) => i != index).ToList();
        return WithEntries(spec, role, list);
    }

    private void AddEntry(MapGenerationSpec spec, MapNodeKind role)
    {
        var id = _newEncounter[role].Trim();
        if (id.Length == 0) return;
        var list = spec.Encounters.For(role).ToList();
        list.Add(new EncounterPoolEntry(new EncounterId(id)));
        _newEncounter[role] = "";
        Save(WithEntries(spec, role, list));
    }

    // ── Preview: generate a sample map from the current spec + seed and render it, without touching the doc ──
    //
    // Either generator draws it, because the point of a preview is to see what the player will see and the
    // player picks. The strategic one uses the shape rules above and the SAME content rules — which is exactly
    // how a run does it.
    private void GeneratePreview(MapGenerationSpec spec)
    {
        try
        {
            var start = _blueprint.ResolveStart(null);
            var balance = new BalanceCalculator(_blueprint.Balance, _blueprint.Encounters);
            _previewLoadout = balance.LoadoutStrength(start, _blueprint.Deck);
            _preview = MapGenerators.IsStrategic(_previewGenerator)
                && _blueprint.StrategicMapGeneration is { } strategic
                ? StrategicMapRealizer.Realize(
                    StrategicMapGenerator.Generate(strategic, _previewSeed), spec, _previewLoadout, balance,
                    (kind, _, encounter, nodeRef) => MapNodeRealizer.Realize(spec, kind, encounter, nodeRef))
                : RuleBasedMapGenerator.Generate(
                spec, _previewSeed, _previewLoadout, balance,
                (kind, _, encounter, nodeRef) => MapNodeRealizer.Realize(spec, kind, encounter, nodeRef));
            _previewPositions = MapGraphLayout.Resolve(_preview.Map);
            _previewSize = MapGraphLayout.CanvasSize(_previewPositions);
            _previewError = null;
        }
        catch (Exception ex)
        {
            _preview = null;
            _previewError = ex.Message;
        }
    }

    private (int X, int Y) Center(NodeId id)
    {
        var pos = _previewPositions[id];
        return (pos.X + MapGraphLayout.NodeWidth / 2, pos.Y + MapGraphLayout.NodeHeight / 2);
    }

    private static string RoleColor(MapNodeKind kind) => kind switch
    {
        MapNodeKind.Combat => "#c9c2b6",
        MapNodeKind.Elite => "#e0917a",
        MapNodeKind.Boss => "#c0392b",
        MapNodeKind.Shop => "#e6c86e",
        MapNodeKind.Event => "#8fb8de",
        MapNodeKind.Rest => "#9ccc9c",
        MapNodeKind.Treasure => "#c9a0dc",
        MapNodeKind.Workbench => "#c8a27a",
        _ => "#dddddd",
    };
}
