@inject RunDocument Doc
@inject ProjectDraft Draft
@implements IDisposable

@* The dedicated Relics tab: a lens over the shared run document (RunDocument), hosting the existing RelicEditor.
   Run reactions (face a) + combat rules (face b) are authored here and persist in the one ProjectDraft document,
   so the Run tab and the other focused tabs see the same relics. *@
<section style="padding:1rem; max-width:70rem">
    <TabIntro Title="Relics"
              Text="Passive items the player collects and keeps. A relic reacts to things happening in the run (e.g. gain gold after every fight) and can add standing rules to every fight while it is owned (e.g. thorns: gain block when hit)."
              Connects="Give the player a relic from an Event choice, a Shop, or a reward." />
    <IdDatalists Blueprint="_blueprint" />

    <RelicEditor Blueprint="_blueprint" BlueprintChanged="OnChanged" />
</section>

@code {
    private RunBlueprint _blueprint = default!;

    protected override void OnInitialized()
    {
        _blueprint = Doc.Load();
        Draft.Changed += OnDraftChanged;
    }

    // Reload when the document changes elsewhere in this circuit (the nav's global Undo) so the tab never shows
    // a stale copy. Self-echoes (our own Save) reload the data we just wrote — harmless.
    private void OnDraftChanged() => _ = InvokeAsync(() =>
    {
        try
        {
            _blueprint = Doc.Load();
        }
        catch (Exception)
        {
            return; // mid-edit the Run-tab JSON may not parse; keep the last good copy
        }
        StateHasChanged();
    });

    public void Dispose() => Draft.Changed -= OnDraftChanged;

    private void OnChanged(RunBlueprint blueprint)
    {
        Doc.Save(blueprint);
        _blueprint = blueprint;
    }
}
