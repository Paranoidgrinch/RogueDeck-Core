@rendermode InteractiveServer
@inject RunDocument Doc

@* The dedicated Statuses tab: a lens over the shared run document (RunDocument), hosting the StatusEditor.
   Custom status definitions authored here persist in the one ProjectDraft document and are registered into every
   combat by RunPlayback.BuildContent, so cards / relics / enemy actions that apply them resolve the status. *@
<section style="padding:1rem; max-width:72rem">
    <TabIntro Title="Statuses"
              Text="Custom buffs and debuffs. A status can passively change values while it is on a unit (damage dealt or taken, block gained, card costs), run an effect program when something happens to its bearer, and intercept effects (block incoming debuffs, prevent death)."
              Connects="Apply a status from any card, enemy or relic program using its id." />
    <IdDatalists Blueprint="_blueprint" />

    <StatusEditor Blueprint="_blueprint" BlueprintChanged="OnChanged" />
</section>

@code {
    private RunBlueprint _blueprint = default!;

    protected override void OnInitialized() => _blueprint = Doc.Load();

    private void OnChanged(RunBlueprint blueprint)
    {
        Doc.Save(blueprint);
        _blueprint = blueprint;
    }
}
