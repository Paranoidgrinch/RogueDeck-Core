@* The live view of an in-progress run: event choices, entity picks, the interactive fight (when an
   InteractiveCombatDriver is surfacing one), plus the between-combat inventory and the run log. Extracted from
   RunSandbox so the same session UI can be reused by the Playtest tab (a one-encounter run). The host owns the
   session/driver lifecycle and re-renders this component when they change (their Changed events); this component
   only owns the transient pick state (_selected / _combatTarget). *@
@if (Session is { } session)
{
    <section class="panel">
        @if (session.Error is { } runError)
        {
            <p class="error">@runError</p>
        }
        else if (session.IsAwaitingChoice && session.PendingSituation is { } situation)
        {
            <h2>@situation.TextKey</h2>
            <div class="choices">
                @foreach (var choice in session.PendingChoices)
                {
                    <button class="play" @onclick="() => session.Pick(choice.Id)">
                        @(string.IsNullOrEmpty(choice.TextKey) ? choice.Id : choice.TextKey)
                    </button>
                }
            </div>
        }
        else if (session.IsAwaitingEntities && session.PendingEntities is { } request)
        {
            <h2>@request.Purpose</h2>
            <p class="muted">Pick @request.Count.</p>
            <div class="choices">
                @for (var i = 0; i < request.Displays.Count; i++)
                {
                    var index = i;
                    <button class="play @(_selected.Contains(index) ? "active" : "")"
                            @onclick="() => ToggleEntity(index)">
                        @request.Displays[index]
                    </button>
                }
            </div>
            <button class="play" disabled="@(_selected.Count != request.Count)" @onclick="ConfirmEntities">
                Confirm (@_selected.Count/@request.Count)
            </button>
        }
        else if (session.IsAwaitingNodeChoice)
        {
            <h2>Choose your path</h2>
            <p class="muted">The map branches here — pick the node to walk to next.</p>
            <div class="choices">
                @foreach (var node in session.PendingNodeChoices)
                {
                    var nodeId = node.Id.Value;
                    <button class="play" @onclick="() => session.PickNode(nodeId)">
                        @nodeId <span class="muted">(@node.Type.Value)</span>
                    </button>
                }
            </div>
        }
        else if (session.IsAwaitingInterlude)
        {
            <h2>Before the next node</h2>
            <p class="muted">Check your inventory and deck below; spend consumables, then continue.</p>
            @if (session.Run.Consumables.Any(c => c.UseEffects.Count > 0))
            {
                <div class="choices">
                    @foreach (var consumable in session.Run.Consumables.Where(c => c.UseEffects.Count > 0))
                    {
                        <button class="mini" @onclick="() => session.UseConsumable(consumable.Id)">use @consumable.DefinitionId.Value</button>
                    }
                </div>
            }
            <button class="play" @onclick="() => session.Continue()">Continue ▸</button>
        }
        else if (CombatDriver?.Current is { } combat)
        {
            <h2>Combat — round @combat.Round</h2>
            <div class="row"><span class="muted">Resources</span> @ResourcePoolsLine(combat.State.GetCombatant(combat.HeroId))</div>
            @foreach (var c in combat.State.Combatants)
            {
                <div class="row">
                    <strong>@(c.Id == combat.HeroId ? (HeroName ?? "You") : EnemyName(c.Id))</strong>
                    <span class="muted">
                        @c.Health.Current/@c.Health.Max HP@(Block(c) > 0 ? $" · 🛡{Block(c)}" : "")@(c.IsAlive ? "" : " 💀")
                    </span>
                    @if (c.Statuses.Count > 0)
                    {
                        <span class="muted">· @CombatStatusLine(c)</span>
                    }
                </div>
            }
            @if (ActiveCardChoice is { } cardChoice)
            {
                @CardChoicePrompt(cardChoice)
            }
            else if (combat.IsHeroTurn)
            {
                @* Chosen-target cards (eventTarget) can aim at ANYONE alive — enemies first, then yourself and
                   your allies (buffs, block, heals). Cards targeting "source"/fixed selectors ignore this. *@
                <div class="row">
                    <span class="muted">Target</span>
                    <select @bind="_combatTarget">
                        @foreach (var c in combat.State.Combatants
                            .Where(x => x.IsAlive)
                            .OrderBy(x => x.TeamId == StandardCombatIds.EnemyTeam ? 0 : 1))
                        {
                            <option value="@c.Id.value">
                                @(c.Id == combat.HeroId ? $"{HeroName ?? "You"} (you)"
                                    : c.TeamId == StandardCombatIds.EnemyTeam ? EnemyName(c.Id)
                                    : $"{EnemyName(c.Id)} (ally)")
                            </option>
                        }
                    </select>
                </div>
                <div class="choices">
                    @foreach (var card in combat.Hand)
                    {
                        <button class="play" disabled="@(!CanPay(combat.State.GetCombatant(combat.HeroId), card.DefinitionId.value))"
                                @onclick="() => PlayCombatCard(card.Id)">
                            @CardName(card.DefinitionId.value) @CostLabel(card.DefinitionId.value)
                        </button>
                    }
                    @if (combat.Hand.Count == 0)
                    {
                        <span class="muted">(empty hand)</span>
                    }
                </div>
                <button class="play" @onclick="EndCombatTurn">End turn ▸</button>
                @if (session.Run.Consumables.Any(c => c.CombatUse is not null))
                {
                    <div class="row">
                        <span class="muted">Consumables</span>
                        @foreach (var consumable in session.Run.Consumables.Where(c => c.CombatUse is not null))
                        {
                            <button class="mini" @onclick="() => UseConsumableInCombat.InvokeAsync(consumable.Id)">use @consumable.DefinitionId.Value</button>
                        }
                    </div>
                }
            }
            else
            {
                <p class="muted">Resolving enemy actions…</p>
            }
        }
        else if (PartyCombatDriver?.Current is { } party)
        {
            @* Interactive party combat (party deckbuilding C2 follow-up): all living members are "in their turn" at
               once. Each member plays from its OWN hand/energy and ends independently; when the last one ends the
               enemy phase resolves and a fresh player phase opens. *@
            <h2>Party combat — round @party.Round</h2>
            @foreach (var c in party.State.Combatants)
            {
                var isPlayer = c.TeamId == StandardCombatIds.PlayerTeam;
                var ended = isPlayer && party.HasEnded(c.Id);
                <div class="row">
                    <strong>@PartyCombatantName(c)</strong>
                    <span class="muted">
                        @c.Health.Current/@c.Health.Max HP@(Block(c) > 0 ? $" · 🛡{Block(c)}" : "")@(c.IsAlive ? "" : " 💀")@(ended && c.IsAlive ? " · ended ✓" : "")
                    </span>
                    @if (c.Statuses.Count > 0)
                    {
                        <span class="muted">· @CombatStatusLine(c)</span>
                    }
                </div>
            }

            @* Chosen-target cards (eventTarget) can aim at ANYONE alive — enemies first, then the party and its
               units (buffs, block, heals land on your own side too). *@
            <div class="row">
                <span class="muted">Target</span>
                <select @bind="_combatTarget">
                    @foreach (var c in party.State.Combatants
                        .Where(x => x.IsAlive)
                        .OrderBy(x => x.TeamId == StandardCombatIds.EnemyTeam ? 0 : 1))
                    {
                        <option value="@c.Id.value">
                            @(c.TeamId == StandardCombatIds.EnemyTeam
                                ? EnemyName(c.Id)
                                : $"{PartyCombatantName(c)} (ally)")
                        </option>
                    }
                </select>
            </div>

            @if (ActiveCardChoice is { } partyCardChoice)
            {
                @* A member's play parked mid-resolution on a card choice; show it and hide the member panels. *@
                @CardChoicePrompt(partyCardChoice)
            }
            else if (party.ActiveMembers().Count == 0)
            {
                <p class="muted">Resolving…</p>
            }
            else
            {
                @foreach (var memberId in party.ActiveMembers())
                {
                    var mid = memberId;
                    <div class="panel" style="border:1px solid var(--border,#ccc); border-radius:6px; padding:.5rem; margin:.5rem 0">
                        <div class="row">
                            <strong>@PartyMemberName(mid)</strong>
                            <span class="muted">@ResourcePoolsLine(party.State.GetCombatant(mid))</span>
                        </div>
                        <div class="choices">
                            @foreach (var card in party.HandOf(mid))
                            {
                                <button class="play" disabled="@(!CanPay(party.State.GetCombatant(mid), card.DefinitionId.value))"
                                        @onclick="() => PlayPartyCard(mid, card.Id)">
                                    @CardName(card.DefinitionId.value) @CostLabel(card.DefinitionId.value)
                                </button>
                            }
                            @if (party.HandOf(mid).Count == 0)
                            {
                                <span class="muted">(empty hand)</span>
                            }
                        </div>
                        <button class="play" @onclick="() => EndPartyTurn(mid)">End @PartyMemberName(mid)'s turn ▸</button>
                    </div>
                }
            }
        }
        else if (session.IsComplete)
        {
            <h2>Run complete</h2>
            <div class="row"><span class="muted">Outcome</span> <strong>@session.Run.Result</strong></div>
        }
        else
        {
            <p class="muted">Resolving…</p>
        }

        @* Inventory — a read-only lens over everything the hero carries between combats in this run. *@
        <h2>Inventory</h2>
        <div class="row"><span class="muted">HP</span> @session.Run.Health.Current / @session.Run.Health.Max</div>
        <div class="row"><span class="muted">Resources</span>
            @(session.Run.Resources.Count == 0 ? "none"
                : string.Join(", ", session.Run.Resources.OrderBy(r => r.Key.Value).Select(r => $"{r.Key.Value} {r.Value}")))
        </div>
        <div class="row"><span class="muted">Relics</span>
            @(session.Run.Relics.Count == 0 ? "none" : string.Join(", ",
                session.Run.Relics.Select(r => r.Definition.DisplayName + (r.Enabled ? "" : " (disabled)"))))
        </div>
        <div class="row"><span class="muted">Consumables</span>
            @if (session.Run.Consumables.Count == 0)
            {
                <text>none</text>
            }
            else if (session.IsAwaitingChoice)
            {
                @* At an event the run loop is safely parked, so a held consumable can be spent (applied on the loop
                   thread), then the same choice re-parks. *@
                @foreach (var consumable in session.Run.Consumables)
                {
                    <button class="mini" @onclick="() => session.UseConsumable(consumable.Id)">use @consumable.DefinitionId.Value</button>
                }
            }
            else
            {
                @string.Join(", ", session.Run.Consumables.GroupBy(c => c.DefinitionId.Value).Select(Tally))
                <span class="muted"> (usable at events)</span>
            }
        </div>
        <div class="row"><span class="muted">Deck (@session.Run.Deck.Count)</span>
            @(session.Run.Deck.Count == 0 ? "empty" : string.Join(", ",
                session.Run.Deck.GroupBy(DeckCardLabel).Select(Tally)))
        </div>
        @if (session.Run.Flags.Count > 0)
        {
            <div class="row"><span class="muted">Flags</span> @string.Join(", ", session.Run.Flags)</div>
        }
        @foreach (var counter in session.Run.Counters)
        {
            <div class="row"><span class="muted">@counter.Key</span> @counter.Value</div>
        }
    </section>

    @* Party roster (party deckbuilding C2): a read-only per-member lens over the run's party — each member's HP,
       wallet, deck size, relics, and consumables. Only shown for a real party (>1 member); the Inventory panel
       above already covers the single hero. A downed member (0 HP) is flagged but kept — the run continues. *@
    @if (session.Run.Party.Count > 1)
    {
        <section class="panel">
            <h2>Party (@session.Run.Party.Count)</h2>
            <p class="muted">Per-member HP is reconciled here after each fight. Interactive runs let you drive each
                member's turn in the fight above; non-interactive runs auto-resolve the simultaneous phase.</p>
            @for (var i = 0; i < session.Run.Party.Count; i++)
            {
                var member = session.Run.Party[i];
                var downed = member.Health.Current <= 0;
                <div class="row">
                    <strong>@(i == 0 ? (HeroName ?? "Hero") : member.DisplayNameKey)</strong>
                    <span class="muted">
                        @member.Health.Current/@member.Health.Max HP@(downed ? " 💀 downed" : "")
                        · 🪙 @member.GetResource(StandardRunIds.Gold)
                        · deck @member.Deck.Count
                        @if (member.Relics.Count > 0)
                        {
                            <text> · relics @string.Join(", ", member.Relics.Select(r => r.Definition.DisplayName))</text>
                        }
                        @if (member.Consumables.Count > 0)
                        {
                            <text> · consumables @string.Join(", ", member.Consumables.GroupBy(c => c.DefinitionId.Value).Select(Tally))</text>
                        }
                    </span>
                </div>
            }
        </section>
    }

    <section class="panel">
        <h2>Run log</h2>
        <ul class="log">
            @foreach (var entry in session.Run.Log)
            {
                <li><span class="line-kind">@entry.Type</span> @entry.Message</li>
            }
        </ul>
    </section>
}

@code {
    // The in-progress run to render; the host builds/starts it and re-renders us on its Changed events.
    [Parameter, EditorRequired] public InteractiveRunSession? Session { get; set; }

    // The interactive combat driver, present only when the host chose interactive fights; null = fights auto-resolve.
    [Parameter] public InteractiveCombatDriver? CombatDriver { get; set; }

    // The party interactive combat driver, present only for an interactive party run (party deckbuilding C2).
    [Parameter] public PartyInteractiveCombatDriver? PartyCombatDriver { get; set; }

    // Invoked when the player uses a consumable during a live fight (the host routes it to RunPlayback, which runs
    // the consumable's combat-use program on the combat and removes it from the run inventory).
    [Parameter] public EventCallback<ConsumableInstanceId> UseConsumableInCombat { get; set; }

    // Per-card energy cost + display name, and per-enemy display name, so the fight view can grey out unaffordable
    // cards and show human-readable names. Keyed by the raw definition/enemy id.
    [Parameter] public IReadOnlyDictionary<string, int> CardCosts { get; set; } = new Dictionary<string, int>();
    [Parameter] public IReadOnlyDictionary<string, string> CardNames { get; set; } = new Dictionary<string, string>();
    [Parameter] public IReadOnlyDictionary<string, string> EnemyNames { get; set; } = new Dictionary<string, string>();
    [Parameter] public string? HeroName { get; set; }

    // The FULL authored cost list per card id (energy AND custom resources like embers/blood) plus display names
    // for the custom combat resources — so cost labels, affordability greying and the resource line cover the
    // whole economy, not just energy. Hosts that don't supply them keep the energy-only behaviour.
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<ResourceCost>>? CardFullCosts { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string> ResourceNames { get; set; } = new Dictionary<string, string>();

    private IReadOnlyList<ResourceCost> FullCosts(string definitionId) =>
        CardFullCosts is not null && CardFullCosts.TryGetValue(definitionId, out var costs)
            ? costs
            : new[] { new ResourceCost(StandardCombatIds.EnergyResource, CardEnergyCost(definitionId)) };

    private string ResourceLabel(ResourceId id) =>
        id == StandardCombatIds.EnergyResource ? "⚡"
        : ResourceNames.TryGetValue(id.value, out var name) ? name + " "
        : id.value + " ";

    // "⚡1 · Embers 2" — every cost the card charges; zero-cost cards read "⚡0".
    private string CostLabel(string definitionId)
    {
        var costs = FullCosts(definitionId);
        return costs.Count == 0
            ? "⚡0"
            : string.Join(" · ", costs.Select(c => $"{ResourceLabel(c.ResourceId)}{c.Amount}"));
    }

    // Whether the combatant can pay ALL of the card's costs right now (energy and custom resources alike).
    private bool CanPay(CombatantState payer, string definitionId) =>
        FullCosts(definitionId).All(cost =>
            payer.Resources.TryGetValue(cost.ResourceId, out var pool) && pool.Current >= cost.Amount);

    // "⚡ 3/3 · Embers 1/10 · Blood 0/5" — every resource pool the combatant carries, energy first.
    private string ResourcePoolsLine(CombatantState combatant)
    {
        var pools = combatant.Resources
            .OrderBy(p => p.Key == StandardCombatIds.EnergyResource ? 0 : 1)
            .ThenBy(p => p.Key.value, StringComparer.Ordinal)
            .Select(p => $"{ResourceLabel(p.Key).TrimEnd()} {p.Value.Current}{(p.Value.Max is { } max ? $"/{max}" : "")}");
        var line = string.Join(" · ", pools);
        return line.Length == 0 ? "—" : line;
    }

    // Transient pick state, owned here: which entity-request options are selected, the current attack target, and
    // which candidate cards are selected for a pending in-combat card choice (keyed by card instance id).
    private readonly HashSet<int> _selected = new();
    private readonly HashSet<string> _cardPicks = new();
    private string _combatTarget = "";

    private void ToggleEntity(int index)
    {
        var count = Session?.PendingEntities?.Count ?? 0;
        if (_selected.Contains(index))
            _selected.Remove(index);
        else
        {
            if (count == 1)
                _selected.Clear();
            if (_selected.Count < count)
                _selected.Add(index);
        }
    }

    private void ConfirmEntities()
    {
        var indices = _selected.ToList();
        _selected.Clear();
        Session?.PickEntities(indices);
    }

    private void PlayCombatCard(CardInstanceId cardId)
    {
        var combat = CombatDriver?.Current;
        if (combat is null)
            return;
        var target = !string.IsNullOrEmpty(_combatTarget)
            ? new CombatantId(_combatTarget)
            : combat.State.Combatants.FirstOrDefault(c => c.Id != combat.HeroId && c.IsAlive)?.Id;
        CombatDriver!.PlayCard(cardId, target);
    }

    private void EndCombatTurn() => CombatDriver?.EndTurn();

    // ── in-combat card choice (in-combat card targeting, e.g. Armaments) ────────────
    // Whichever interactive driver is live surfaces the pending choice; the same prompt/helpers serve both.
    private IReadOnlyList<CardInstance>? ActiveCardChoice =>
        CombatDriver?.PendingCardChoice ?? PartyCombatDriver?.PendingCardChoice;

    private int ActiveCardChoiceCount =>
        CombatDriver?.PendingCardChoice is not null ? CombatDriver.PendingCardChoiceCount
        : PartyCombatDriver?.PendingCardChoiceCount ?? 0;

    private string ActiveCardChoicePurpose =>
        CombatDriver?.PendingCardChoice is not null ? CombatDriver.PendingCardChoicePurpose
        : PartyCombatDriver?.PendingCardChoicePurpose ?? "";

    private void SupplyActiveCardChoice(IReadOnlyList<CardInstanceId> picks)
    {
        if (CombatDriver?.PendingCardChoice is not null)
            CombatDriver.SupplyCardChoice(picks);
        else
            PartyCombatDriver?.SupplyCardChoice(picks);
    }

    // A pending in-combat card choice: for a single pick, clicking a candidate supplies it immediately; for a
    // multi-pick, toggle candidates into the set and Confirm supplies them together.
    private void ToggleCardPick(CardInstanceId cardId)
    {
        if (ActiveCardChoiceCount <= 1)
        {
            _cardPicks.Clear();
            SupplyActiveCardChoice(new[] { cardId });
            return;
        }
        if (!_cardPicks.Remove(cardId.value) && _cardPicks.Count < ActiveCardChoiceCount)
            _cardPicks.Add(cardId.value);
    }

    private void ConfirmCardPicks()
    {
        var choice = ActiveCardChoice;
        if (choice is null)
            return;
        var picks = choice.Where(c => _cardPicks.Contains(c.Id.value)).Select(c => c.Id).ToArray();
        _cardPicks.Clear();
        SupplyActiveCardChoice(picks);
    }

    // The shared card-choice prompt (used by both the single-hero and party combat views): candidate cards as
    // buttons (single pick supplies immediately; multi-pick toggles then Confirm), hiding the normal hand controls.
    private RenderFragment CardChoicePrompt(IReadOnlyList<CardInstance> choice) =>
        @<text>
            <h2>@ActiveCardChoicePurpose</h2>
            <p class="muted">Pick @ActiveCardChoiceCount.</p>
            <div class="choices">
                @foreach (var card in choice)
                {
                    var cid = card.Id;
                    <button class="play @(_cardPicks.Contains(cid.value) ? "active" : "")"
                            @onclick="() => ToggleCardPick(cid)">
                        @CardName(card.DefinitionId.value)
                    </button>
                }
            </div>
            @if (ActiveCardChoiceCount > 1)
            {
                <button class="play" disabled="@(_cardPicks.Count != ActiveCardChoiceCount)"
                        @onclick="ConfirmCardPicks">
                    Confirm (@_cardPicks.Count/@ActiveCardChoiceCount)
                </button>
            }
        </text>;

    // ── party combat (party deckbuilding C2 follow-up) ──────────────────────────────
    private void PlayPartyCard(CombatantId member, CardInstanceId cardId)
    {
        var party = PartyCombatDriver?.Current;
        if (party is null)
            return;
        var target = !string.IsNullOrEmpty(_combatTarget)
            ? new CombatantId(_combatTarget)
            : party.State.Combatants.FirstOrDefault(c => c.TeamId == StandardCombatIds.EnemyTeam && c.IsAlive)?.Id;
        PartyCombatDriver!.PlayCardFor(member, cardId, target);
    }

    private void EndPartyTurn(CombatantId member) => PartyCombatDriver?.EndTurnFor(member);

    // A player member's display name (from the run's party by matching combatant id), the hero name for the hero
    // combatant, else the raw id. Enemy names go through EnemyName.
    private string PartyMemberName(CombatantId id) =>
        Session?.Run.Party.FirstOrDefault(m => m.Id.Value == id.value)?.DisplayNameKey
        ?? (HeroName ?? id.value);

    // A player-team combatant that is NOT a party member (a board unit, a summon) carries its own authored
    // display name — fall back to that, not to the hero's name.
    private string PartyCombatantName(CombatantState c) =>
        c.TeamId == StandardCombatIds.EnemyTeam
            ? EnemyName(c.Id)
            : Session?.Run.Party.FirstOrDefault(m => m.Id.Value == c.Id.value)?.DisplayNameKey
              ?? (IsHeroCombatant(c.Id) ? HeroName ?? c.DisplayNameKey : c.DisplayNameKey);

    private bool IsHeroCombatant(CombatantId id) =>
        Session?.Run.Party.FirstOrDefault()?.Id.Value == id.value || id.value == "hero";

    private int CardEnergyCost(string definitionId) => CardCosts.TryGetValue(definitionId, out var cost) ? cost : 0;

    private string CardName(string definitionId) => CardNames.TryGetValue(definitionId, out var name) ? name : definitionId;

    private string EnemyName(CombatantId id) => EnemyNames.TryGetValue(id.value, out var name) ? name : id.value;

    // A deck card's display name plus one "+" per upgrade level (matches the run's "+"-suffix upgrade convention).
    private string DeckCardLabel(RunCardInstance card) => CardName(card.DefinitionId.value) + new string('+', card.UpgradeLevel);

    // "Strike ×3" for a group of copies, or just "Strike" for a single one.
    private static string Tally<T>(IGrouping<string, T> group) => group.Count() > 1 ? $"{group.Key} ×{group.Count()}" : group.Key;

    private static int Block(CombatantState c) =>
        c.DefensivePools.TryGetValue(StandardCombatIds.BlockDefensivePool, out var pool) ? pool.Current : 0;

    private static string CombatStatusLine(CombatantState c) =>
        string.Join(" ", c.Statuses.Select(s =>
        {
            var name = s.DefinitionId.value.Replace("standard.", "");
            var magnitude = s.Stacks > 0 ? $"×{s.Stacks}"
                : s.DurationTurns > 0 ? $" {s.DurationTurns}t"
                : s.Charges > 0 ? $" {s.Charges}c" : "";
            return $"{name}{magnitude}";
        }));
}
