@inject RunDocument Doc
@inject ProjectDraft Draft
@implements IDisposable

@* The dedicated Cards & deck tab: authors the run's card definitions (RunBlueprint.Cards) and its starting deck
   (RunBlueprint.Deck) on the shared document. Each card's effect program is edited with the visual
   CombatProgramEditor (over CardPlayContext); a program outside the visual subset is left to the Run-tab JSON. The
   deck is the multiset of card ids the hero starts with. This absorbs the standalone Cards tab (single-card JSON)
   into the one project document. *@
<section style="padding:1rem; max-width:72rem">
    <TabIntro Title="Cards & deck"
              Text="The cards the player draws and plays in fights — each card is a name, a cost and a visual effect program — plus the starting deck (how many copies of each card a run begins with)."
              Connects="Cards can also be granted by Events, Shops, Relics and rewards; the fights that draw them are authored on the Encounters tab." />
    <IdDatalists Blueprint="_blueprint" />

    @{ var issues = RunDocumentValidator.ForTab(_blueprint, RunDocumentValidator.CardsTab); }
    @if (issues.Count > 0)
    {
        <ul class="log">
            @foreach (var issue in issues)
            {
                <li><span class="line-kind">⚠</span> @issue</li>
            }
        </ul>
    }

    <h2>Cards (@Cards.Count)</h2>
    @if (Cards.Count == 0)
    {
        <EmptyHint Title="No cards yet."
                   Text="Type an id below (like fireball) and press Add card — a new card starts with a simple deal-damage program you can reshape step by step." />
    }
    @if (Cards.Count >= StudioFilter.ShowThreshold)
    {
        <FilterBox @bind-Value="_filter" Total="Cards.Count"
                   Shown="Cards.Count(c => StudioFilter.Matches(_filter, c.Id, c.NameKey))" />
    }
    @for (var i = 0; i < Cards.Count; i++)
    {
        var ci = i;
        var card = Cards[ci];
        if (!StudioFilter.Matches(_filter, card.Id, card.NameKey))
        {
            continue;
        }
        var cardIssues = issues.Where(m => m.Contains($"'{card.Id}'")).ToList();
        <div class="fx-block @(cardIssues.Count > 0 ? "invalid" : "")">
            <div class="run-bar">
                <span class="muted">id</span>
                <input value="@card.Id" style="width:9rem" @onchange="e => SetCardId(ci, AsString(e.Value))" />
                <span class="muted">name</span>
                <input value="@(card.NameKey ?? "")" style="width:11rem" @onchange="e => SetCardName(ci, AsString(e.Value))" />
                <span class="muted">energy</span>
                <input type="number" value="@EnergyCost(card)" style="width:4rem"
                       @onchange="e => SetEnergy(ci, AsInt(e.Value, EnergyCost(card)))" />
                @* Custom-resource costs (embers, blood, …): each is a resource id + amount next to the energy
                   field, so the whole cost of a card is authorable — not just its energy. *@
                @foreach (var (cost, costIndex) in CustomCosts(card))
                {
                    var costI = costIndex;
                    <input value="@cost.ResourceId.value" list="rd-resource-ids" style="width:7rem"
                           title="a custom combat resource this card costs (authored on the Hero tab)"
                           @onchange="e => SetCostResource(ci, costI, AsString(e.Value))" />
                    <input type="number" value="@cost.Amount" style="width:3.5rem"
                           @onchange="e => SetCostAmount(ci, costI, AsInt(e.Value, cost.Amount))" />
                    <button class="mini" title="remove this cost" @onclick="() => RemoveCost(ci, costI)">✕</button>
                }
                <button class="mini" title="add a custom-resource cost (e.g. embers 2)" @onclick="() => AddCost(ci)">+ cost</button>
                <button class="mini" title="duplicate this card" @onclick="() => DuplicateCard(ci)">⧉</button>
                <button class="mini" @onclick="() => RemoveCard(ci)">✕ card</button>
                @if (ModelOf(card) is { } summary)
                {
                    <span class="muted">— @StudioVocabulary.Describe(summary)</span>
                }
            </div>
            @foreach (var issue in cardIssues)
            {
                <p class="error">⚠ @issue</p>
            }
            <div class="run-bar">
                <label title="Where the card goes once it has been played.">after playing
                    <select value="@card.PlayedCardDestinationZone"
                            @onchange="e => SetPlayedDestination(ci, Enum.Parse<CardZone>(AsString(e.Value)))">
                        @foreach (var zone in Enum.GetValues<CardZone>())
                        {
                            <option value="@zone" selected="@(card.PlayedCardDestinationZone == zone)">@StudioVocabulary.EnumDisplay(zone)</option>
                        }
                    </select>
                </label>
                <label title="@StudioVocabulary.FieldDescription("CardData.QueueOnPlay")">
                    <input type="checkbox" checked="@card.QueueOnPlay"
                           @onchange="e => SetQueueOnPlay(ci, AsBool(e.Value))" /> @StudioVocabulary.FieldLabel("CardData.QueueOnPlay")
                </label>
                <label title="The card stays in hand when the turn ends instead of being discarded.">
                    <input type="checkbox" checked="@card.RetainInHandOnTurnEnd"
                           @onchange="e => SetRetainInHand(ci, AsBool(e.Value))" /> retain in hand
                </label>
            </div>
            <div class="fx-body">
                <span class="muted">program:</span>
                @{ var model = ModelOf(card); }
                @if (model is { } node)
                {
                    <CombatProgramEditor Node="node" NodeChanged="n => SetCardProgram(ci, n)" />
                }
                else if (card.Program is null)
                {
                    <button class="mini" @onclick="() => AddCardProgram(ci)">+ program</button>
                }
                else
                {
                    <span class="muted"> advanced program (outside the visual subset) — edit in the Run tab JSON</span>
                }
            </div>
            <PresentationEditor Value="PresentationAuthoring.Get(_blueprint.Presentation.Cards, card.Id)"
                                ValueChanged="p => SetCardPresentation(card.Id, p)" />
        </div>
    }
    <div class="run-bar">
        <input placeholder="new card id" @bind="_newCardId" style="width:11rem" />
        <button class="play" @onclick="AddCard">Add card</button>
    </div>

    <h2>Starting deck (@Deck.Count)</h2>
    @if (Cards.Count == 0)
    {
        <p class="muted">Author a card first, then add copies to the deck.</p>
    }
    else
    {
        @foreach (var card in Cards)
        {
            var id = card.Id;
            <div class="run-bar">
                <span style="width:12rem; display:inline-block">@id</span>
                <button class="mini" @onclick="() => RemoveDeckCopy(id)">−</button>
                <span style="min-width:1.5rem; display:inline-block; text-align:center">@DeckCount(id)</span>
                <button class="mini" @onclick="() => AddDeckCopy(id)">+</button>
            </div>
        }
    }
</section>

@code {
    private RunBlueprint _blueprint = default!;
    private string _filter = "";
    private string _newCardId = "";

    protected override void OnInitialized()
    {
        _blueprint = Doc.Load();
        Draft.Changed += OnDraftChanged;
    }

    // Reload when the document changes elsewhere in this circuit (the nav's global Undo) so the tab never shows
    // a stale copy. Self-echoes (our own Save) reload the data we just wrote — harmless.
    private void OnDraftChanged() => _ = InvokeAsync(() =>
    {
        try
        {
            _blueprint = Doc.Load();
        }
        catch (Exception)
        {
            return; // mid-edit the Run-tab JSON may not parse; keep the last good copy
        }
        StateHasChanged();
    });

    public void Dispose() => Draft.Changed -= OnDraftChanged;

    private IReadOnlyList<CardData> Cards => _blueprint.Cards;
    private IReadOnlyList<CardDefinitionId> Deck => _blueprint.Deck;

    private void Save() => Doc.Save(_blueprint);
    private static string AsString(object? v) => v?.ToString() ?? "";
    private static int AsInt(object? v, int fallback) => int.TryParse(v?.ToString(), out var n) ? n : fallback;

    private static CombatNodeModel? ModelOf(CardData card) =>
        card.Program is { } program ? CombatProgramModel.Classify(program) : null;

    private static int EnergyCost(CardData card) =>
        card.Costs.Where(c => c.ResourceId == StandardCombatIds.EnergyResource).Sum(c => c.Amount);

    // ── cards ────────────────────────────────────────────────────────────────────
    private void EditCards(Func<List<CardData>, List<CardData>> edit)
    {
        _blueprint = _blueprint with { Cards = edit(Cards.ToList()) };
        Save();
    }

    private void EditCard(int index, Func<CardData, CardData> edit) =>
        EditCards(list =>
        {
            if (index >= 0 && index < list.Count)
                list[index] = edit(list[index]);
            return list;
        });

    // A rename carries the card's authored look along instead of orphaning it — one document write.
    private void SetCardId(int index, string id)
    {
        if (string.IsNullOrWhiteSpace(id) || index < 0 || index >= Cards.Count)
            return;
        var oldId = Cards[index].Id;
        var list = Cards.ToList();
        list[index] = list[index] with { Id = id.Trim() };
        _blueprint = _blueprint with
        {
            Cards = list,
            Presentation = _blueprint.Presentation with
            {
                Cards = PresentationAuthoring.Rename(_blueprint.Presentation.Cards, oldId, id.Trim()),
            },
        };
        Save();
    }

    private void SetCardPresentation(string id, EntityPresentation? presentation)
    {
        _blueprint = _blueprint with
        {
            Presentation = _blueprint.Presentation with
            {
                Cards = PresentationAuthoring.With(_blueprint.Presentation.Cards, id, presentation),
            },
        };
        Save();
    }

    private void SetCardName(int index, string name) =>
        EditCard(index, c => c with { NameKey = string.IsNullOrWhiteSpace(name) ? null : name.Trim() });

    private void SetEnergy(int index, int energy) =>
        EditCard(index, c => c with { Costs = WithEnergy(c.Costs, energy) });

    private static bool AsBool(object? v) => v is bool b ? b : bool.TryParse(v?.ToString(), out var r) && r;

    private void SetPlayedDestination(int index, CardZone zone) =>
        EditCard(index, c => c with { PlayedCardDestinationZone = zone });

    private void SetQueueOnPlay(int index, bool queued) =>
        EditCard(index, c => c with { QueueOnPlay = queued });

    private void SetRetainInHand(int index, bool retain) =>
        EditCard(index, c => c with { RetainInHandOnTurnEnd = retain });

    private void SetCardProgram(int index, CombatNodeModel node) =>
        EditCard(index, c => c with { Program = CombatProgramModel.Build<CardPlayContext>(node) });

    private void AddCardProgram(int index) => SetCardProgram(index, CombatProgramModel.NewNode("dealDamage"));

    private void DuplicateCard(int index) =>
        EditCards(list =>
        {
            if (index >= 0 && index < list.Count)
                list.Insert(index + 1, list[index] with
                {
                    Id = StudioIds.Copy(list[index].Id, id => list.Any(c => c.Id == id)),
                });
            return list;
        });

    private void RemoveCard(int index) =>
        EditCards(list =>
        {
            if (index >= 0 && index < list.Count)
                list.RemoveAt(index);
            return list;
        });

    private void AddCard()
    {
        if (string.IsNullOrWhiteSpace(_newCardId))
            return;
        var id = _newCardId.Trim();
        EditCards(list =>
        {
            list.Add(new CardData
            {
                Id = id,
                Program = CombatProgramModel.Build<CardPlayContext>(CombatProgramModel.NewNode("dealDamage")),
            });
            return list;
        });
        _newCardId = "";
    }

    private static IReadOnlyList<ResourceCost> WithEnergy(IReadOnlyList<ResourceCost> costs, int energy)
    {
        var list = costs.Where(c => c.ResourceId != StandardCombatIds.EnergyResource).ToList();
        if (energy > 0)
            list.Add(new ResourceCost(StandardCombatIds.EnergyResource, energy));
        return list;
    }

    // ── custom-resource costs (the non-energy entries of card.Costs, by their index in the full list) ───────────
    private static IEnumerable<(ResourceCost Cost, int Index)> CustomCosts(CardData card) =>
        card.Costs.Select((cost, index) => (cost, index))
            .Where(x => x.cost.ResourceId != StandardCombatIds.EnergyResource);

    private void EditCost(int cardIndex, int costIndex, Func<ResourceCost, ResourceCost?> edit) =>
        EditCard(cardIndex, c =>
        {
            if (costIndex < 0 || costIndex >= c.Costs.Count)
                return c;
            var list = c.Costs.ToList();
            if (edit(list[costIndex]) is { } updated)
                list[costIndex] = updated;
            else
                list.RemoveAt(costIndex);
            return c with { Costs = list };
        });

    private void SetCostResource(int cardIndex, int costIndex, string resourceId)
    {
        if (!string.IsNullOrWhiteSpace(resourceId))
            EditCost(cardIndex, costIndex, cost => cost with { ResourceId = new ResourceId(resourceId.Trim()) });
    }

    private void SetCostAmount(int cardIndex, int costIndex, int amount) =>
        EditCost(cardIndex, costIndex, cost => cost with { Amount = Math.Max(0, amount) });

    private void RemoveCost(int cardIndex, int costIndex) => EditCost(cardIndex, costIndex, _ => null);

    private void AddCost(int cardIndex)
    {
        var defaultResource = _blueprint.CombatResources.FirstOrDefault()?.Id ?? "resource";
        EditCard(cardIndex, c => c with
        {
            Costs = c.Costs.Append(new ResourceCost(new ResourceId(defaultResource), 1)).ToList(),
        });
    }

    // ── deck ─────────────────────────────────────────────────────────────────────
    private int DeckCount(string id) => Deck.Count(c => c.value == id);

    private void AddDeckCopy(string id)
    {
        _blueprint = _blueprint with { Deck = Deck.Append(new CardDefinitionId(id)).ToList() };
        Save();
    }

    private void RemoveDeckCopy(string id)
    {
        var list = Deck.ToList();
        var index = list.FindIndex(c => c.value == id);
        if (index >= 0)
        {
            list.RemoveAt(index);
            _blueprint = _blueprint with { Deck = list };
            Save();
        }
    }
}
