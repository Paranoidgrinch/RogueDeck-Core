@rendermode InteractiveServer
@inject RunDocument Doc

@* The dedicated Events tab: a lens over the shared run document, hosting the existing EventEditor. Authored
   events (situations, choices, effects) persist in the one ProjectDraft document and are referenced by the map. *@
<section style="padding:1rem; max-width:70rem">
    <TabIntro Title="Events"
              Text="Story moments with choices. Each event is one or more situations; every choice lists what it does — gold, cards, relics, healing or damage, or jumping to a follow-up situation."
              Connects="Place an event on the map as an event node on the Run tab." />

    <EventEditor Blueprint="_blueprint" BlueprintChanged="OnChanged" />
</section>

@code {
    private RunBlueprint _blueprint = default!;

    protected override void OnInitialized() => _blueprint = Doc.Load();

    private void OnChanged(RunBlueprint blueprint)
    {
        Doc.Save(blueprint);
        _blueprint = blueprint;
    }
}
