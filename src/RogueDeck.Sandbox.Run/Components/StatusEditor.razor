@using Microsoft.AspNetCore.Components.Rendering
@* Visual editor for the run's custom status definitions (StatusData) — the sibling of the Cards / Relics editors.
   A status is id + display + polarity/stacking/flags/tags plus declarative PASSIVE MODIFIERS (e.g. Strength =
   "+1 damage dealt per stack", Vulnerable = "×150% damage received"). Triggers (fire a program on an event) and
   interceptors (death-prevention / debuff-block) are authored in the sections below. Registered into every combat
   by RunPlayback.BuildContent, so a card/relic/enemy that applies the status resolves it. *@

<section class="panel">
    <h2>Statuses</h2>
    <p class="muted">Custom status effects the run's content applies. Passive modifiers change combat math while a
        combatant bears the status; triggers and interceptors add reactive behaviour.</p>

    @if (Blueprint.Statuses.Count == 0)
    {
        <EmptyHint Title="No statuses yet."
                   Text="A status is a buff or debuff that sits on a unit — poison, strength, a burning brand… Name one below, then apply it from any card, enemy or relic program by its id." />
    }

    @if (Blueprint.Statuses.Count >= StudioFilter.ShowThreshold)
    {
        <FilterBox @bind-Value="_filter" Total="Blueprint.Statuses.Count"
                   Shown="Blueprint.Statuses.Count(s => StudioFilter.Matches(_filter, s.Id, s.NameKey))" />
    }
    @for (var si = 0; si < Blueprint.Statuses.Count; si++)
    {
        var index = si;
        var status = Blueprint.Statuses[si];
        if (!StudioFilter.Matches(_filter, status.Id, status.NameKey))
        {
            continue;
        }
        <div class="editor-card">
            <div class="run-bar">
                <label>Status id
                    <input value="@status.Id" style="width:9rem"
                           @onchange="e => SetStatusId(index, AsString(e.Value))" />
                </label>
                <label>Name
                    <input value="@status.NameKey" style="width:10rem"
                           @onchange="e => Edit(index, s => s with { NameKey = Nullable(AsString(e.Value)) })" />
                </label>
                <button class="mini" title="duplicate this status" @onclick="() => Duplicate(index)">⧉</button>
                <button class="mini" @onclick="() => Remove(index)">✕ remove</button>
            </div>
            <PresentationEditor Value="PresentationAuthoring.Get(Blueprint.Presentation.Statuses, status.Id)"
                                ValueChanged="p => SetPresentation(status.Id, p)" />
            <div class="run-bar">
                <label>Polarity @EnumSelect(status.Polarity, p => Edit(index, s => s with { Polarity = p }))</label>
                <label>Stacking @EnumSelect(status.StackingBehavior, b => Edit(index, s => s with { StackingBehavior = b }))</label>
                <label><input type="checkbox" checked="@status.UsesStacks"
                              @onchange="e => Edit(index, s => s with { UsesStacks = AsBool(e.Value) })" /> stacks</label>
                <label><input type="checkbox" checked="@status.UsesDuration"
                              @onchange="e => Edit(index, s => s with { UsesDuration = AsBool(e.Value) })" /> duration</label>
                <label><input type="checkbox" checked="@status.UsesCharges"
                              @onchange="e => Edit(index, s => s with { UsesCharges = AsBool(e.Value) })" /> charges</label>
            </div>
            <div class="run-bar">
                <label>Tags
                    <input value="@string.Join(", ", status.Tags)" style="width:18rem" placeholder="comma, separated"
                           @onchange="e => Edit(index, s => s with { Tags = ParseTags(AsString(e.Value)) })" />
                </label>
            </div>

            <div class="editor-effects">
                <span class="muted">Passive modifiers:</span>
                @for (var pi = 0; pi < status.PassiveModifiers.Count; pi++)
                {
                    var modIndex = pi;
                    var mod = status.PassiveModifiers[pi];
                    <div class="run-bar">
                        @EnumSelect(mod.Pipeline, p => SetModifier(index, modIndex, mod with { Pipeline = p }))
                        @EnumSelect(mod.Operation, o => SetModifier(index, modIndex, mod with { Operation = o }))
                        <label title="How much the value changes (per the chosen operation).">magnitude
                            <input type="number" value="@mod.Magnitude" style="width:4rem"
                                   @onchange="e => SetModifier(index, modIndex, mod with { Magnitude = AsInt(e.Value, mod.Magnitude) })" />
                        </label>
                        <label title="Order among modifiers on the same value — lower runs first.">priority
                            <input type="number" value="@mod.Priority" style="width:4rem"
                                   @onchange="e => SetModifier(index, modIndex, mod with { Priority = AsInt(e.Value, mod.Priority) })" />
                        </label>
                        <label>damage @EnumSelect(mod.RestrictDamageKind ?? DamageKind.Direct, k => SetModifier(index, modIndex, mod with { RestrictDamageKind = k }))</label>
                        <label title="Only modify applications of this one status (leave blank for all).">only for status
                            <input value="@mod.AppliesToStatusId" style="width:7rem" placeholder="status id (optional)" list="rd-status-ids"
                                   @onchange="e => SetModifier(index, modIndex, mod with { AppliesToStatusId = Nullable(AsString(e.Value)) })" />
                        </label>
                        <label title="Damage only: apply only to damage dealt by a card carrying this tag (leave blank for any source).">only from cards tagged
                            <input value="@mod.RestrictSourceCardTag" style="width:7rem" placeholder="card tag (optional)"
                                   @onchange="e => SetModifier(index, modIndex, mod with { RestrictSourceCardTag = Nullable(AsString(e.Value)) })" />
                        </label>
                        <label title="Damage only: contribute once per card played instead of once per hit — what '+N total damage' means.">
                            <input type="checkbox" checked="@mod.OncePerCardPlay"
                                   @onchange="e => SetModifier(index, modIndex, mod with { OncePerCardPlay = AsBool(e.Value) })" /> once per card played
                        </label>
                        <button class="mini" @onclick="() => RemoveModifier(index, modIndex)">✕</button>
                    </div>
                }
                <button class="mini" @onclick="() => AddModifier(index)">+ passive modifier</button>
            </div>

            <div class="editor-effects">
                <span class="muted">Triggers:</span>
                @for (var ti = 0; ti < status.Triggers.Count; ti++)
                {
                    var trigIndex = ti;
                    var trigger = status.Triggers[ti];
                    var ev = ParseEvent(trigger.Event);
                    <div class="editor-choice">
                        <div class="run-bar">
                            <span class="muted">On</span> @EnumSelect(ev, e => SetTriggerEvent(index, trigIndex, e))
                            <button class="mini" @onclick="() => RemoveTrigger(index, trigIndex)">✕ trigger</button>
                        </div>
                        <div class="fx-body">
                            @TriggerProgramEditor(index, trigIndex, ev, trigger)
                        </div>
                    </div>
                }
                <button class="mini" @onclick="() => AddTrigger(index)">+ trigger</button>
            </div>

            <div class="editor-effects">
                <span class="muted">Death prevention:</span>
                @if (status.DeathPrevention is { } dp)
                {
                    <div class="run-bar">
                        <label>survive at HP
                            <input type="number" value="@dp.SurvivingHealth" style="width:4rem"
                                   @onchange="e => SetDeathPrevention(index, dp with { SurvivingHealth = AsInt(e.Value, dp.SurvivingHealth) })" />
                        </label>
                        <button class="mini" @onclick="() => SetDeathPrevention(index, null)">✕ remove</button>
                    </div>
                    @InterceptorEffectsEditor(dp.Effects, fx => SetDeathPrevention(index, dp with { Effects = fx }))
                }
                else
                {
                    <button class="mini" @onclick="() => SetDeathPrevention(index, new StatusDeathPreventionData(1, Array.Empty<InterceptorEffectData>()))">+ death prevention</button>
                }
            </div>

            <div class="editor-effects">
                <span class="muted">@StudioVocabulary.FieldLabel("StatusData.IncomingStatusDelay"):</span>
                @if (status.IncomingStatusDelay is { } delay)
                {
                    <div class="run-bar">
                        <label>waits
                            <input type="number" value="@delay.Turns" style="width:4rem"
                                   @onchange="e => SetIncomingDelay(index, delay with { Turns = Math.Max(0, AsInt(e.Value, delay.Turns)) })" />
                            turn(s)
                        </label>
                        <label>applies to
                            <select value="@(delay.Polarity?.ToString() ?? "any")"
                                    @onchange="e => SetIncomingDelay(index, delay with { Polarity = AsPolarity(e.Value) })">
                                <option value="any">any status</option>
                                @foreach (var polarity in Enum.GetValues<StatusPolarity>())
                                {
                                    <option value="@polarity">@polarity</option>
                                }
                            </select>
                        </label>
                        <button class="mini" @onclick="() => SetIncomingDelay(index, null)">✕ remove</button>
                    </div>
                    <div class="muted">@StudioVocabulary.FieldDescription("StatusData.IncomingStatusDelay")</div>
                }
                else
                {
                    <button class="mini" @onclick="() => SetIncomingDelay(index, new IncomingStatusDelayData(1, StatusPolarity.Debuff))">+ postpone incoming statuses</button>
                }
            </div>

            <div class="editor-effects">
                <span class="muted">@StudioVocabulary.FieldLabel("StatusData.Disclosure"):</span>
                @if (status.Disclosure is { } sight)
                {
                    <div class="run-bar">
                        <label>draw pile
                            <input type="number" value="@sight.DrawPileCards" style="width:4rem"
                                   @onchange="e => SetDisclosure(index, sight with { DrawPileCards = Math.Max(0, AsInt(e.Value, sight.DrawPileCards)) })" />
                            card(s)
                        </label>
                        <label>enemy intents ahead
                            <input type="number" value="@sight.IntentLookahead" style="width:4rem"
                                   @onchange="e => SetDisclosure(index, sight with { IntentLookahead = Math.Max(0, AsInt(e.Value, sight.IntentLookahead)) })" />
                        </label>
                        <button class="mini" @onclick="() => SetDisclosure(index, null)">✕ remove</button>
                    </div>
                    <div class="muted">@StudioVocabulary.FieldDescription("StatusData.Disclosure")</div>
                }
                else
                {
                    <button class="mini" @onclick="() => SetDisclosure(index, new DisclosureData(1, 1))">+ disclosure</button>
                }
            </div>

            <div class="editor-effects">
                <span class="muted">Debuff block:</span>
                @if (status.DebuffBlock is { } db)
                {
                    <div class="run-bar">
                        <button class="mini" @onclick="() => SetDebuffBlock(index, null)">✕ remove</button>
                    </div>
                    @InterceptorEffectsEditor(db.Effects, fx => SetDebuffBlock(index, new StatusDebuffBlockData(fx)))
                }
                else
                {
                    <button class="mini" @onclick="() => SetDebuffBlock(index, new StatusDebuffBlockData(Array.Empty<InterceptorEffectData>()))">+ debuff block</button>
                }
            </div>
        </div>
    }

    <div class="run-bar">
        <input value="@_newId" placeholder="new status id" style="width:12rem"
               @onchange="e => _newId = AsString(e.Value)" />
        <button class="mini" @onclick="Add" disabled="@string.IsNullOrWhiteSpace(_newId)">+ add status</button>
    </div>
</section>

@code {
    [Parameter] public RunBlueprint Blueprint { get; set; } = default!;
    [Parameter] public EventCallback<RunBlueprint> BlueprintChanged { get; set; }

    private string _filter = "";
    private string _newId = "";

    private static string AsString(object? v) => v?.ToString() ?? "";
    private static int AsInt(object? v, int fallback) => int.TryParse(v?.ToString(), out var n) ? n : fallback;
    private static bool AsBool(object? v) => v is bool b ? b : bool.TryParse(v?.ToString(), out var r) && r;
    private static string? Nullable(string v) => string.IsNullOrWhiteSpace(v) ? null : v.Trim();
    private static IReadOnlyList<string> ParseTags(string v) =>
        v.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    private Task Save(IReadOnlyList<StatusData> statuses) =>
        BlueprintChanged.InvokeAsync(Blueprint with { Statuses = statuses });

    private Task Edit(int index, Func<StatusData, StatusData> edit)
    {
        var list = Blueprint.Statuses.ToList();
        list[index] = edit(list[index]);
        return Save(list);
    }

    private Task Remove(int index) => Save(Blueprint.Statuses.Where((_, i) => i != index).ToList());

    // A rename carries the status's authored look along instead of orphaning it — one document write.
    private Task SetStatusId(int index, string id)
    {
        if (string.IsNullOrWhiteSpace(id))
            return Task.CompletedTask;
        var oldId = Blueprint.Statuses[index].Id;
        var list = Blueprint.Statuses.ToList();
        list[index] = list[index] with { Id = id.Trim() };
        return BlueprintChanged.InvokeAsync(Blueprint with
        {
            Statuses = list,
            Presentation = Blueprint.Presentation with
            {
                Statuses = PresentationAuthoring.Rename(Blueprint.Presentation.Statuses, oldId, id.Trim()),
            },
        });
    }

    private Task SetPresentation(string id, EntityPresentation? presentation) =>
        BlueprintChanged.InvokeAsync(Blueprint with
        {
            Presentation = Blueprint.Presentation with
            {
                Statuses = PresentationAuthoring.With(Blueprint.Presentation.Statuses, id, presentation),
            },
        });

    private Task Duplicate(int index)
    {
        var list = Blueprint.Statuses.ToList();
        if (index < 0 || index >= list.Count)
            return Task.CompletedTask;
        list.Insert(index + 1, list[index] with
        {
            Id = StudioIds.Copy(list[index].Id, id => list.Any(s => s.Id == id)),
        });
        return Save(list);
    }

    private Task Add()
    {
        var id = _newId.Trim();
        if (id.Length == 0 || Blueprint.Statuses.Any(s => s.Id == id))
            return Task.CompletedTask;
        _newId = "";
        return Save(Blueprint.Statuses.Append(new StatusData { Id = id, NameKey = id, UsesStacks = true }).ToList());
    }

    // ── passive modifiers ────────────────────────────────────────────────────────
    private Task SetModifier(int index, int modIndex, PassiveModifierData mod) =>
        Edit(index, s =>
        {
            var mods = s.PassiveModifiers.ToList();
            mods[modIndex] = mod;
            return s with { PassiveModifiers = mods };
        });

    private Task RemoveModifier(int index, int modIndex) =>
        Edit(index, s => s with { PassiveModifiers = s.PassiveModifiers.Where((_, i) => i != modIndex).ToList() });

    private Task AddModifier(int index) =>
        Edit(index, s => s with
        {
            PassiveModifiers = s.PassiveModifiers.Append(new PassiveModifierData(
                PassiveModifierPipeline.DamageDealt, PassiveModifierOperation.AddPerStack, 1)).ToList(),
        });

    // ── triggers (fire a program on a combat event while the status is borne) ─────────
    private static TriggerEvent ParseEvent(string ev) =>
        Enum.TryParse<TriggerEvent>(ev, out var e) ? e : TriggerEvent.TurnStarted;

    // Deserialize + classify the stored context-free program under its event's context; a malformed / advanced
    // program yields null so the editor shows a read-only note instead of throwing.
    private static CombatNodeModel? TryToModel(TriggerEvent ev, JsonElement program)
    {
        try { return StatusTriggerPrograms.Get(ev).ToModel(program); }
        catch { return null; }
    }

    private Task SetTrigger(int index, int trigIndex, StatusTriggerData trigger) =>
        Edit(index, s =>
        {
            var triggers = s.Triggers.ToList();
            triggers[trigIndex] = trigger;
            return s with { Triggers = triggers };
        });

    private Task RemoveTrigger(int index, int trigIndex) =>
        Edit(index, s => s with { Triggers = s.Triggers.Where((_, i) => i != trigIndex).ToList() });

    private Task AddTrigger(int index) =>
        Edit(index, s => s with
        {
            Triggers = s.Triggers.Append(new StatusTriggerData(
                TriggerEvent.TurnStarted.ToString(),
                StatusTriggerPrograms.Get(TriggerEvent.TurnStarted).NewProgram())).ToList(),
        });

    // Changing the event re-hosts the SAME visual program under the new event's context (or a fresh default if the
    // old program was outside the visual subset), so the designer keeps their work when switching triggers.
    private Task SetTriggerEvent(int index, int trigIndex, TriggerEvent ev)
    {
        var old = Blueprint.Statuses[index].Triggers[trigIndex];
        var model = TryToModel(ParseEvent(old.Event), old.Program);
        var program = model is { } m ? StatusTriggerPrograms.Get(ev).FromModel(m) : StatusTriggerPrograms.Get(ev).NewProgram();
        return SetTrigger(index, trigIndex, new StatusTriggerData(ev.ToString(), program));
    }

    private Task SetTriggerModel(int index, int trigIndex, TriggerEvent ev, CombatNodeModel model) =>
        SetTrigger(index, trigIndex, new StatusTriggerData(ev.ToString(), StatusTriggerPrograms.Get(ev).FromModel(model)));

    private RenderFragment TriggerProgramEditor(int index, int trigIndex, TriggerEvent ev, StatusTriggerData trigger) => builder =>
    {
        var model = TryToModel(ev, trigger.Program);
        if (model is { } node)
        {
            builder.OpenComponent<RogueDeck.Sandbox.Combat.Components.CombatProgramEditor>(0);
            builder.AddAttribute(1, "Node", node);
            builder.AddAttribute(2, "NodeChanged",
                EventCallback.Factory.Create<CombatNodeModel>(this, m => SetTriggerModel(index, trigIndex, ev, m)));
            builder.CloseComponent();
        }
        else
        {
            builder.OpenElement(3, "span");
            builder.AddAttribute(4, "class", "muted");
            builder.AddContent(5, "(advanced trigger program — edit in the Run tab's JSON)");
            builder.CloseElement();
        }
    };

    // ── interceptors (death-prevention / debuff-block) ────────────────────────────────
    private Task SetDeathPrevention(int index, StatusDeathPreventionData? data) =>
        Edit(index, s => s with { DeathPrevention = data });

    private Task SetDebuffBlock(int index, StatusDebuffBlockData? data) =>
        Edit(index, s => s with { DebuffBlock = data });

    // "Due notice": statuses applied to the bearer wait before they take effect.
    private Task SetIncomingDelay(int index, IncomingStatusDelayData? data) =>
        Edit(index, s => s with { IncomingStatusDelay = data });

    // "Full disclosure": extra sight for the bearer.
    private Task SetDisclosure(int index, DisclosureData? data) =>
        Edit(index, s => s with { Disclosure = data });

    private static StatusPolarity? AsPolarity(object? value) =>
        AsString(value) is { } text && Enum.TryParse<StatusPolarity>(text, out var polarity) ? polarity : null;

    // Shared editor for an interceptor's constant-valued effect lines (both death-prevention and debuff-block hold
    // one). Each line = kind × target × amount, plus a status id / duration (apply/remove) and polarity (cleanse).
    private RenderFragment InterceptorEffectsEditor(
        IReadOnlyList<InterceptorEffectData> effects, Func<IReadOnlyList<InterceptorEffectData>, Task> onChange) => builder =>
    {
        Task SetLine(int i, InterceptorEffectData line)
        {
            var list = effects.ToList();
            list[i] = line;
            return onChange(list);
        }

        var seq = 0;
        for (var i = 0; i < effects.Count; i++)
        {
            var line = effects[i];
            var idx = i;
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "run-bar");
            builder.AddContent(seq++, EnumSelect(ParseEnum(line.Kind, EffectKind.DealDamage), k => SetLine(idx, line with { Kind = k.ToString() })));
            builder.AddContent(seq++, EnumSelect(ParseEnum(line.Target, EffectTarget.Self), t => SetLine(idx, line with { Target = t.ToString() })));
            builder.AddContent(seq++, Number("amt", line.Amount, v => SetLine(idx, line with { Amount = v })));
            builder.AddContent(seq++, Text("status id", line.StatusId, v => SetLine(idx, line with { StatusId = v })));
            builder.AddContent(seq++, Number("turns", line.DurationTurns, v => SetLine(idx, line with { DurationTurns = v })));
            builder.AddContent(seq++, EnumSelect(line.Polarity, p => SetLine(idx, line with { Polarity = p })));
            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "class", "mini");
            builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () => onChange(effects.Where((_, j) => j != idx).ToList())));
            builder.AddContent(seq++, "✕");
            builder.CloseElement();
            builder.CloseElement();
        }

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "class", "mini");
        builder.AddAttribute(seq++, "onclick", EventCallback.Factory.Create(this, () =>
            onChange(effects.Append(new InterceptorEffectData(
                EffectKind.Heal.ToString(), EffectTarget.Self.ToString(), 5, "", 0, StatusPolarity.Debuff)).ToList())));
        builder.AddContent(seq++, "+ effect");
        builder.CloseElement();
    };

    private static TEnum ParseEnum<TEnum>(string value, TEnum fallback) where TEnum : struct, Enum =>
        Enum.TryParse<TEnum>(value, out var v) ? v : fallback;

    private RenderFragment Number(string label, int value, Func<int, Task> onChange) => builder =>
    {
        builder.OpenElement(0, "label");
        builder.AddContent(1, label + " ");
        builder.OpenElement(2, "input");
        builder.AddAttribute(3, "type", "number");
        builder.AddAttribute(4, "value", value);
        builder.AddAttribute(5, "style", "width:3.5rem");
        builder.AddAttribute(6, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(AsInt(e.Value, value))));
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment Text(string placeholder, string value, Func<string, Task> onChange) => builder =>
    {
        builder.OpenElement(0, "input");
        builder.AddAttribute(1, "value", value);
        builder.AddAttribute(2, "placeholder", placeholder);
        builder.AddAttribute(3, "style", "width:7rem");
        builder.AddAttribute(4, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(AsString(e.Value))));
        builder.CloseElement();
    };

    // A generic enum dropdown bound to a value + change handler — keeps the many enum selects (polarity, stacking,
    // pipeline, operation, damage kind) to one line each in the markup. Options show the StudioVocabulary display
    // ("Friendly label (RawName)") while the option VALUE stays the raw enum name, so nothing serialized changes.
    private RenderFragment EnumSelect<TEnum>(TEnum current, Func<TEnum, Task> onChange) where TEnum : struct, Enum => builder =>
    {
        builder.OpenElement(0, "select");
        builder.AddAttribute(1, "value", current.ToString());
        builder.AddAttribute(2, "title", StudioVocabulary.EnumDescription(current));
        builder.AddAttribute(3, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            Enum.TryParse<TEnum>(AsString(e.Value), out var value) ? onChange(value) : Task.CompletedTask));
        var seq = 4;
        foreach (var value in Enum.GetValues<TEnum>())
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", value.ToString());
            builder.AddAttribute(seq++, "title", StudioVocabulary.EnumDescription(value));
            builder.AddAttribute(seq++, "selected", value.Equals(current));
            builder.AddContent(seq++, StudioVocabulary.EnumDisplay(value));
            builder.CloseElement();
        }
        builder.CloseElement();
    };
}
