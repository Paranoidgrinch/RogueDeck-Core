@using RogueDeck.Core.Combat

@* Visual editor for the run's authored relics. A relic is id + display name + reactions; each reaction fires on
   a run event (optionally gated by a condition) while the relic is owned and enqueues effects. The effect palette
   spans the run-effect leaf surface: resources/HP/heal/damage (with constant or computed amounts), flags/counters,
   card grants/removal, relic add/remove/disable/enable, and consumable grants — plus control flow: Repeat (a body
   run a constant/computed number of times) and Conditional (If/then/else on run state) — plus rewards: Grant
   reward (a named bundle), Offer reward (player picks among fixed offers), and Offer reward (random) (draw N from a
   weighted pool, then pick) — plus random draws: Random draw / Random draw N distinct (weighted outcome pool).
   Every "block" effect (control flow, reward, draw) — whether a top-level reaction effect or nested in a body —
   renders through the shared RelicCompositeEditor component; its sub-bodies (branches, reward contents/offers, draw
   outcomes) recurse through RelicBodyEditor, which routes nested blocks back to RelicCompositeEditor, so a body can
   branch, loop, grant/offer rewards and draw outcomes to arbitrary depth and the composite markup lives in ONE place.
   This editor keeps the top-level LEAF editing (amount/state/grant leaves, EffectEditor) and supplies the leaf /
   amount / condition widgets the two child components render with. Reactions the editor can't model (nested and/or
   conditions, advanced amounts, delegate/Func reward sources) are preserved and shown read-only so nothing is lost. *@

<section class="panel">
    <h2>Relics</h2>
    <p class="muted">A relic reacts to run events while it is owned. Grant one from an event choice's
        <strong>+ Relic</strong>.</p>

    @if (Blueprint.Relics.Count == 0)
    {
        <p class="muted">No relics yet — add one below.</p>
    }

    @for (var ri = 0; ri < Blueprint.Relics.Count; ri++)
    {
        var relicIndex = ri;
        var relic = Blueprint.Relics[ri];
        <div class="editor-card">
            <div class="run-bar">
                <label>Relic id
                    <input value="@relic.Id" @onchange="e => SetRelicId(relicIndex, AsString(e.Value))" style="width:9rem" />
                </label>
                <label>Name
                    <input value="@relic.DisplayName" @onchange="e => SetRelicName(relicIndex, AsString(e.Value))" style="width:11rem" />
                </label>
                <button class="mini" @onclick="() => RemoveRelic(relicIndex)">✕ remove</button>
            </div>

            @for (var pi = 0; pi < relic.RunPrograms.Count; pi++)
            {
                var reactionIndex = pi;
                var reaction = relic.RunPrograms[pi];
                var cond = RelicConditions.Classify(ConditionOf(reaction));
                <div class="editor-choice">
                    @if (IsEditable(reaction))
                    {
                        <div class="run-bar">
                            <label>When
                                <select value="@EventKey(reaction.EventType)"
                                        @onchange="e => SetReactionEvent(relicIndex, reactionIndex, AsString(e.Value))">
                                    @foreach (var kind in RunEventCatalog.All)
                                    {
                                        <option value="@kind.Key">@kind.Label</option>
                                    }
                                </select>
                            </label>
                            <button class="mini" @onclick="() => RemoveReaction(relicIndex, reactionIndex)">✕ reaction</button>
                        </div>
                        <div class="run-bar">
                            <span class="muted">if</span>
                            @ConditionEditor(cond, spec => SetCondition(relicIndex, reactionIndex, spec), allowNone: true)
                        </div>
                        <div class="editor-effects">
                            @{
                                var effects = Templates(reaction);
                            }
                            @for (var fi = 0; fi < effects.Count; fi++)
                            {
                                var fx = fi;
                                var tpl = effects[fx];
                                @if (tpl is LiteralEffectTemplate lit && RelicRequests.IsBlock(lit.Effect))
                                {
                                    <RelicCompositeEditor Request="lit.Effect"
                                                          RequestChanged="req => SetEffectTemplate(relicIndex, reactionIndex, fx, new LiteralEffectTemplate(req))"
                                                          Removed="() => RemoveEffect(relicIndex, reactionIndex, fx)"
                                                          LeafEditor="RequestEditor"
                                                          AmountEditor="AmountEditor"
                                                          ConditionEditor="ConditionEditor" />
                                }
                                else
                                {
                                    <span class="fx">
                                        @EffectEditor(relicIndex, reactionIndex, fx, tpl)
                                        <button class="mini" @onclick="() => RemoveEffect(relicIndex, reactionIndex, fx)">✕</button>
                                    </span>
                                }
                            }
                            <span class="add-effect">
                                <span class="muted">add:</span>
                                @foreach (var (kind, label) in EffectKinds)
                                {
                                    <button class="mini" title="@label"
                                            @onclick="() => AddEffect(relicIndex, reactionIndex, kind)">+ @label</button>
                                }
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="run-bar">
                            <span class="muted">When <strong>@EventLabel(reaction.EventType)</strong> —
                                advanced reaction (edit in JSON)</span>
                            <button class="mini" @onclick="() => RemoveReaction(relicIndex, reactionIndex)">✕ reaction</button>
                        </div>
                    }
                </div>
            }
            <button class="mini" @onclick="() => AddReaction(relicIndex)">+ reaction</button>

            <div class="editor-choice">
                <div class="run-bar">
                    <span class="muted">Combat rules</span>
                    <span class="muted" style="font-size:.85em">— programs this relic injects into every fight it is owned in</span>
                </div>
                @for (var ci = 0; ci < relic.CombatRules.Count; ci++)
                {
                    var ruleIndex = ci;
                    var rule = relic.CombatRules[ci];
                    <div class="fx-block">
                        <div class="run-bar">
                            <span class="muted">on</span>
                            <select value="@rule.Trigger" @onchange="e => SetRuleTrigger(relicIndex, ruleIndex, AsString(e.Value))">
                                @foreach (var key in RelicCombatTriggers.Keys)
                                {
                                    <option value="@key">@key</option>
                                }
                            </select>
                            <span class="muted">priority</span>
                            <input type="number" value="@rule.Priority" style="width:4rem"
                                   @onchange="e => SetRulePriority(relicIndex, ruleIndex, AsInt(e.Value, rule.Priority))" />
                            @{ var simple = _jsonRules.Contains((relicIndex, ruleIndex)) ? null : SimpleOf(rule); }
                            @if (simple is not null)
                            {
                                <button class="mini" @onclick="() => SetRuleJsonMode(relicIndex, ruleIndex, true)">edit as JSON</button>
                            }
                            else if (SimpleOf(rule) is not null)
                            {
                                <button class="mini" @onclick="() => SetRuleJsonMode(relicIndex, ruleIndex, false)">visual editor</button>
                            }
                            <button class="mini" @onclick="() => RemoveCombatRule(relicIndex, ruleIndex)">✕ rule</button>
                        </div>
                        @if (simple is { } spec)
                        {
                            <div class="run-bar">
                                <select value="@spec.NodeKind" @onchange="e => SetRuleNode(relicIndex, ruleIndex, AsString(e.Value))">
                                    @foreach (var kind in Enum.GetValues<SimpleNodeKind>())
                                    {
                                        <option value="@kind">@NodeLabel(kind)</option>
                                    }
                                </select>
                                <select value="@spec.SelectorKey" @onchange="e => SetRuleSelector(relicIndex, ruleIndex, AsString(e.Value))">
                                    @foreach (var key in SimpleCombatProgram.SelectorKeys)
                                    {
                                        <option value="@key">@key</option>
                                    }
                                </select>
                                <span class="muted">amount</span>
                                <select value="@spec.AmountKind" @onchange="e => SetRuleAmountKind(relicIndex, ruleIndex, AsString(e.Value))">
                                    @foreach (var kind in Enum.GetValues<SimpleAmountKind>())
                                    {
                                        <option value="@kind">@AmountLabel(kind)</option>
                                    }
                                </select>
                                @if (spec.AmountKind == SimpleAmountKind.Const)
                                {
                                    <input type="number" value="@spec.Const" style="width:4rem"
                                           @onchange="e => SetRuleConst(relicIndex, ruleIndex, AsInt(e.Value, spec.Const))" />
                                }
                            </div>
                        }
                        else
                        {
                            <div class="fx-body">
                                <span class="muted">program (JSON — edit &amp; blur to apply):</span>
                                <textarea rows="6" style="width:100%;font-family:monospace"
                                          @onchange="e => SetRuleProgram(relicIndex, ruleIndex, AsString(e.Value))">@ProgramJson(rule)</textarea>
                            </div>
                        }
                    </div>
                }
                @if (_combatRuleError is { } err)
                {
                    <div class="run-bar"><span style="color:#c33">@err</span></div>
                }
                <div class="run-bar">
                    <select @bind="_newRuleTrigger">
                        @foreach (var key in RelicCombatTriggers.Keys)
                        {
                            <option value="@key">@key</option>
                        }
                    </select>
                    <button class="mini" @onclick="() => AddCombatRule(relicIndex)">+ combat rule</button>
                </div>
            </div>
        </div>
    }

    <div class="run-bar">
        <input placeholder="new relic id" @bind="_newRelicId" style="width:11rem" />
        <button class="play" @onclick="AddRelic">Add relic</button>
    </div>
</section>

@code {
    [Parameter] public RunBlueprint Blueprint { get; set; } = default!;
    [Parameter] public EventCallback<RunBlueprint> BlueprintChanged { get; set; }

    private string _newRelicId = "";

    private static string AsString(object? v) => v?.ToString() ?? "";
    private static int AsInt(object? v, int fallback) => int.TryParse(v?.ToString(), out var n) ? n : fallback;

    private static readonly (string Kind, string Label)[] EffectKinds =
    {
        ("gold", "Gold"),
        ("resource", "Resource"),
        ("heal", "Heal"),
        ("damage", "Damage"),
        ("maxhp", "Max HP"),
        ("flag", "Flag"),
        ("counter", "Counter"),
        ("setcounter", "Set counter"),
        ("addcard", "Add card"),
        ("removecard", "Remove card"),
        ("addrelic", "Add relic"),
        ("removerelic", "Remove relic"),
        ("disablerelic", "Disable relic"),
        ("enablerelic", "Enable relic"),
        ("consumable", "Consumable"),
        ("repeat", "Repeat…"),
        ("conditional", "If…"),
        ("grantreward", "Grant reward…"),
        ("offerreward", "Offer reward…"),
        ("offerpool", "Offer reward (random)…"),
        ("draw", "Random draw…"),
        ("drawmany", "Random draw N…"),
    };

    // The relic ids a grant/removal can pick: the run's authored relics plus the built-in samples
    // (bloodstone/leech), matching what RunSandbox.BuildContent registers — same set the EventEditor offers.
    private static readonly string[] BuiltInRelicIds = { "bloodstone", "leech" };

    private string[] RelicIds() =>
        Blueprint.Relics.Select(r => r.Id).Concat(BuiltInRelicIds).Distinct(StringComparer.Ordinal).ToArray();

    private string FirstRelicId() => RelicIds().FirstOrDefault() ?? "bloodstone";

    private IEnumerable<(string Key, string Label)> RelicOptions() =>
        RelicIds().Select(id => (id, id));

    // The deck cards an "add card" can pick (blank sentinel first, like the EventEditor).
    private IEnumerable<(string Key, string Label)> CardOptions() =>
        new[] { ("", "— card —") }.Concat(Blueprint.Cards.Select(c => (c.Id, c.Id)));

    // Condition authoring.
    private static readonly (string Kind, string Label)[] ConditionKinds =
    {
        ("none", "always"),
        ("compare", "a value compares…"),
        ("victory", "combat was a victory"),
        ("defeat", "combat was a defeat"),
        ("flag", "a flag is set"),
    };

    private static readonly (string Kind, string Label)[] CompareValues =
    {
        ("gold", "gold"),
        ("currentHp", "current HP"),
        ("maxHp", "max HP"),
        ("missingHp", "missing HP"),
        ("deckSize", "deck size"),
        ("relicCount", "relic count"),
        ("consumableCount", "consumables"),
        ("resource", "resource…"),
        ("counter", "counter…"),
    };

    private static readonly RunComparisonOperator[] Operators = Enum.GetValues<RunComparisonOperator>();

    private static string OpSymbol(RunComparisonOperator op) => op switch
    {
        RunComparisonOperator.Equal => "==",
        RunComparisonOperator.NotEqual => "≠",
        RunComparisonOperator.LessThan => "<",
        RunComparisonOperator.LessOrEqual => "≤",
        RunComparisonOperator.GreaterThan => ">",
        RunComparisonOperator.GreaterOrEqual => "≥",
        _ => op.ToString(),
    };

    private static RunComparisonOperator ParseOp(string s) =>
        Enum.TryParse<RunComparisonOperator>(s, out var op) ? op : RunComparisonOperator.GreaterOrEqual;

    private Task Apply(IReadOnlyList<RelicData> relics) =>
        BlueprintChanged.InvokeAsync(Blueprint with { Relics = relics });

    private Task EditRelic(int relicIndex, Func<RelicData, RelicData> edit)
    {
        var relics = Blueprint.Relics.ToList();
        if (relicIndex < 0 || relicIndex >= relics.Count)
            return Task.CompletedTask;
        relics[relicIndex] = edit(relics[relicIndex]);
        return Apply(relics);
    }

    private Task EditReactions(int relicIndex, Func<List<ITriggeredRunEffectDefinition>, List<ITriggeredRunEffectDefinition>> edit) =>
        EditRelic(relicIndex, relic => relic with { RunPrograms = edit(relic.RunPrograms.ToList()) });

    // ── combat rules (face (b): programs the relic injects into fights) ──────────────
    // Each rule = a combat trigger (from the RelicCombatTriggers catalog) + an EffectProgram authored as JSON +
    // a firing priority. The program's context is fixed by the trigger, so changing the trigger resets the program
    // to that context's default, and the JSON is (de)serialized through the trigger (context-specific CombatJson).
    private string _newRuleTrigger = RelicCombatTriggers.Keys.First();
    private string? _combatRuleError;
    private static readonly System.Text.Json.JsonSerializerOptions PrettyProgramJson = new() { WriteIndented = true };

    private static string ProgramJson(RelicCombatRule rule) =>
        System.Text.Json.JsonSerializer.Serialize(RelicCombatTriggers.Get(rule.Trigger).Serialize(rule.Program), PrettyProgramJson);

    private Task EditCombatRules(int relicIndex, Func<List<RelicCombatRule>, List<RelicCombatRule>> edit) =>
        EditRelic(relicIndex, relic => relic with { CombatRules = edit(relic.CombatRules.ToList()) });

    private Task AddCombatRule(int relicIndex)
    {
        _combatRuleError = null;
        if (!RelicCombatTriggers.TryGet(_newRuleTrigger, out var trigger))
            return Task.CompletedTask;
        return EditCombatRules(relicIndex, rules =>
        {
            rules.Add(new RelicCombatRule { Trigger = _newRuleTrigger, Program = trigger.NewProgram(), Priority = 0 });
            return rules;
        });
    }

    private Task RemoveCombatRule(int relicIndex, int ruleIndex)
    {
        _combatRuleError = null;
        _jsonRules.Clear(); // indices shift after a removal — drop the (index-keyed) JSON-mode pins
        return EditCombatRules(relicIndex, rules =>
        {
            if (ruleIndex >= 0 && ruleIndex < rules.Count)
                rules.RemoveAt(ruleIndex);
            return rules;
        });
    }

    private Task SetRulePriority(int relicIndex, int ruleIndex, int priority) =>
        EditCombatRules(relicIndex, rules =>
        {
            if (ruleIndex >= 0 && ruleIndex < rules.Count)
                rules[ruleIndex] = rules[ruleIndex] with { Priority = priority };
            return rules;
        });

    // Changing the trigger changes the program's context, so the old program no longer type-checks — reset it to
    // the new trigger's default so the rule stays valid and authorable.
    private Task SetRuleTrigger(int relicIndex, int ruleIndex, string triggerKey)
    {
        _combatRuleError = null;
        if (!RelicCombatTriggers.TryGet(triggerKey, out var trigger))
            return Task.CompletedTask;
        _jsonRules.Remove((relicIndex, ruleIndex)); // the reset program is the trigger's (visual) default
        return EditCombatRules(relicIndex, rules =>
        {
            if (ruleIndex >= 0 && ruleIndex < rules.Count)
                rules[ruleIndex] = rules[ruleIndex] with { Trigger = triggerKey, Program = trigger.NewProgram() };
            return rules;
        });
    }

    // Parse the edited JSON in the rule's trigger context; on success replace the program, on failure surface the
    // error and leave the model unchanged (the textarea reverts to the last valid program on re-render).
    private Task SetRuleProgram(int relicIndex, int ruleIndex, string json)
    {
        if (relicIndex < 0 || relicIndex >= Blueprint.Relics.Count)
            return Task.CompletedTask;
        var rules = Blueprint.Relics[relicIndex].CombatRules;
        if (ruleIndex < 0 || ruleIndex >= rules.Count)
            return Task.CompletedTask;
        var trigger = RelicCombatTriggers.Get(rules[ruleIndex].Trigger);
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var program = trigger.Deserialize(doc.RootElement);
            _combatRuleError = null;
            return EditCombatRules(relicIndex, list =>
            {
                if (ruleIndex >= 0 && ruleIndex < list.Count)
                    list[ruleIndex] = list[ruleIndex] with { Program = program };
                return list;
            });
        }
        catch (Exception ex) when (ex is System.Text.Json.JsonException or NotSupportedException
            or KeyNotFoundException or InvalidOperationException or ArgumentException)
        {
            _combatRuleError = $"Program JSON invalid: {ex.Message}";
            return Task.CompletedTask;
        }
    }

    // ── combat rules: visual (SimpleProgram) editor (R4) ─────────────────────────
    // A rule whose program falls inside the editable subset (single leaf node × selector × const|event amount) gets
    // dropdowns instead of the JSON textarea; a per-rule "edit as JSON" toggle forces the escape. _jsonRules holds
    // the (relic, rule) indices the user pinned to JSON; it's cleared on any structural change (remove / trigger
    // change) since those shift indices or reset the program to a fresh (visual) default.
    private readonly HashSet<(int Relic, int Rule)> _jsonRules = new();

    private static SimpleProgram? SimpleOf(RelicCombatRule rule) =>
        RelicCombatTriggers.TryGet(rule.Trigger, out var trigger) ? trigger.ToSimple(rule.Program) : null;

    private static string NodeLabel(SimpleNodeKind kind) => kind switch
    {
        SimpleNodeKind.GainBlock => "gain block",
        SimpleNodeKind.Heal => "heal",
        SimpleNodeKind.DealDamage => "deal damage",
        _ => kind.ToString(),
    };

    private static string AmountLabel(SimpleAmountKind kind) => kind switch
    {
        SimpleAmountKind.Const => "constant",
        SimpleAmountKind.EventAmount => "event amount",
        _ => kind.ToString(),
    };

    private void SetRuleJsonMode(int relicIndex, int ruleIndex, bool json)
    {
        if (json)
            _jsonRules.Add((relicIndex, ruleIndex));
        else
            _jsonRules.Remove((relicIndex, ruleIndex));
    }

    // Rebuild the rule's program from an edited SimpleProgram via the trigger (fixes the context). The four setters
    // read the current spec, apply one `with`, and route through here so a single place does the FromSimple build.
    private Task SetRuleSimple(int relicIndex, int ruleIndex, Func<SimpleProgram, SimpleProgram> edit)
    {
        _combatRuleError = null;
        return EditCombatRules(relicIndex, rules =>
        {
            if (ruleIndex >= 0 && ruleIndex < rules.Count
                && RelicCombatTriggers.TryGet(rules[ruleIndex].Trigger, out var trigger)
                && trigger.ToSimple(rules[ruleIndex].Program) is { } spec)
            {
                rules[ruleIndex] = rules[ruleIndex] with { Program = trigger.FromSimple(edit(spec)) };
            }
            return rules;
        });
    }

    private Task SetRuleNode(int relicIndex, int ruleIndex, string node) =>
        SetRuleSimple(relicIndex, ruleIndex, s => s with { NodeKind = Enum.Parse<SimpleNodeKind>(node) });

    private Task SetRuleSelector(int relicIndex, int ruleIndex, string selector) =>
        SetRuleSimple(relicIndex, ruleIndex, s => s with { SelectorKey = selector });

    private Task SetRuleAmountKind(int relicIndex, int ruleIndex, string amount) =>
        SetRuleSimple(relicIndex, ruleIndex, s => s with { AmountKind = Enum.Parse<SimpleAmountKind>(amount) });

    private Task SetRuleConst(int relicIndex, int ruleIndex, int value) =>
        SetRuleSimple(relicIndex, ruleIndex, s => s with { Const = value });

    // ── relic level ─────────────────────────────────────────────────────────────
    private Task SetRelicId(int relicIndex, string id) =>
        string.IsNullOrWhiteSpace(id) ? Task.CompletedTask : EditRelic(relicIndex, r => r with { Id = id.Trim() });

    private Task SetRelicName(int relicIndex, string name) =>
        EditRelic(relicIndex, r => r with { DisplayName = name });

    private Task RemoveRelic(int relicIndex)
    {
        var relics = Blueprint.Relics.ToList();
        if (relicIndex >= 0 && relicIndex < relics.Count)
            relics.RemoveAt(relicIndex);
        return Apply(relics);
    }

    private Task AddRelic()
    {
        var id = _newRelicId.Trim();
        if (id.Length == 0 || Blueprint.Relics.Any(r => r.Id == id))
            return Task.CompletedTask;
        var relic = new RelicData
        {
            Id = id,
            DisplayName = id,
            RunPrograms = new[] { BuildProgram("nodeEntered", new[] { NewTemplate("gold") }, null) },
        };
        _newRelicId = "";
        return Apply(Blueprint.Relics.Append(relic).ToList());
    }

    // ── reaction level ────────────────────────────────────────────────────────────
    private Task AddReaction(int relicIndex) =>
        EditReactions(relicIndex, programs =>
        {
            programs.Add(BuildProgram("nodeEntered", new[] { NewTemplate("gold") }, null));
            return programs;
        });

    private Task RemoveReaction(int relicIndex, int reactionIndex) =>
        EditReactions(relicIndex, programs =>
        {
            if (reactionIndex >= 0 && reactionIndex < programs.Count)
                programs.RemoveAt(reactionIndex);
            return programs;
        });

    private Task SetReactionEvent(int relicIndex, int reactionIndex, string eventKey) =>
        EditReactions(relicIndex, programs =>
        {
            if (reactionIndex >= 0 && reactionIndex < programs.Count)
                programs[reactionIndex] = BuildProgram(eventKey, Templates(programs[reactionIndex]), ConditionOf(programs[reactionIndex]));
            return programs;
        });

    private Task SetCondition(int relicIndex, int reactionIndex, RelicConditionSpec spec) =>
        EditReactions(relicIndex, programs =>
        {
            if (reactionIndex >= 0 && reactionIndex < programs.Count)
            {
                var program = programs[reactionIndex];
                programs[reactionIndex] = BuildProgram(EventKey(program.EventType), Templates(program), RelicConditions.Build(spec));
            }
            return programs;
        });

    // ── effect level ──────────────────────────────────────────────────────────────
    private Task SetReactionEffects(int relicIndex, int reactionIndex, IReadOnlyList<IRunEffectTemplate> effects) =>
        EditReactions(relicIndex, programs =>
        {
            if (reactionIndex >= 0 && reactionIndex < programs.Count)
                programs[reactionIndex] = BuildProgram(EventKey(programs[reactionIndex].EventType), effects, ConditionOf(programs[reactionIndex]));
            return programs;
        });

    private Task AddEffect(int relicIndex, int reactionIndex, string kind)
    {
        var reaction = Blueprint.Relics[relicIndex].RunPrograms[reactionIndex];
        return SetReactionEffects(relicIndex, reactionIndex, Templates(reaction).Append(NewTemplate(kind)).ToList());
    }

    private Task RemoveEffect(int relicIndex, int reactionIndex, int effectIndex)
    {
        var effects = Templates(Blueprint.Relics[relicIndex].RunPrograms[reactionIndex]).ToList();
        if (effectIndex >= 0 && effectIndex < effects.Count)
            effects.RemoveAt(effectIndex);
        return SetReactionEffects(relicIndex, reactionIndex, effects);
    }

    private Task SetEffectTemplate(int relicIndex, int reactionIndex, int effectIndex, IRunEffectTemplate template)
    {
        var effects = Templates(Blueprint.Relics[relicIndex].RunPrograms[reactionIndex]).ToList();
        if (effectIndex >= 0 && effectIndex < effects.Count)
            effects[effectIndex] = template;
        return SetReactionEffects(relicIndex, reactionIndex, effects);
    }

    private IRunEffectTemplate NewTemplate(string kind) => kind switch
    {
        "gold" => new GainResourceTemplate(StandardRunIds.Gold, RunExpr.Const(10)),
        "resource" => new GainResourceTemplate(new RunResourceId("resource"), RunExpr.Const(5)),
        "heal" => new HealTemplate(RunExpr.Const(5)),
        "damage" => new DamageTemplate(RunExpr.Const(3)),
        "maxhp" => new LiteralEffectTemplate(new ChangeMaxHealthRunEffect(5)),
        "flag" => new LiteralEffectTemplate(new SetFlagRunEffect(new RunFlagId("flag"))),
        "counter" => new LiteralEffectTemplate(new IncrementCounterRunEffect(new RunCounterId("counter"), 1)),
        "setcounter" => new LiteralEffectTemplate(new SetCounterRunEffect(new RunCounterId("counter"), 0)),
        "addcard" => new LiteralEffectTemplate(
            new AddCardToDeckRunEffect(new CardDefinitionId(Blueprint.Cards.Select(c => c.Id).FirstOrDefault() ?? ""))),
        "removecard" => new LiteralEffectTemplate(
            new RemoveCardsRunEffect(RunSelectors.DeckCards.ChooseByPlayer(1, "Choose a card to remove"))),
        "addrelic" => new LiteralEffectTemplate(new AddRelicByIdRunEffect(new RelicId(FirstRelicId()))),
        "removerelic" => new LiteralEffectTemplate(new RemoveRelicRunEffect(new RelicId(FirstRelicId()))),
        "disablerelic" => new LiteralEffectTemplate(new DisableRelicRunEffect(new RelicId(FirstRelicId()), 1)),
        "enablerelic" => new LiteralEffectTemplate(new EnableRelicRunEffect(new RelicId(FirstRelicId()))),
        "consumable" => new LiteralEffectTemplate(
            new AddConsumableRunEffect(new ConsumableId("potion"), new IRunEffectRequest[] { new HealRunEffect(8) })),
        "repeat" => new LiteralEffectTemplate(new RepeatRunEffect(
            RunExpr.Const(2), new IRunEffectRequest[] { new ChangeResourceRunEffect(StandardRunIds.Gold, 5) })),
        "conditional" => new LiteralEffectTemplate(new ConditionalRunEffect(
            RelicConditions.Build(new RelicConditionSpec("compare"))!,
            new IRunEffectRequest[] { new ChangeResourceRunEffect(StandardRunIds.Gold, 5) },
            Array.Empty<IRunEffectRequest>())),
        "grantreward" => new LiteralEffectTemplate(new GrantRewardRunEffect(
            new RewardId("reward"), new IRunEffectRequest[] { new ChangeResourceRunEffect(StandardRunIds.Gold, 10) })),
        "offerreward" => new LiteralEffectTemplate(new OfferRewardRunEffect(
            new RewardId("reward"),
            new RewardOffer[]
            {
                new("offer-1", new IRunEffectRequest[] { new AddCardToDeckRunEffect(new CardDefinitionId("")) }),
                new("offer-2", new IRunEffectRequest[] { new ChangeResourceRunEffect(StandardRunIds.Gold, 20) }),
            },
            pickCount: 1)),
        "offerpool" => new LiteralEffectTemplate(new OfferRewardRunEffect(
            new RewardId("reward"), new PoolRewardSource(RelicRequests.DefaultOfferPool(), 2), pickCount: 1)),
        "draw" => new LiteralEffectTemplate(new DrawEffectsRunEffect(RelicRequests.DefaultBundlePool())),
        "drawmany" => new LiteralEffectTemplate(new DrawManyEffectsRunEffect(RelicRequests.DefaultBundlePool(), 1)),
        _ => new LiteralEffectTemplate(new ChangeMaxHealthRunEffect(0)),
    };

    // ── reaction (de)composition ────────────────────────────────────────────────────
    // A reaction is editable iff it is a DataTriggeredRunEffect whose condition (if any) and every effect template
    // are shapes the editor can round-trip. Anything richer is preserved and shown read-only.
    private static bool IsEditable(ITriggeredRunEffectDefinition reaction)
    {
        var type = reaction.GetType();
        if (!type.IsGenericType || type.GetGenericTypeDefinition() != typeof(DataTriggeredRunEffect<>))
            return false;
        if (RelicConditions.IsAdvanced(ConditionOf(reaction)))
            return false;
        return TemplatesOf(reaction).All(IsEditableTemplate);
    }

    private static bool IsEditableTemplate(IRunEffectTemplate template) => Normalize(template) switch
    {
        GainResourceTemplate g => !RelicAmounts.IsAdvanced(g.Amount),
        HealTemplate h => !RelicAmounts.IsAdvanced(h.Amount),
        DamageTemplate d => !RelicAmounts.IsAdvanced(d.Amount),
        LiteralEffectTemplate { Effect: ChangeMaxHealthRunEffect or SetFlagRunEffect or IncrementCounterRunEffect } => true,
        LiteralEffectTemplate { Effect: SetCounterRunEffect or AddCardToDeckRunEffect or RemoveCardsRunEffect } => true,
        LiteralEffectTemplate { Effect: AddRelicByIdRunEffect or RemoveRelicRunEffect or DisableRelicRunEffect or EnableRelicRunEffect } => true,
        // A consumable grant is editable only in the single-heal shape the editor renders; richer use-effect lists
        // are preserved read-only.
        LiteralEffectTemplate { Effect: AddConsumableRunEffect c } =>
            c.UseEffects.Count == 1 && c.UseEffects[0] is HealRunEffect,
        // A repeat is editable iff its count is a modellable amount and every body effect is a body leaf the
        // nested editor can round-trip; otherwise it is preserved read-only.
        LiteralEffectTemplate { Effect: RepeatRunEffect rp } =>
            !RelicAmounts.IsAdvanced(rp.Count) && rp.Effects.All(RelicRequests.IsEditable),
        // A conditional is editable iff its condition is a modellable one and both branches are body leaves the
        // nested editor can round-trip.
        LiteralEffectTemplate { Effect: ConditionalRunEffect cnd } =>
            !RelicConditions.IsAdvanced(cnd.Condition)
            && cnd.WhenTrue.All(RelicRequests.IsEditable) && cnd.WhenFalse.All(RelicRequests.IsEditable),
        // A grant-reward is editable iff every effect it bundles is a body leaf the nested editor can round-trip.
        LiteralEffectTemplate { Effect: GrantRewardRunEffect gr } => gr.Effects.All(RelicRequests.IsEditable),
        // An offer-reward is editable only with the fixed-offer source (the editor models a static list); every
        // offer's grant must be body leaves. Pool/delegate sources are preserved read-only.
        LiteralEffectTemplate { Effect: OfferRewardRunEffect { Source: FixedRewardSource ofr } } =>
            ofr.Offers.All(o => o.Grant.All(RelicRequests.IsEditable)),
        // A random (pool-source) offer is editable iff every offer in the weighted pool holds body-leaf grants.
        LiteralEffectTemplate { Effect: OfferRewardRunEffect { Source: PoolRewardSource opr } } =>
            RelicRequests.OfferPoolEditable(opr.Pool),
        // A random draw is editable iff every outcome bundle in its pool holds body leaves we can round-trip.
        LiteralEffectTemplate { Effect: DrawEffectsRunEffect de } => RelicRequests.BundlePoolEditable(de.Pool),
        LiteralEffectTemplate { Effect: DrawManyEffectsRunEffect dm } => RelicRequests.BundlePoolEditable(dm.Pool),
        _ => false,
    };

    // Normalize so gold/resource/heal/damage are always the computed template form (a constant literal becomes a
    // Const expression) — the single shape the effect editor edits. Max-HP / flag / counter stay literal.
    private static IRunEffectTemplate Normalize(IRunEffectTemplate template) => template switch
    {
        LiteralEffectTemplate { Effect: ChangeResourceRunEffect r } => new GainResourceTemplate(r.Resource, RunExpr.Const(r.Delta)),
        LiteralEffectTemplate { Effect: HealRunEffect h } => new HealTemplate(RunExpr.Const(h.Amount)),
        LiteralEffectTemplate { Effect: ApplyRunDamageRunEffect d } => new DamageTemplate(RunExpr.Const(d.Amount)),
        _ => template,
    };

    private static IReadOnlyList<IRunEffectTemplate> Templates(ITriggeredRunEffectDefinition reaction) =>
        TemplatesOf(reaction).Select(Normalize).ToList();

    private static IReadOnlyList<IRunEffectTemplate> TemplatesOf(ITriggeredRunEffectDefinition reaction) =>
        reaction.GetType().GetProperty("Templates")?.GetValue(reaction) as IReadOnlyList<IRunEffectTemplate>
        ?? Array.Empty<IRunEffectTemplate>();

    private static IRunExpression<bool>? ConditionOf(ITriggeredRunEffectDefinition reaction) =>
        reaction.GetType().GetProperty("Condition")?.GetValue(reaction) as IRunExpression<bool>;

    private static ITriggeredRunEffectDefinition BuildProgram(
        string eventKey, IReadOnlyList<IRunEffectTemplate> templates, IRunExpression<bool>? condition) =>
        RunEventCatalog.Build(eventKey, condition, templates);

    private static string EventKey(Type eventType) => RunEventCatalog.KeyFor(eventType);

    private static string EventLabel(Type eventType) => RunEventCatalog.LabelFor(eventType);

    // Inline editor for one effect template: a constant/computed amount for gold/resource/heal/damage, or the
    // literal control for max-HP / flag / counter.
    private RenderFragment EffectEditor(int ri, int rx, int fx, IRunEffectTemplate template) => builder =>
    {
        var seq = 0;

        void Set(IRunEffectTemplate next) =>
            _ = SetEffectTemplate(ri, rx, fx, next);

        void Label(string text) => builder.AddContent(seq++, text + " ");

        void TextInput(string value, int width, Action<string> onChange)
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "value", value);
            builder.AddAttribute(seq++, "style", $"width:{width}rem");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(AsString(e.Value))));
            builder.CloseElement();
        }

        void NumberInput(int value, Action<int> onChange)
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "value", value);
            builder.AddAttribute(seq++, "style", "width:4rem");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(AsInt(e.Value, value))));
            builder.CloseElement();
        }

        void Select(string current, IEnumerable<(string Key, string Label)> options, Action<string> onChange)
        {
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "value", current);
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(AsString(e.Value))));
            foreach (var (key, label) in options)
            {
                builder.OpenElement(seq++, "option");
                builder.AddAttribute(seq++, "value", key);
                builder.AddContent(seq++, label);
                builder.CloseElement();
            }
            builder.CloseElement();
        }

        // Amount editor: reuse the shared AmountEditor (source toggle + matching control). `make` wraps the
        // rebuilt amount expression back into the effect template.
        void AmountControls(IRunExpression<int> amount, Func<IRunExpression<int>, IRunEffectTemplate> make) =>
            builder.AddContent(seq++, AmountEditor(RelicAmounts.Classify(amount),
                spec => Set(make(RelicAmounts.Build(spec)))));

        switch (template)
        {
            case GainResourceTemplate g when g.Resource == StandardRunIds.Gold:
                Label("Gold");
                AmountControls(g.Amount, a => new GainResourceTemplate(StandardRunIds.Gold, a));
                break;
            case GainResourceTemplate g:
                Label("Resource");
                TextInput(g.Resource.Value, 6, s => Set(new GainResourceTemplate(new RunResourceId(s), g.Amount)));
                AmountControls(g.Amount, a => new GainResourceTemplate(g.Resource, a));
                break;
            case HealTemplate h:
                Label("Heal");
                AmountControls(h.Amount, a => new HealTemplate(a));
                break;
            case DamageTemplate d:
                Label("Lose HP");
                AmountControls(d.Amount, a => new DamageTemplate(a));
                break;
            case LiteralEffectTemplate { Effect: ChangeMaxHealthRunEffect m }:
                Label("Max HP Δ");
                NumberInput(m.Delta, n => Set(new LiteralEffectTemplate(new ChangeMaxHealthRunEffect(n))));
                break;
            case LiteralEffectTemplate { Effect: SetFlagRunEffect f }:
                Label("Set flag");
                TextInput(f.Flag.Value, 7, s => Set(new LiteralEffectTemplate(new SetFlagRunEffect(new RunFlagId(s), f.Value))));
                break;
            case LiteralEffectTemplate { Effect: IncrementCounterRunEffect c }:
                Label("Counter");
                TextInput(c.Counter.Value, 6, s => Set(new LiteralEffectTemplate(new IncrementCounterRunEffect(new RunCounterId(s), c.Delta))));
                Label(" by");
                NumberInput(c.Delta, n => Set(new LiteralEffectTemplate(new IncrementCounterRunEffect(c.Counter, n))));
                break;
            case LiteralEffectTemplate { Effect: SetCounterRunEffect sc }:
                Label("Set counter");
                TextInput(sc.Counter.Value, 6, s => Set(new LiteralEffectTemplate(new SetCounterRunEffect(new RunCounterId(s), sc.Value))));
                Label(" =");
                NumberInput(sc.Value, n => Set(new LiteralEffectTemplate(new SetCounterRunEffect(sc.Counter, n))));
                break;
            case LiteralEffectTemplate { Effect: AddCardToDeckRunEffect ac }:
                Label("Add card");
                Select(ac.Card.value, CardOptions(),
                    s => Set(new LiteralEffectTemplate(new AddCardToDeckRunEffect(new CardDefinitionId(s)))));
                break;
            case LiteralEffectTemplate { Effect: RemoveCardsRunEffect }:
                Label("Remove a card (player picks)");
                break;
            case LiteralEffectTemplate { Effect: AddRelicByIdRunEffect ar }:
                Label("Add relic");
                Select(ar.Relic.Value, RelicOptions(),
                    s => Set(new LiteralEffectTemplate(new AddRelicByIdRunEffect(new RelicId(s)))));
                break;
            case LiteralEffectTemplate { Effect: RemoveRelicRunEffect rr }:
                Label("Remove relic");
                Select(rr.Relic.Value, RelicOptions(),
                    s => Set(new LiteralEffectTemplate(new RemoveRelicRunEffect(new RelicId(s)))));
                break;
            case LiteralEffectTemplate { Effect: DisableRelicRunEffect dr }:
                Label("Disable relic");
                Select(dr.Relic.Value, RelicOptions(),
                    s => Set(new LiteralEffectTemplate(new DisableRelicRunEffect(new RelicId(s), dr.Combats))));
                Label(" for");
                NumberInput(dr.Combats, n => Set(new LiteralEffectTemplate(new DisableRelicRunEffect(dr.Relic, n))));
                Label("combats");
                break;
            case LiteralEffectTemplate { Effect: EnableRelicRunEffect er }:
                Label("Enable relic");
                Select(er.Relic.Value, RelicOptions(),
                    s => Set(new LiteralEffectTemplate(new EnableRelicRunEffect(new RelicId(s)))));
                break;
            case LiteralEffectTemplate { Effect: AddConsumableRunEffect cn }
                when cn.UseEffects.Count == 1 && cn.UseEffects[0] is HealRunEffect cnHeal:
                Label("Consumable");
                TextInput(cn.Definition.Value, 6,
                    s => Set(new LiteralEffectTemplate(new AddConsumableRunEffect(new ConsumableId(s), cn.UseEffects))));
                Label(" heals");
                NumberInput(cnHeal.Amount, n => Set(new LiteralEffectTemplate(
                    new AddConsumableRunEffect(cn.Definition, new IRunEffectRequest[] { new HealRunEffect(n) }))));
                break;
            default:
                builder.AddContent(seq++, template.GetType().Name);
                break;
        }
    };

    // Shared amount control: a source toggle (constant vs a run/event value) plus the matching input(s). Emits
    // the edited spec through `onChange`; the caller decides how to fold it back (a template amount, a Repeat
    // count, a Computed* body effect). Used by both EffectEditor and RequestEditor so amounts author identically.
    private RenderFragment AmountEditor(RelicAmountSpec spec, Action<RelicAmountSpec> onChange) => builder =>
    {
        var seq = 0;

        void Select(string current, IEnumerable<(string Key, string Label)> options, Action<string> change)
        {
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "value", current);
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => change(AsString(e.Value))));
            foreach (var (key, label) in options)
            {
                builder.OpenElement(seq++, "option");
                builder.AddAttribute(seq++, "value", key);
                builder.AddContent(seq++, label);
                builder.CloseElement();
            }
            builder.CloseElement();
        }

        Select(spec.Kind == "value" ? "value" : "const",
            new[] { ("const", "amount"), ("value", "value of…") },
            kind => onChange(spec with { Kind = kind }));
        if (spec.Kind == "value")
        {
            Select(spec.ValueKind, RelicAmounts.Values, v => onChange(spec with { ValueKind = v }));
            if (spec.ValueKind is "resource" or "counter")
            {
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "value", spec.Id);
                builder.AddAttribute(seq++, "style", "width:6rem");
                builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(spec with { Id = AsString(e.Value) })));
                builder.CloseElement();
            }
        }
        else
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "value", spec.Const);
            builder.AddAttribute(seq++, "style", "width:4rem");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(spec with { Const = AsInt(e.Value, spec.Const) })));
            builder.CloseElement();
        }
    };

    // Shared condition control: a kind select (value-compare / victory / defeat / flag, plus "always" when
    // allowNone) and the operands for the chosen kind. Emits the edited spec through `onChange`. Used by both the
    // reaction-level "if" and the Conditional effect so conditions author identically. A Conditional passes
    // allowNone:false because it needs a real branch (an always-true guard would defeat the point).
    private RenderFragment ConditionEditor(RelicConditionSpec spec, Action<RelicConditionSpec> onChange, bool allowNone) => builder =>
    {
        var seq = 0;

        void Select(string current, IEnumerable<(string Key, string Label)> options, Action<string> change)
        {
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "value", current);
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => change(AsString(e.Value))));
            foreach (var (key, label) in options)
            {
                builder.OpenElement(seq++, "option");
                builder.AddAttribute(seq++, "value", key);
                builder.AddContent(seq++, label);
                builder.CloseElement();
            }
            builder.CloseElement();
        }

        void TextInput(string value, int width, string placeholder, Action<string> onInput)
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "value", value);
            builder.AddAttribute(seq++, "placeholder", placeholder);
            builder.AddAttribute(seq++, "style", $"width:{width}rem");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onInput(AsString(e.Value))));
            builder.CloseElement();
        }

        var kinds = allowNone ? ConditionKinds : ConditionKinds.Where(k => k.Kind != "none");
        Select(spec.Kind, kinds, kind => onChange(spec with { Kind = kind }));

        if (spec.Kind == "flag")
        {
            TextInput(spec.Id, 7, "flag id", id => onChange(spec with { Id = id }));
        }
        else if (spec.Kind == "compare")
        {
            Select(spec.ValueKind, CompareValues, v => onChange(spec with { ValueKind = v }));
            Select(spec.Op.ToString(), Operators.Select(op => (op.ToString(), OpSymbol(op))),
                op => onChange(spec with { Op = ParseOp(op) }));
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "value", spec.Right);
            builder.AddAttribute(seq++, "style", "width:4rem");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(spec with { Right = AsInt(e.Value, spec.Right) })));
            builder.CloseElement();
            if (spec.ValueKind is "resource" or "counter")
                TextInput(spec.Id, 6, "id", id => onChange(spec with { Id = id }));
        }
    };

    // Inline editor for one control-flow BODY effect (an IRunEffectRequest, resolved later): the amount/state
    // leaf palette. Computed amounts fold into the Computed* effects via RelicRequests. `set` replaces this body
    // effect and rebuilds the enclosing Repeat/Conditional.
    private RenderFragment RequestEditor(IRunEffectRequest request, Action<IRunEffectRequest> set) => builder =>
    {
        var seq = 0;

        void Label(string text) => builder.AddContent(seq++, text + " ");

        void TextInput(string value, int width, Action<string> onChange)
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "value", value);
            builder.AddAttribute(seq++, "style", $"width:{width}rem");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(AsString(e.Value))));
            builder.CloseElement();
        }

        void NumberInput(int value, Action<int> onChange)
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "value", value);
            builder.AddAttribute(seq++, "style", "width:4rem");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(AsInt(e.Value, value))));
            builder.CloseElement();
        }

        void Select(string current, IEnumerable<(string Key, string Label)> options, Action<string> onChange)
        {
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "value", current);
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(AsString(e.Value))));
            foreach (var (key, label) in options)
            {
                builder.OpenElement(seq++, "option");
                builder.AddAttribute(seq++, "value", key);
                builder.AddContent(seq++, label);
                builder.CloseElement();
            }
            builder.CloseElement();
        }

        void Amount() => builder.AddContent(seq++, AmountEditor(RelicRequests.AmountOf(request),
            spec => set(RelicRequests.WithAmount(request, spec))));

        if (RelicRequests.ResourceOf(request) is { } resource)
        {
            if (resource == StandardRunIds.Gold)
            {
                Label("Gold");
            }
            else
            {
                Label("Resource");
                TextInput(resource.Value, 6, s => set(RelicRequests.WithResource(request, new RunResourceId(s))));
            }
            Amount();
            return;
        }

        switch (request)
        {
            case HealRunEffect or ComputedHealRunEffect:
                Label("Heal");
                Amount();
                break;
            case ApplyRunDamageRunEffect or ComputedDamageRunEffect:
                Label("Lose HP");
                Amount();
                break;
            case ChangeMaxHealthRunEffect m:
                Label("Max HP Δ");
                NumberInput(m.Delta, n => set(new ChangeMaxHealthRunEffect(n)));
                break;
            case SetFlagRunEffect f:
                Label("Set flag");
                TextInput(f.Flag.Value, 7, s => set(new SetFlagRunEffect(new RunFlagId(s), f.Value)));
                break;
            case IncrementCounterRunEffect c:
                Label("Counter");
                TextInput(c.Counter.Value, 6, s => set(new IncrementCounterRunEffect(new RunCounterId(s), c.Delta)));
                Label(" by");
                NumberInput(c.Delta, n => set(new IncrementCounterRunEffect(c.Counter, n)));
                break;
            case SetCounterRunEffect sc:
                Label("Set counter");
                TextInput(sc.Counter.Value, 6, s => set(new SetCounterRunEffect(new RunCounterId(s), sc.Value)));
                Label(" =");
                NumberInput(sc.Value, n => set(new SetCounterRunEffect(sc.Counter, n)));
                break;
            case AddCardToDeckRunEffect ac:
                Label("Add card");
                Select(ac.Card.value, CardOptions(), s => set(new AddCardToDeckRunEffect(new CardDefinitionId(s))));
                break;
            case RemoveCardsRunEffect:
                Label("Remove a card (player picks)");
                break;
            case AddRelicByIdRunEffect ar:
                Label("Add relic");
                Select(ar.Relic.Value, RelicOptions(), s => set(new AddRelicByIdRunEffect(new RelicId(s))));
                break;
            case RemoveRelicRunEffect rr:
                Label("Remove relic");
                Select(rr.Relic.Value, RelicOptions(), s => set(new RemoveRelicRunEffect(new RelicId(s))));
                break;
            case DisableRelicRunEffect dr:
                Label("Disable relic");
                Select(dr.Relic.Value, RelicOptions(), s => set(new DisableRelicRunEffect(new RelicId(s), dr.Combats)));
                Label(" for");
                NumberInput(dr.Combats, n => set(new DisableRelicRunEffect(dr.Relic, n)));
                Label("combats");
                break;
            case EnableRelicRunEffect er:
                Label("Enable relic");
                Select(er.Relic.Value, RelicOptions(), s => set(new EnableRelicRunEffect(new RelicId(s))));
                break;
            case AddConsumableRunEffect cn when cn.UseEffects.Count == 1 && cn.UseEffects[0] is HealRunEffect cnHeal:
                Label("Consumable");
                TextInput(cn.Definition.Value, 6, s => set(new AddConsumableRunEffect(new ConsumableId(s), cn.UseEffects)));
                Label(" heals");
                NumberInput(cnHeal.Amount, n => set(new AddConsumableRunEffect(cn.Definition, new IRunEffectRequest[] { new HealRunEffect(n) })));
                break;
            default:
                builder.AddContent(seq++, request.GetType().Name);
                break;
        }
    };

}
