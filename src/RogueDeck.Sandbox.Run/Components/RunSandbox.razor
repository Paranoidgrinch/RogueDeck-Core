@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ProjectDraft Draft

<h1>RogueDeck Run Sandbox</h1>
<p class="muted">
    Assemble and drive the whole run. Its content — the hero, cards &amp; deck, enemies, encounters, relics and
    events — is authored in the dedicated tabs; they all edit the one shared <strong>RunBlueprint</strong> shown
    below. Here you arrange the <strong>map</strong> from that content, then press <strong>Load &amp; drive</strong>
    to play through it (click a choice at each event; fights auto-resolve, or tick the box to play them yourself),
    or <strong>Simulate</strong> to balance it over many seeds. The JSON is the whole document — edit it directly
    for anything the tabs don't cover.
</p>

<div class="grid">
    <section class="panel">
        <h2>Run blueprint (JSON)</h2>
        <textarea @bind="_json" rows="22" style="width:100%;font-family:monospace;font-size:12px"></textarea>
        <div class="run-bar">
            <label>Seed <input type="number" @bind="_seed" style="width:6rem" /></label>
            <button class="play" @onclick="Start">Load &amp; drive</button>
            <button class="play" @onclick="Download">Download</button>
            <label class="play">Upload<InputFile OnChange="Upload" style="display:none" /></label>
        </div>
        <div class="run-bar">
            <label title="on: play each fight yourself (cards + end turn); off: fights auto-resolve headlessly">
                <input type="checkbox" @bind="_interactiveCombat" /> play combats interactively
            </label>
        </div>
        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }

        <h2>Map</h2>
        @if (TryBlueprint(out var bp))
        {
            var pos = MapGraphLayout.Resolve(bp.Map);
            var (svgW, svgH) = MapGraphLayout.CanvasSize(pos);
            <div class="run-bar">
                <button class="mini" @onclick="AutoLayout" title="place every node by graph depth">Auto-layout</button>
                <span class="muted">A branching map, drawn from its edges. Set each node's x/y below (or auto-layout),
                    green outline = entry, pink = combat, blue = event.</span>
            </div>
            <div style="overflow:auto;border:1px solid #ccc;max-height:440px;background:#fafafa">
                <svg width="@svgW" height="@svgH" viewBox="0 0 @svgW @svgH" xmlns="http://www.w3.org/2000/svg"
                     style="font:11px sans-serif">
                    <defs>
                        <marker id="arrow" markerWidth="9" markerHeight="9" refX="7" refY="3" orient="auto"
                                markerUnits="strokeWidth">
                            <path d="M0,0 L7,3 L0,6 Z" fill="#888" />
                        </marker>
                    </defs>
                    @foreach (var edge in bp.Map.Edges)
                    {
                        @if (pos.TryGetValue(edge.From, out var a) && pos.TryGetValue(edge.To, out var b))
                        {
                            <line x1="@(a.X + MapGraphLayout.NodeWidth / 2)" y1="@(a.Y + MapGraphLayout.NodeHeight / 2)"
                                  x2="@(b.X + MapGraphLayout.NodeWidth / 2)" y2="@(b.Y + MapGraphLayout.NodeHeight / 2)"
                                  stroke="#888" stroke-width="1.5" marker-end="url(#arrow)" />
                        }
                    }
                    @foreach (var mapNode in bp.Map.Nodes)
                    {
                        var p = pos[mapNode.Id];
                        var isEntry = bp.Map.EntryNodeIds.Contains(mapNode.Id);
                        <g>
                            <rect x="@p.X" y="@p.Y" width="@MapGraphLayout.NodeWidth" height="@MapGraphLayout.NodeHeight"
                                  rx="6" fill="@(mapNode.Type == StandardRunIds.CombatNode ? "#fde2e2" : "#e2ecfd")"
                                  stroke="@(isEntry ? "#1a7f37" : "#999")" stroke-width="@(isEntry ? "2.5" : "1")" />
                            <text x="@(p.X + 8)" y="@(p.Y + 18)" font-weight="bold">@mapNode.Id.Value</text>
                            <text x="@(p.X + 8)" y="@(p.Y + 34)" fill="#555">@NodeKind(mapNode): @NodeTarget(mapNode)</text>
                        </g>
                    }
                </svg>
            </div>
            <ol class="log">
                @for (var i = 0; i < bp.Map.Nodes.Count; i++)
                {
                    var index = i;
                    var node = bp.Map.Nodes[i];
                    <li>
                        <label title="entry node — a graph walk may start here (ignored by a linear map)">
                            <input type="checkbox" checked="@bp.Map.EntryNodeIds.Contains(node.Id)"
                                   @onchange="() => ToggleEntry(node.Id)" />
                        </label>
                        <code>@node.Id.Value</code>
                        <span class="line-kind">@NodeKind(node)</span> <strong>@NodeTarget(node)</strong>
                        <label title="x">x<input type="number" value="@pos[node.Id].X" style="width:4.5rem"
                                                  @onchange="e => SetCoordX(node.Id, e)" /></label>
                        <label title="y">y<input type="number" value="@pos[node.Id].Y" style="width:4.5rem"
                                                  @onchange="e => SetCoordY(node.Id, e)" /></label>
                        <button class="mini" @onclick="() => MoveNode(index, -1)">↑</button>
                        <button class="mini" @onclick="() => MoveNode(index, 1)">↓</button>
                        <button class="mini" @onclick="() => RemoveNode(index)">✕</button>
                    </li>
                }
            </ol>
            <div class="run-bar">
                <select @bind="_newNodeType">
                    <option value="event">event</option>
                    <option value="combat">combat</option>
                </select>
                <select @bind="_newNodeTarget">
                    <option value="">— target —</option>
                    @if (_newNodeType == "combat")
                    {
                        @foreach (var encounter in bp.Encounters)
                        {
                            <option value="@encounter.Id.Value">@encounter.Id.Value</option>
                        }
                    }
                    else
                    {
                        @foreach (var key in bp.Events.Keys)
                        {
                            <option value="@key">@key</option>
                        }
                    }
                </select>
                <button class="play" @onclick="AddNode">Add node</button>
            </div>

            <h3>Edges (branching)</h3>
            <p class="muted">Add edges to turn the linear list into a branching graph: after a node resolves, the
                player picks among its outgoing edges (tick a node above to make it an entry). No edges ⇒ the map
                is walked top-to-bottom as a linear sequence, exactly as before.</p>
            @if (bp.Map.Edges.Count == 0)
            {
                <p class="muted">No edges — linear map.</p>
            }
            else
            {
                <ol class="log">
                    @foreach (var edge in bp.Map.Edges)
                    {
                        var e = edge;
                        <li><code>@e.From.Value</code> → <code>@e.To.Value</code>
                            <button class="mini" @onclick="() => RemoveEdge(e)">✕</button>
                        </li>
                    }
                </ol>
            }
            <div class="run-bar">
                <select @bind="_edgeFrom">
                    <option value="">— from —</option>
                    @foreach (var n in bp.Map.Nodes)
                    {
                        <option value="@n.Id.Value">@n.Id.Value</option>
                    }
                </select>
                <span>→</span>
                <select @bind="_edgeTo">
                    <option value="">— to —</option>
                    @foreach (var n in bp.Map.Nodes)
                    {
                        <option value="@n.Id.Value">@n.Id.Value</option>
                    }
                </select>
                <button class="play" @onclick="AddEdge">Add edge</button>
            </div>
        }
        else
        {
            <p class="muted">Fix the JSON to edit the map visually.</p>
        }

        <h2>Validation</h2>
        @if (TryBlueprint(out var validateBp))
        {
            var problems = RunDocumentValidator.Validate(validateBp);
            @if (problems.Count == 0)
            {
                <p class="muted">✓ The document is internally consistent (deck, actions, and map all resolve).</p>
            }
            else
            {
                <ul class="log">
                    @foreach (var problem in problems)
                    {
                        <li><span class="line-kind">⚠</span> @problem</li>
                    }
                </ul>
            }
        }
        else
        {
            <p class="error">The run JSON does not parse — fix it to validate the document.</p>
        }

        <h2>Headless balancing</h2>
        <p class="muted">Auto-play the blueprint over many seeds (choices auto-pick the first option) and tally outcomes.</p>
        <div class="run-bar">
            <label>Runs <input type="number" @bind="_simRuns" style="width:6rem" /></label>
            <button class="play" @onclick="Simulate">Simulate</button>
        </div>
        @if (_simSummary is not null)
        {
            <p class="muted">@_simSummary</p>
        }
    </section>

    @if (TryBlueprint(out var editorBlueprint))
    {
        @* The same inventory lens as run-play, but over the AUTHORED starting state: only the deck is carried in
           from the start — relics/resources/consumables begin empty and are granted by events during the run. *@
        <section class="panel">
            <h2>Starting inventory</h2>
            <div class="row"><span class="muted">Deck (@editorBlueprint.Deck.Count)</span>
                @(editorBlueprint.Deck.Count == 0 ? "empty" : string.Join(", ",
                    editorBlueprint.Deck.GroupBy(c => BlueprintCardName(editorBlueprint, c.value)).Select(Tally)))
            </div>
            <p class="muted">Relics, resources, and consumables start empty — the hero gains them from events
                during the run.</p>
        </section>
    }

    <RunSessionView Session="_play.Session" CombatDriver="_play.CombatDriver" CardCosts="_play.CardCosts"
                    CardNames="_play.CardNames" EnemyNames="_play.EnemyNames" HeroName="_play.HeroName"
                    UseConsumableInCombat="@(id => _play.UseConsumableInCombat(id))" />
</div>

@code {
    private static readonly EncounterId GoblinFight = new("goblin-fight");

    private readonly JsonSerializerOptions _options = RunJson.CreateOptions();
    // The run document lives in the circuit-scoped ProjectDraft so switching tabs keeps it (see ProjectDraft).
    private string _json { get => Draft.RunJson ?? ""; set => Draft.RunJson = value; }
    private int _seed = 1;
    private RunPlayback _play = default!;
    private string? _error;
    private int _simRuns = 50;
    private string? _simSummary;
    private IJSObjectReference? _jsModule;
    private string _newNodeType = "event";
    private string _newNodeTarget = "";
    private int _nodeSeq = 100;
    private bool _interactiveCombat = true;

    // ── Visual map builder (edits the parsed blueprint, then writes it back to the JSON) ──
    private bool TryBlueprint(out RunBlueprint blueprint)
    {
        try { blueprint = RunJson.FromJson<RunBlueprint>(_json, _options); return true; }
        catch { blueprint = null!; return false; }
    }

    private string _edgeFrom = "";
    private string _edgeTo = "";

    private void RebuildMap(RunBlueprint blueprint, RunMap map) =>
        _json = RunJson.ToJson(blueprint with { Map = map }, _options);

    private void AddNode()
    {
        if (string.IsNullOrEmpty(_newNodeTarget) || !TryBlueprint(out var blueprint))
            return;
        var (type, payload) = _newNodeType == "combat"
            ? (StandardRunIds.CombatNode, (IRunNodePayload)new EncounterRef(new EncounterId(_newNodeTarget)))
            : (StandardRunIds.EventNode, new EventRef(new EventId(_newNodeTarget)));
        var node = new Node(new NodeId($"n{_nodeSeq++}"), type, payload);
        RebuildMap(blueprint, RunMapAuthoring.AddNode(blueprint.Map, node));
    }

    private void RemoveNode(int index)
    {
        if (!TryBlueprint(out var blueprint))
            return;
        RebuildMap(blueprint, RunMapAuthoring.RemoveNode(blueprint.Map, index));
    }

    private void MoveNode(int index, int direction)
    {
        if (!TryBlueprint(out var blueprint))
            return;
        RebuildMap(blueprint, RunMapAuthoring.MoveNode(blueprint.Map, index, direction));
    }

    private void AddEdge()
    {
        if (string.IsNullOrEmpty(_edgeFrom) || string.IsNullOrEmpty(_edgeTo) || !TryBlueprint(out var blueprint))
            return;
        RebuildMap(blueprint, RunMapAuthoring.AddEdge(blueprint.Map, new NodeId(_edgeFrom), new NodeId(_edgeTo)));
    }

    private void RemoveEdge(MapEdge edge)
    {
        if (!TryBlueprint(out var blueprint))
            return;
        RebuildMap(blueprint, RunMapAuthoring.RemoveEdge(blueprint.Map, edge));
    }

    private void ToggleEntry(NodeId id)
    {
        if (!TryBlueprint(out var blueprint))
            return;
        RebuildMap(blueprint, RunMapAuthoring.ToggleEntry(blueprint.Map, id));
    }

    // Materialize the auto (depth-based) layout as authored coords for every node, so the graph is laid out and the
    // author can then nudge individual nodes. Resolves on a layout-cleared copy so it fully re-lays-out.
    private void AutoLayout()
    {
        if (!TryBlueprint(out var blueprint))
            return;
        var map = blueprint.Map;
        var cleared = new RunMap(map.Nodes) { Edges = map.Edges, EntryNodeIds = map.EntryNodeIds };
        var pos = MapGraphLayout.Resolve(cleared);
        foreach (var node in map.Nodes)
            map = RunMapAuthoring.SetNodeLayout(map, node.Id, pos[node.Id].X, pos[node.Id].Y);
        RebuildMap(blueprint, map);
    }

    private void SetCoordX(NodeId id, ChangeEventArgs e) => SetCoord(id, ParseInt(e), null);
    private void SetCoordY(NodeId id, ChangeEventArgs e) => SetCoord(id, null, ParseInt(e));

    private void SetCoord(NodeId id, int? x, int? y)
    {
        if ((x is null && y is null) || !TryBlueprint(out var blueprint))
            return;
        var current = MapGraphLayout.Resolve(blueprint.Map).GetValueOrDefault(id);
        RebuildMap(blueprint, RunMapAuthoring.SetNodeLayout(blueprint.Map, id, x ?? current.X, y ?? current.Y));
    }

    private static int? ParseInt(ChangeEventArgs e) =>
        int.TryParse(e.Value?.ToString(), out var value) ? value : null;

    private static string NodeKind(Node node) => node.Type == StandardRunIds.CombatNode ? "combat" : "event";

    private static string NodeTarget(Node node) => node.Payload switch
    {
        EventRef e => e.Id.Value,
        EncounterRef en => en.Id.Value,
        _ => "?",
    };

    protected override void OnInitialized()
    {
        _play = new RunPlayback(OnSessionChanged);
        Draft.RunJson ??= RunJson.ToJson(DemoBlueprint(), _options);
    }

    // Save the current blueprint JSON as a file (via a small JS download helper).
    private async Task Download()
    {
        _jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./runSandbox.js");
        await _jsModule.InvokeVoidAsync("download", "run-blueprint.json", _json);
    }

    // Load a blueprint JSON from an uploaded file into the editor.
    private async Task Upload(InputFileChangeEventArgs e)
    {
        using var reader = new StreamReader(e.File.OpenReadStream(5 * 1024 * 1024));
        _json = await reader.ReadToEndAsync();
        _error = null;
    }

    private void Start()
    {
        if (!TryBlueprint(out var blueprint))
        {
            _error = "Fix the run JSON before driving.";
            return;
        }
        _play.Start(blueprint, _seed, _interactiveCombat);
        _error = _play.Error;
    }

    // Headless balancing: auto-play the blueprint over many seeds and summarise outcomes.
    private void Simulate()
    {
        _simSummary = null;
        try
        {
            var blueprint = RunJson.FromJson<RunBlueprint>(_json, _options);
            var content = RunPlayback.BuildContent(blueprint);
            var defs = new RunDefinitionRegistryBuilder();
            new StandardRunPackage(new AutoPlayCombatDriver(), content).RegisterDefinitions(defs);
            var registry = defs.Build();

            var runs = Math.Clamp(_simRuns, 1, 1000);
            var wins = 0;
            long totalHp = 0;
            long totalGold = 0;
            for (var seed = 1; seed <= runs; seed++)
            {
                var run = blueprint.CreateInitialRun(new RunId($"sim{seed}"), seed);
                new RunRunner(registry, new ScriptedChoiceProvider(), content: content).Run(run);
                if (run.Result == RunResult.Victory)
                    wins++;
                totalHp += run.Health.Current;
                totalGold += run.GetResource(StandardRunIds.Gold);
            }

            _simSummary = $"{runs} runs — {100.0 * wins / runs:0.#}% victory, " +
                $"avg HP {(double)totalHp / runs:0.#}, avg gold {(double)totalGold / runs:0.#}";
        }
        catch (Exception ex)
        {
            _simSummary = $"Error: {ex.GetType().Name}: {ex.Message}";
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    // Editor-side display name for a starting-deck card id, read from the authored card definitions.
    private static string BlueprintCardName(RunBlueprint blueprint, string definitionId) =>
        blueprint.Cards.FirstOrDefault(c => c.Id == definitionId)?.NameKey ?? definitionId;

    // "Strike ×3" for a group of copies, or just "Strike" for a single one.
    private static string Tally<T>(IGrouping<string, T> group) =>
        group.Count() > 1 ? $"{group.Key} ×{group.Count()}" : group.Key;

    public async ValueTask DisposeAsync()
    {
        _play.Dispose();
        if (_jsModule is not null)
        {
            try { await _jsModule.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit already gone */ }
        }
    }

    private static RunBlueprint DemoBlueprint()
    {
        var shrine = new EventScriptBuilder("shrine")
            .Situation("shrine", "An ancient shrine hums with power.", s => s
                .Choice("heal", c => c.TextKey("Pray for healing (+8 HP)").Heal(8))
                .Choice("gold", c => c.TextKey("Pry loose the offerings (+20 gold)").GainResource(StandardRunIds.Gold, 20))
                .Choice("leave", c => c.TextKey("Leave it be")))
            .Build();

        var purge = new EventScriptBuilder("purge")
            .Situation("purge", "A purifying flame offers to burn one card away.", s => s
                .Choice("purge", c => c
                    .TextKey("Burn a card (choose one)")
                    .RemoveCards(RunSelectors.DeckCards.ChooseByPlayer(1, "Choose a card to remove")))
                .Choice("keep", c => c.TextKey("Keep your deck intact")))
            .Build();

        var encounter = new EncounterDefinition(
            GoblinFight,
            enemies: new[] { new EncounterEnemy("goblin", 12, new[] { new EnemyActionDefinitionId("slam") }, null, "Goblin") },
            heroResources: new[] { new ResourceSpec(StandardCombatIds.EnergyResource, 3, 3) },
            heroDisplayName: "Hero");

        var map = new RunMap(new Node[]
        {
            new(new NodeId("shrine"), StandardRunIds.EventNode, new EventRef(new EventId("shrine"))),
            new(new NodeId("purge"), StandardRunIds.EventNode, new EventRef(new EventId("purge"))),
            new(new NodeId("fight"), StandardRunIds.CombatNode, new EncounterRef(GoblinFight)),
        });

        var smite = new CardBlueprint("smite")
        {
            NameKey = "Smite",
            Program = Effects.Program(Effects.DealDamage(Targets.EventTarget, 6)),
        };
        var slam = new EnemyActionBlueprint("slam", new ActionIntent("Slam", IntentKind.Attack))
        {
            Program = new EffectProgram<EnemyActionContext>(new DealDamageNode<EnemyActionContext>(
                CombatantTargetSelectors.EventTarget, new ConstantExpression<EnemyActionContext>(4))),
        };

        var windfall = new RelicData
        {
            Id = "windfall",
            DisplayName = "Windfall",
            RunPrograms = new[] { RunPrograms.On<NodeEnteredRunEvent>(new ChangeResourceRunEffect(StandardRunIds.Gold, 5)) },
        };

        return new RunBlueprint(
            Enumerable.Repeat(new CardDefinitionId("smite"), 5).ToList(),
            new Dictionary<string, EventScript> { ["shrine"] = shrine, ["purge"] = purge },
            new[] { encounter },
            new[] { CardData.From(smite) },
            new[] { EnemyActionData.From(slam) },
            map)
        { Relics = new[] { windfall } };
    }
}
