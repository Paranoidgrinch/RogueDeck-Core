@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject RunDraft Draft
@inject CombatDraft CombatDraft

<h1>RogueDeck Run Sandbox</h1>
<p class="muted">
    A whole run authored as <strong>data</strong>: the starting deck, the events, and the map are a JSON
    RunBlueprint you can edit below. The combat content (cards, the goblin encounter) and relics are provided by
    code and referenced by id. Press <strong>Load &amp; drive</strong>, then click a choice at each event to
    step through it; fights are played headlessly by the auto-play driver.
</p>

<div class="grid">
    <section class="panel">
        <h2>Run blueprint (JSON)</h2>
        <textarea @bind="_json" rows="22" style="width:100%;font-family:monospace;font-size:12px"></textarea>
        <div class="run-bar">
            <label>Seed <input type="number" @bind="_seed" style="width:6rem" /></label>
            <button class="play" @onclick="Start">Load &amp; drive</button>
            <button class="play" @onclick="Download">Download</button>
            <label class="play">Upload<InputFile OnChange="Upload" style="display:none" /></label>
        </div>
        <div class="run-bar">
            <button class="play" @onclick="ImportFromCombat" title="Bring the hero, deck, cards and enemies authored in the Combat tab into this run">
                ⇐ Import from Combat tab
            </button>
        </div>
        @if (_importMsg is not null)
        {
            <p class="muted">@_importMsg</p>
        }
        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }

        <h2>Map</h2>
        @if (TryBlueprint(out var bp))
        {
            <ol class="log">
                @for (var i = 0; i < bp.Map.Nodes.Count; i++)
                {
                    var index = i;
                    var node = bp.Map.Nodes[i];
                    <li>
                        <span class="line-kind">@NodeKind(node)</span> <strong>@NodeTarget(node)</strong>
                        <button class="mini" @onclick="() => MoveNode(index, -1)">↑</button>
                        <button class="mini" @onclick="() => MoveNode(index, 1)">↓</button>
                        <button class="mini" @onclick="() => RemoveNode(index)">✕</button>
                    </li>
                }
            </ol>
            <div class="run-bar">
                <select @bind="_newNodeType">
                    <option value="event">event</option>
                    <option value="combat">combat</option>
                </select>
                <select @bind="_newNodeTarget">
                    <option value="">— target —</option>
                    @if (_newNodeType == "combat")
                    {
                        @foreach (var encounter in bp.Encounters)
                        {
                            <option value="@encounter.Id.Value">@encounter.Id.Value</option>
                        }
                    }
                    else
                    {
                        @foreach (var key in bp.Events.Keys)
                        {
                            <option value="@key">@key</option>
                        }
                    }
                </select>
                <button class="play" @onclick="AddNode">Add node</button>
            </div>
        }
        else
        {
            <p class="muted">Fix the JSON to edit the map visually.</p>
        }

        <h2>Headless balancing</h2>
        <p class="muted">Auto-play the blueprint over many seeds (choices auto-pick the first option) and tally outcomes.</p>
        <div class="run-bar">
            <label>Runs <input type="number" @bind="_simRuns" style="width:6rem" /></label>
            <button class="play" @onclick="Simulate">Simulate</button>
        </div>
        @if (_simSummary is not null)
        {
            <p class="muted">@_simSummary</p>
        }
    </section>

    @if (TryBlueprint(out var editorBlueprint))
    {
        <EncounterEditor Blueprint="editorBlueprint" BlueprintChanged="ApplyBlueprint" />
        <EventEditor Blueprint="editorBlueprint" BlueprintChanged="ApplyBlueprint" />
    }

    @if (_session is { } session)
    {
        <section class="panel">
            @if (session.Error is { } runError)
            {
                <p class="error">@runError</p>
            }
            else if (session.IsAwaitingChoice && session.PendingSituation is { } situation)
            {
                <h2>@situation.TextKey</h2>
                <div class="choices">
                    @foreach (var choice in session.PendingChoices)
                    {
                        <button class="play" @onclick="() => session.Pick(choice.Id)">
                            @(string.IsNullOrEmpty(choice.TextKey) ? choice.Id : choice.TextKey)
                        </button>
                    }
                </div>
            }
            else if (session.IsAwaitingEntities && session.PendingEntities is { } request)
            {
                <h2>@request.Purpose</h2>
                <p class="muted">Pick @request.Count.</p>
                <div class="choices">
                    @for (var i = 0; i < request.Displays.Count; i++)
                    {
                        var index = i;
                        <button class="play @(_selected.Contains(index) ? "active" : "")"
                                @onclick="() => ToggleEntity(index)">
                            @request.Displays[index]
                        </button>
                    }
                </div>
                <button class="play" disabled="@(_selected.Count != request.Count)" @onclick="ConfirmEntities">
                    Confirm (@_selected.Count/@request.Count)
                </button>
            }
            else if (session.IsComplete)
            {
                <h2>Run complete</h2>
                <div class="row"><span class="muted">Outcome</span> <strong>@session.Run.Result</strong></div>
            }
            else
            {
                <p class="muted">Resolving…</p>
            }

            <h2>State</h2>
            <div class="row"><span class="muted">HP</span> @session.Run.Health.Current / @session.Run.Health.Max</div>
            <div class="row"><span class="muted">Gold</span> @session.Run.GetResource(StandardRunIds.Gold)</div>
            <div class="row"><span class="muted">Deck</span> @session.Run.Deck.Count</div>
            <div class="row"><span class="muted">Relics</span>
                @(session.Run.Relics.Count == 0 ? "none" : string.Join(", ", session.Run.Relics.Select(r => r.Id)))
            </div>
            @if (session.Run.Flags.Count > 0)
            {
                <div class="row"><span class="muted">Flags</span> @string.Join(", ", session.Run.Flags)</div>
            }
            @foreach (var counter in session.Run.Counters)
            {
                <div class="row"><span class="muted">@counter.Key</span> @counter.Value</div>
            }
        </section>

        <section class="panel">
            <h2>Run log</h2>
            <ul class="log">
                @foreach (var entry in session.Run.Log)
                {
                    <li><span class="line-kind">@entry.Type</span> @entry.Message</li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private static readonly EncounterId GoblinFight = new("goblin-fight");

    private readonly JsonSerializerOptions _options = RunJson.CreateOptions();
    // The run document lives in the circuit-scoped RunDraft so switching tabs keeps it (see RunDraft).
    private string _json { get => Draft.Json ?? ""; set => Draft.Json = value; }
    private int _seed = 1;
    private InteractiveRunSession? _session;
    private string? _error;
    private string? _importMsg;
    private readonly HashSet<int> _selected = new();
    private int _simRuns = 50;
    private string? _simSummary;
    private IJSObjectReference? _jsModule;
    private string _newNodeType = "event";
    private string _newNodeTarget = "";
    private int _nodeSeq = 100;

    // ── Visual map builder (edits the parsed blueprint, then writes it back to the JSON) ──
    private bool TryBlueprint(out RunBlueprint blueprint)
    {
        try { blueprint = RunJson.FromJson<RunBlueprint>(_json, _options); return true; }
        catch { blueprint = null!; return false; }
    }

    private void RebuildMap(RunBlueprint blueprint, List<Node> nodes) =>
        _json = RunJson.ToJson(blueprint with { Map = new RunMap(nodes) }, _options);

    private void AddNode()
    {
        if (string.IsNullOrEmpty(_newNodeTarget) || !TryBlueprint(out var blueprint))
            return;
        var nodes = blueprint.Map.Nodes.ToList();
        var (type, payload) = _newNodeType == "combat"
            ? (StandardRunIds.CombatNode, (IRunNodePayload)new EncounterRef(new EncounterId(_newNodeTarget)))
            : (StandardRunIds.EventNode, new EventRef(new EventId(_newNodeTarget)));
        nodes.Add(new Node(new NodeId($"n{_nodeSeq++}"), type, payload));
        RebuildMap(blueprint, nodes);
    }

    private void RemoveNode(int index)
    {
        if (!TryBlueprint(out var blueprint))
            return;
        var nodes = blueprint.Map.Nodes.ToList();
        if (index < 0 || index >= nodes.Count)
            return;
        nodes.RemoveAt(index);
        RebuildMap(blueprint, nodes);
    }

    private void MoveNode(int index, int direction)
    {
        if (!TryBlueprint(out var blueprint))
            return;
        var nodes = blueprint.Map.Nodes.ToList();
        var target = index + direction;
        if (index < 0 || index >= nodes.Count || target < 0 || target >= nodes.Count)
            return;
        (nodes[index], nodes[target]) = (nodes[target], nodes[index]);
        RebuildMap(blueprint, nodes);
    }

    // Applied by the encounter/event editors: they hand back a mutated blueprint; we write it to the JSON (the
    // single source of truth), which re-renders every visual editor from the new parse.
    private void ApplyBlueprint(RunBlueprint blueprint) => _json = RunJson.ToJson(blueprint, _options);

    // Bring the hero, deck, cards and enemies authored in the Combat tab into this run. Reuses the sandbox's own
    // ScenarioComposer so imported cards/actions behave identically to how they play in the Combat tab. The whole
    // combat (its enemy roster + hero resources) lands as an encounter you can drop onto the map; its cards go
    // into the run's card pool and starting deck. Custom status definitions do not carry over — the run blueprint
    // has no status library — so encounters using them should stick to the built-in statuses.
    private void ImportFromCombat()
    {
        _importMsg = null;
        _error = null;
        var model = CombatDraft.Model;
        if (model is null || model.Hero is null || model.Enemies.Count == 0)
        {
            _importMsg = "Define a hero and at least one enemy in the Combat tab first.";
            return;
        }
        if (!TryBlueprint(out var current))
        {
            _importMsg = "Fix the run JSON before importing.";
            return;
        }

        try
        {
            var composed = ScenarioComposer.ComposeBlueprint(model);
            var hero = composed.Hero!; // ComposeBlueprint always sets the hero (it throws otherwise).

            // Some advanced combat effects are escape nodes with no serializable data form (e.g. temporary
            // rules); such cards/actions can't live in a RunBlueprint. Keep only what the run JSON can round-trip
            // and report the rest, so a valid document is always produced instead of the whole import failing.
            bool CanSerialize<T>(T value)
            {
                try { RunJson.ToJson(value, _options); return true; }
                catch (NotSupportedException) { return false; }
            }

            // Merge cards and enemy actions by id (imported definitions win over same-id existing ones).
            var cards = current.Cards.ToDictionary(c => c.Id, c => c);
            var skipped = new List<string>();
            foreach (var card in composed.Cards)
            {
                var data = CardData.From(card);
                if (CanSerialize(data)) cards[data.Id] = data;
                else skipped.Add($"card '{data.Id}'");
            }
            var actions = current.EnemyActions.ToDictionary(a => a.Id, a => a);
            foreach (var action in composed.EnemyActions)
            {
                var data = EnemyActionData.From(action);
                if (CanSerialize(data)) actions[data.Id] = data;
                else skipped.Add($"action '{data.Id}'");
            }

            // The whole fight becomes one encounter: the enemy roster + the hero's combat resources / statuses.
            // Enemies only keep the actions that survived (a dropped action would dangle); deck likewise.
            var enemies = composed.Enemies.Select(e => new EncounterEnemy(
                e.Id, e.MaxHealth,
                e.Actions.Where(a => actions.ContainsKey(a.value)).ToList(),
                e.StartingStatuses.Count > 0 ? e.StartingStatuses.ToList() : null)).ToList();
            var encounterId = new EncounterId("combat-fight");
            var encounter = new EncounterDefinition(encounterId, enemies, hero.Resources.ToList(),
                hero.StartingStatuses.Count > 0 ? hero.StartingStatuses.ToList() : null);
            var encounters = current.Encounters.Where(e => e.Id != encounterId).Append(encounter).ToList();

            // The hero's deck (expanded by copies, only cards that survived) becomes the run's starting deck.
            var deck = hero.Deck
                .SelectMany(entry => Enumerable.Repeat(entry.Card, Math.Max(1, entry.Count)))
                .Where(c => cards.ContainsKey(c.value))
                .ToList();

            var merged = current with
            {
                Cards = cards.Values.ToList(),
                EnemyActions = actions.Values.ToList(),
                Encounters = encounters,
                Deck = deck.Count > 0 ? deck : current.Deck,
            };
            _json = RunJson.ToJson(merged, _options);
            _importMsg = $"Imported hero '{hero.Id}', {composed.Cards.Count - skipped.Count(s => s.StartsWith("card"))} card(s), " +
                $"{composed.EnemyActions.Count - skipped.Count(s => s.StartsWith("action"))} action(s); " +
                $"encounter 'combat-fight' ({enemies.Count} enemy/-ies), deck {deck.Count} card(s). " +
                (skipped.Count > 0 ? $"Skipped (effects the run JSON can't represent): {string.Join(", ", skipped)}. " : "") +
                "Add a combat node → 'combat-fight' to the map to play it.";
        }
        catch (Exception ex)
        {
            _importMsg = $"Import failed: {ex.GetType().Name}: {ex.Message}";
        }
    }

    private static string NodeKind(Node node) => node.Type == StandardRunIds.CombatNode ? "combat" : "event";

    private static string NodeTarget(Node node) => node.Payload switch
    {
        EventRef e => e.Id.Value,
        EncounterRef en => en.Id.Value,
        _ => "?",
    };

    protected override void OnInitialized() => Draft.Json ??= RunJson.ToJson(DemoBlueprint(), _options);

    // Save the current blueprint JSON as a file (via a small JS download helper).
    private async Task Download()
    {
        _jsModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./runSandbox.js");
        await _jsModule.InvokeVoidAsync("download", "run-blueprint.json", _json);
    }

    // Load a blueprint JSON from an uploaded file into the editor.
    private async Task Upload(InputFileChangeEventArgs e)
    {
        using var reader = new StreamReader(e.File.OpenReadStream(5 * 1024 * 1024));
        _json = await reader.ReadToEndAsync();
        _error = null;
    }

    private void Start()
    {
        _error = null;
        DisposeSession();
        _selected.Clear();

        try
        {
            var blueprint = RunJson.FromJson<RunBlueprint>(_json, _options);
            var content = BuildContent(blueprint);

            var defs = new RunDefinitionRegistryBuilder();
            new StandardRunPackage(new AutoPlayCombatDriver(), content).RegisterDefinitions(defs);
            var registry = defs.Build();

            var run = new RunState(new RunId("demo"), new HealthState(30, 40), blueprint.Map, randomSeed: _seed);
            foreach (var card in blueprint.Deck)
                run.AddDeckCard(card);

            var session = new InteractiveRunSession(run, registry, content);
            session.Changed += OnSessionChanged;
            _session = session;
            session.Start();
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    // Headless balancing: auto-play the blueprint over many seeds and summarise outcomes.
    private void Simulate()
    {
        _simSummary = null;
        try
        {
            var blueprint = RunJson.FromJson<RunBlueprint>(_json, _options);
            var content = BuildContent(blueprint);
            var defs = new RunDefinitionRegistryBuilder();
            new StandardRunPackage(new AutoPlayCombatDriver(), content).RegisterDefinitions(defs);
            var registry = defs.Build();

            var runs = Math.Clamp(_simRuns, 1, 1000);
            var wins = 0;
            long totalHp = 0;
            long totalGold = 0;
            for (var seed = 1; seed <= runs; seed++)
            {
                var run = new RunState(new RunId($"sim{seed}"), new HealthState(30, 40), blueprint.Map, randomSeed: seed);
                foreach (var card in blueprint.Deck)
                    run.AddDeckCard(card);
                new RunRunner(registry, new ScriptedChoiceProvider(), content: content).Run(run);
                if (run.Result == RunResult.Victory)
                    wins++;
                totalHp += run.Health.Current;
                totalGold += run.GetResource(StandardRunIds.Gold);
            }

            _simSummary = $"{runs} runs — {100.0 * wins / runs:0.#}% victory, " +
                $"avg HP {(double)totalHp / runs:0.#}, avg gold {(double)totalGold / runs:0.#}";
        }
        catch (Exception ex)
        {
            _simSummary = $"Error: {ex.GetType().Name}: {ex.Message}";
        }
    }

    private void ToggleEntity(int index)
    {
        var count = _session?.PendingEntities?.Count ?? 0;
        if (_selected.Contains(index))
            _selected.Remove(index);
        else
        {
            if (count == 1)
                _selected.Clear();
            if (_selected.Count < count)
                _selected.Add(index);
        }
    }

    private void ConfirmEntities()
    {
        var indices = _selected.ToList();
        _selected.Clear();
        _session?.PickEntities(indices);
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private void DisposeSession()
    {
        if (_session is null)
            return;
        _session.Changed -= OnSessionChanged;
        _session.Dispose();
        _session = null;
    }

    public async ValueTask DisposeAsync()
    {
        DisposeSession();
        if (_jsModule is not null)
        {
            try { await _jsModule.DisposeAsync(); }
            catch (JSDisconnectedException) { /* circuit already gone */ }
        }
    }

    // The whole combat content library (cards + enemy actions, including their effect programs) is now authored
    // as data in the blueprint; only the relic is still code-provided by id.
    private static RunContentRegistry BuildContent(RunBlueprint blueprint)
    {
        var library = new CombatContentLibrary(
            cards: blueprint.Cards.Select(card => card.ToBlueprint()).ToArray(),
            enemyActions: blueprint.EnemyActions.Select(action => action.ToBlueprint()).ToArray());

        var builder = new RunContentRegistryBuilder()
            .RegisterRelic(StandardRelics.Bloodstone())
            .SetEncounters(new EncounterCatalog(library, blueprint.Encounters));
        foreach (var (id, script) in blueprint.Events)
            builder.RegisterEvent(new EventId(id), script);
        return builder.Build();
    }

    private static RunBlueprint DemoBlueprint()
    {
        var shrine = new EventScriptBuilder("shrine")
            .Situation("shrine", "An ancient shrine hums with power.", s => s
                .Choice("heal", c => c.TextKey("Pray for healing (+8 HP)").Heal(8))
                .Choice("gold", c => c.TextKey("Pry loose the offerings (+20 gold)").GainResource(StandardRunIds.Gold, 20))
                .Choice("leave", c => c.TextKey("Leave it be")))
            .Build();

        var purge = new EventScriptBuilder("purge")
            .Situation("purge", "A purifying flame offers to burn one card away.", s => s
                .Choice("purge", c => c
                    .TextKey("Burn a card (choose one)")
                    .RemoveCards(RunSelectors.DeckCards.ChooseByPlayer(1, "Choose a card to remove")))
                .Choice("keep", c => c.TextKey("Keep your deck intact")))
            .Build();

        var encounter = new EncounterDefinition(
            GoblinFight,
            enemies: new[] { new EncounterEnemy("goblin", 12, new[] { new EnemyActionDefinitionId("slam") }) },
            heroResources: new[] { new ResourceSpec(StandardCombatIds.EnergyResource, 3, 3) });

        var map = new RunMap(new Node[]
        {
            new(new NodeId("shrine"), StandardRunIds.EventNode, new EventRef(new EventId("shrine"))),
            new(new NodeId("purge"), StandardRunIds.EventNode, new EventRef(new EventId("purge"))),
            new(new NodeId("fight"), StandardRunIds.CombatNode, new EncounterRef(GoblinFight)),
        });

        var smite = new CardBlueprint("smite")
        {
            Program = Effects.Program(Effects.DealDamage(Targets.EventTarget, 6)),
        };
        var slam = new EnemyActionBlueprint("slam", new ActionIntent("Slam", IntentKind.Attack))
        {
            Program = new EffectProgram<EnemyActionContext>(new DealDamageNode<EnemyActionContext>(
                CombatantTargetSelectors.EventTarget, new ConstantExpression<EnemyActionContext>(4))),
        };

        return new RunBlueprint(
            Enumerable.Repeat(new CardDefinitionId("smite"), 5).ToList(),
            new Dictionary<string, EventScript> { ["shrine"] = shrine, ["purge"] = purge },
            new[] { encounter },
            new[] { CardData.From(smite) },
            new[] { EnemyActionData.From(slam) },
            map);
    }
}
