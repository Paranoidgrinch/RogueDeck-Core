@rendermode InteractiveServer
@implements IDisposable

<h1>RogueDeck Run Sandbox</h1>
<p class="muted">
    A whole run authored as <strong>data</strong>: the starting deck, the events, and the map are a JSON
    RunBlueprint you can edit below. The combat content (cards, the goblin encounter) and relics are provided by
    code and referenced by id. Press <strong>Load &amp; drive</strong>, then click a choice at each event to
    step through it; fights are played headlessly by the auto-play driver.
</p>

<div class="grid">
    <section class="panel">
        <h2>Run blueprint (JSON)</h2>
        <textarea @bind="_json" rows="22" style="width:100%;font-family:monospace;font-size:12px"></textarea>
        <div class="run-bar">
            <label>Seed <input type="number" @bind="_seed" style="width:6rem" /></label>
            <button class="play" @onclick="Start">Load &amp; drive</button>
        </div>
        @if (_error is not null)
        {
            <p class="error">@_error</p>
        }
    </section>

    @if (_session is { } session)
    {
        <section class="panel">
            @if (session.Error is { } runError)
            {
                <p class="error">@runError</p>
            }
            else if (session.IsAwaitingChoice && session.PendingSituation is { } situation)
            {
                <h2>@situation.TextKey</h2>
                <div class="choices">
                    @foreach (var choice in session.PendingChoices)
                    {
                        <button class="play" @onclick="() => session.Pick(choice.Id)">
                            @(string.IsNullOrEmpty(choice.TextKey) ? choice.Id : choice.TextKey)
                        </button>
                    }
                </div>
            }
            else if (session.IsAwaitingEntities && session.PendingEntities is { } request)
            {
                <h2>@request.Purpose</h2>
                <p class="muted">Pick @request.Count.</p>
                <div class="choices">
                    @for (var i = 0; i < request.Displays.Count; i++)
                    {
                        var index = i;
                        <button class="play @(_selected.Contains(index) ? "active" : "")"
                                @onclick="() => ToggleEntity(index)">
                            @request.Displays[index]
                        </button>
                    }
                </div>
                <button class="play" disabled="@(_selected.Count != request.Count)" @onclick="ConfirmEntities">
                    Confirm (@_selected.Count/@request.Count)
                </button>
            }
            else if (session.IsComplete)
            {
                <h2>Run complete</h2>
                <div class="row"><span class="muted">Outcome</span> <strong>@session.Run.Result</strong></div>
            }
            else
            {
                <p class="muted">Resolving…</p>
            }

            <h2>State</h2>
            <div class="row"><span class="muted">HP</span> @session.Run.Health.Current / @session.Run.Health.Max</div>
            <div class="row"><span class="muted">Gold</span> @session.Run.GetResource(StandardRunIds.Gold)</div>
            <div class="row"><span class="muted">Deck</span> @session.Run.Deck.Count</div>
            <div class="row"><span class="muted">Relics</span>
                @(session.Run.Relics.Count == 0 ? "none" : string.Join(", ", session.Run.Relics.Select(r => r.Id)))
            </div>
            @if (session.Run.Flags.Count > 0)
            {
                <div class="row"><span class="muted">Flags</span> @string.Join(", ", session.Run.Flags)</div>
            }
            @foreach (var counter in session.Run.Counters)
            {
                <div class="row"><span class="muted">@counter.Key</span> @counter.Value</div>
            }
        </section>

        <section class="panel">
            <h2>Run log</h2>
            <ul class="log">
                @foreach (var entry in session.Run.Log)
                {
                    <li><span class="line-kind">@entry.Type</span> @entry.Message</li>
                }
            </ul>
        </section>
    }
</div>

@code {
    private static readonly EncounterId GoblinFight = new("goblin-fight");

    private readonly JsonSerializerOptions _options = RunJson.CreateOptions();
    private string _json = "";
    private int _seed = 1;
    private InteractiveRunSession? _session;
    private string? _error;
    private readonly HashSet<int> _selected = new();

    protected override void OnInitialized() => _json = RunJson.ToJson(DemoBlueprint(), _options);

    private void Start()
    {
        _error = null;
        DisposeSession();
        _selected.Clear();

        try
        {
            var blueprint = RunJson.FromJson<RunBlueprint>(_json, _options);
            var content = BuildContent(blueprint);

            var defs = new RunDefinitionRegistryBuilder();
            new StandardRunPackage(new AutoPlayCombatDriver(), content).RegisterDefinitions(defs);
            var registry = defs.Build();

            var run = new RunState(new RunId("demo"), new HealthState(30, 40), blueprint.Map, randomSeed: _seed);
            foreach (var card in blueprint.Deck)
                run.AddDeckCard(card);

            var session = new InteractiveRunSession(run, registry, content);
            session.Changed += OnSessionChanged;
            _session = session;
            session.Start();
        }
        catch (Exception ex)
        {
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    private void ToggleEntity(int index)
    {
        var count = _session?.PendingEntities?.Count ?? 0;
        if (_selected.Contains(index))
            _selected.Remove(index);
        else
        {
            if (count == 1)
                _selected.Clear();
            if (_selected.Count < count)
                _selected.Add(index);
        }
    }

    private void ConfirmEntities()
    {
        var indices = _selected.ToList();
        _selected.Clear();
        _session?.PickEntities(indices);
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private void DisposeSession()
    {
        if (_session is null)
            return;
        _session.Changed -= OnSessionChanged;
        _session.Dispose();
        _session = null;
    }

    public void Dispose() => DisposeSession();

    // The combat content library, encounter and relic are code-provided and referenced by id; the blueprint's
    // events are registered on top.
    private static RunContentRegistry BuildContent(RunBlueprint blueprint)
    {
        var library = new CombatContentLibrary(
            cards: new[]
            {
                new CardBlueprint("smite") { Program = Effects.Program(Effects.DealDamage(Targets.EventTarget, 6)) },
            },
            enemyActions: new[]
            {
                new EnemyActionBlueprint("slam", new ActionIntent("Slam", IntentKind.Attack))
                {
                    Program = new EffectProgram<EnemyActionContext>(new DealDamageNode<EnemyActionContext>(
                        CombatantTargetSelectors.EventTarget, new ConstantExpression<EnemyActionContext>(4))),
                },
            });

        var encounter = new EncounterDefinition(
            GoblinFight,
            enemies: new[] { new EncounterEnemy("goblin", 12, new[] { new EnemyActionDefinitionId("slam") }) },
            heroResources: new[] { new ResourceSpec(StandardCombatIds.EnergyResource, 3, 3) });

        var builder = new RunContentRegistryBuilder()
            .RegisterRelic(StandardRelics.Bloodstone())
            .SetEncounters(new EncounterCatalog(library, new[] { encounter }));
        foreach (var (id, script) in blueprint.Events)
            builder.RegisterEvent(new EventId(id), script);
        return builder.Build();
    }

    private static RunBlueprint DemoBlueprint()
    {
        var shrine = new EventScriptBuilder("shrine")
            .Situation("shrine", "An ancient shrine hums with power.", s => s
                .Choice("heal", c => c.TextKey("Pray for healing (+8 HP)").Heal(8))
                .Choice("gold", c => c.TextKey("Pry loose the offerings (+20 gold)").GainResource(StandardRunIds.Gold, 20))
                .Choice("leave", c => c.TextKey("Leave it be")))
            .Build();

        var purge = new EventScriptBuilder("purge")
            .Situation("purge", "A purifying flame offers to burn one card away.", s => s
                .Choice("purge", c => c
                    .TextKey("Burn a card (choose one)")
                    .RemoveCards(RunSelectors.DeckCards.ChooseByPlayer(1, "Choose a card to remove")))
                .Choice("keep", c => c.TextKey("Keep your deck intact")))
            .Build();

        var map = new RunMap(new Node[]
        {
            new(new NodeId("shrine"), StandardRunIds.EventNode, new EventRef(new EventId("shrine"))),
            new(new NodeId("purge"), StandardRunIds.EventNode, new EventRef(new EventId("purge"))),
            new(new NodeId("fight"), StandardRunIds.CombatNode, new EncounterRef(GoblinFight)),
        });

        return new RunBlueprint(
            Enumerable.Repeat(new CardDefinitionId("smite"), 5).ToList(),
            new Dictionary<string, EventScript> { ["shrine"] = shrine, ["purge"] = purge },
            map);
    }
}
