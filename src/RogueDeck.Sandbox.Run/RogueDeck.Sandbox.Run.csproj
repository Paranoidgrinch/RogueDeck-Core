<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <!-- Components-only reference (not the full ASP.NET Core framework) so the library loads under browser-wasm
         (RogueDeck.Studio.Web) as well as in the server host. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- The second built-in sample: the complete Bureaucrats & Broomsticks Act-I demo game, generated by
         the bnb-content converter (github.com/Paranoidgrinch/bnb-content). Embedded so both hosts (server
         and WASM) ship the exact exported document. -->
    <EmbeddedResource Include="SampleContent\bureaucrats.roguedeck.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RogueDeck.Run\RogueDeck.Run.csproj" />
    <!-- The Run tab projects content authored in the Combat tab (a run contains combats), so it depends on the
         combat sandbox — the dependency points Run → Combat, never the other way round. -->
    <ProjectReference Include="..\RogueDeck.Sandbox.Combat\RogueDeck.Sandbox.Combat.csproj" />
  </ItemGroup>

</Project>
