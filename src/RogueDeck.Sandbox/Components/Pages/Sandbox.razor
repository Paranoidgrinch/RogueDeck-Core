@page "/"
@rendermode InteractiveServer

<PageTitle>RogueDeck Sandbox</PageTitle>

<h1>RogueDeck Sandbox</h1>
<p class="muted">
    Define a hero, enemies (one intent per round), and cards (cost + effects). Hit <strong>Run fight</strong>
    to play it on the real engine and read the round-grouped narrative log. Card effects are assembled from
    the engine's own primitives — the sandbox never invents new combat rules.
</p>

@if (_combat is null)
{
<div class="grid">
    <section class="panel">
        <h2>Hero</h2>
        <div class="row">
            <label>Name <input @bind="_model.Hero.Name" /></label>
            <label>HP <input type="number" @bind="_model.Hero.Hp" style="width:5rem" /></label>
            <label>Energy <input type="number" @bind="_model.Hero.Energy" style="width:4rem" /></label>
        </div>
        <div class="sub-head">
            <span>Resources (besides Energy)</span>
            <button @onclick="() => _model.Resources.Add(new ResourceModel())">+ resource</button>
        </div>
        @foreach (var res in _model.Resources)
        {
            <div class="effect-line">
                <input @bind="res.Name" placeholder="name" style="width:7rem" title="resource name" />
                <span class="amount-label">start</span>
                <input type="number" @bind="res.Start" style="width:4rem" />
                <span class="amount-label">max</span>
                <input type="number" @bind="res.Max" style="width:4rem" />
                <label title="top up to max at the start of every turn (like Energy)"><input type="checkbox" @bind="res.RefillEachTurn" /> refill/turn</label>
                <button class="del" @onclick="() => _model.Resources.Remove(res)">✕</button>
            </div>
        }
        <div class="sub-head">
            <span>Defensive pools (besides Block)</span>
            <button @onclick="() => _model.DefensivePools.Add(new DefensivePoolModel())">+ pool</button>
        </div>
        @foreach (var pool in _model.DefensivePools)
        {
            <div class="effect-line">
                <input @bind="pool.Name" placeholder="name" style="width:7rem" title="defensive pool name" />
                <label title="soak damage before Block (otherwise after)"><input type="checkbox" @bind="pool.AbsorbsBeforeBlock" /> before block</label>
                <label title="empty at the start of every turn (like Block); off = persistent ward"><input type="checkbox" @bind="pool.ClearsEachTurn" /> clears/turn</label>
                <button class="del" @onclick="() => _model.DefensivePools.Remove(pool)">✕</button>
            </div>
        }
        @StatusListEditor(_model.Hero.StartingStatuses)
        <div class="row">
            <label><input type="checkbox" @bind="_model.Hero.UseRealDeck" /> use a real deck (draw / discard / reshuffle)</label>
            @if (_model.Hero.UseRealDeck)
            {
                <span class="amount-label">draw</span>
                <input type="number" @bind="_model.Hero.DrawPerTurn" style="width:4rem" />
                <span class="amount-label">per turn</span>
            }
        </div>
        @if (!_model.Hero.UseRealDeck)
        {
            <p class="muted">Full hand: every defined card is drawn each turn (good for isolating effects).</p>
        }
        else
        {
            <div class="sub-head">
                <span>Deck (cards × copies)</span>
                <button @onclick="() => _model.Hero.Deck.Add(new DeckCardModel())">+ deck card</button>
            </div>
            @foreach (var entry in _model.Hero.Deck)
            {
                <div class="row">
                    <select @bind="entry.CardName">
                        <option value="">— card —</option>
                        @foreach (var card in _model.Cards)
                        {
                            <option value="@card.Name">@card.Name</option>
                        }
                    </select>
                    <span class="amount-label">×</span>
                    <input type="number" @bind="entry.Copies" style="width:4rem" />
                    <button class="del" @onclick="() => _model.Hero.Deck.Remove(entry)">✕</button>
                </div>
            }
        }
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>Cards</h2>
            <button @onclick="AddCard">+ card</button>
        </div>
        @foreach (var card in _model.Cards)
        {
            <div class="card-box">
                <div class="row">
                    <label>Name <input @bind="card.Name" /></label>
                    <label>Cost ⚡<input type="number" @bind="card.Cost" style="width:4rem" /></label>
                    <button class="del" @onclick="() => _model.Cards.Remove(card)">✕</button>
                </div>
                @if (_model.Resources.Count > 0)
                {
                    <div class="effect-line">
                        <span class="amount-label">also costs</span>
                        @foreach (var ec in card.ExtraCosts)
                        {
                            <input type="number" @bind="ec.Amount" style="width:3.5rem" />
                            <select @bind="ec.ResourceName">
                                @foreach (var res in _model.Resources)
                                {
                                    <option value="@res.Name">@res.Name</option>
                                }
                            </select>
                            <button class="del" @onclick="() => card.ExtraCosts.Remove(ec)">✕</button>
                        }
                        <button @onclick="() => card.ExtraCosts.Add(new ResourceCostModel { ResourceName = _model.Resources[0].Name })">+ cost</button>
                    </div>
                }
                <div class="effect-line">
                    <span class="amount-label">tags</span>
                    @foreach (var tag in EffectCatalog.CardTags)
                    {
                        <label title="@tag.Description"><input type="checkbox" checked="@card.Tags.Contains(tag.Id)"
                            @onchange="e => ToggleCardTag(card, tag.Id, (bool)e.Value!)" /> @tag.Label</label>
                    }
                    <label title="keep this card in hand at turn end (Retain)"><input type="checkbox" @bind="card.RetainInHand" /> retain</label>
                </div>
                <div class="effect-line">
                    <span class="amount-label" title="where the card goes once played">on play →</span>
                    <select @bind="card.PlayedZone">
                        @foreach (var z in Enum.GetValues<CardZone>())
                        {
                            <option value="@z">@z</option>
                        }
                    </select>
                    <span class="amount-label" title="where a non-retained card in hand goes at turn end">at turn end →</span>
                    <select @bind="card.TurnEndZone">
                        @foreach (var z in Enum.GetValues<CardZone>())
                        {
                            <option value="@z">@z</option>
                        }
                    </select>
                </div>
                @EffectEditor(card.Effects)
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>Statuses</h2>
            <button @onclick="AddStatus">+ status</button>
        </div>
        <p class="muted">Define your own statuses — they appear in every status picker alongside the standard ones.</p>
        @foreach (var s in _model.Statuses)
        {
            <div class="card-box">
                <div class="row">
                    <label>Name <input @bind="s.Name" /></label>
                    <label>Polarity
                        <select @bind="s.Polarity">
                            @foreach (var p in Enum.GetValues<StatusPolarity>())
                            {
                                <option value="@p">@p</option>
                            }
                        </select>
                    </label>
                    <button class="del" @onclick="() => _model.Statuses.Remove(s)">✕</button>
                </div>
                <div class="row">
                    <label><input type="checkbox" @bind="s.HasPassiveModifier" /> passive modifier (always-on math)</label>
                    <label><input type="checkbox" @bind="s.UsesDuration" /> uses duration (can expire)</label>
                </div>
                <div class="row">
                    <label><input type="checkbox" @bind="s.PreventsDeath" /> prevents death once</label>
                    @if (s.PreventsDeath)
                    {
                        <span class="amount-label">survive at</span>
                        <input type="number" @bind="s.SurvivingHealth" style="width:4rem" />
                        <span class="amount-label">HP</span>
                    }
                    <label><input type="checkbox" @bind="s.BlocksDebuffs" /> blocks the next debuff</label>
                </div>
                @if (s.PreventsDeath)
                {
                    <div class="intent-box">
                        <div class="nested-label">on prevent (constant-amount effects)</div>
                        @EffectEditor(s.OnPreventEffects)
                    </div>
                }
                @if (s.BlocksDebuffs)
                {
                    <div class="intent-box">
                        <div class="nested-label">on block (constant-amount effects)</div>
                        @EffectEditor(s.OnBlockEffects)
                    </div>
                }
                @if (s.HasPassiveModifier)
                {
                    <div class="row">
                        <select @bind="s.Operation">
                            @foreach (var o in Enum.GetValues<PassiveModifierOperation>())
                            {
                                <option value="@o">@OperationLabel(o)</option>
                            }
                        </select>
                        <input type="number" @bind="s.Magnitude" style="width:4rem" />
                        <select @bind="s.Pipeline">
                            @foreach (var p in PipelineChoices)
                            {
                                <option value="@p">@PipelineLabel(p)</option>
                            }
                        </select>
                    </div>
                    <div class="effect-desc">Passive: @EffectCatalog.DescribePassiveModifier(s)</div>
                }
                <div class="sub-head">
                    <span>Triggers — run effects on an event</span>
                    <button @onclick="() => s.Triggers.Add(NewTrigger())">+ trigger</button>
                </div>
                @foreach (var t in s.Triggers)
                {
                    <div class="intent-box">
                        <div class="row">
                            <label>When
                                <select @bind="t.Event">
                                    @foreach (var ev in Enum.GetValues<TriggerEvent>())
                                    {
                                        <option value="@ev">@TriggerEventLabel(ev)</option>
                                    }
                                </select>
                            </label>
                            <button class="del" @onclick="() => s.Triggers.Remove(t)">✕</button>
                        </div>
                        @EffectEditor(t.Effects)
                    </div>
                }
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>Enemies</h2>
            <button @onclick="AddEnemy">+ enemy</button>
        </div>
        @foreach (var enemy in _model.Enemies)
        {
            <div class="card-box">
                <div class="row">
                    <label>Name <input @bind="enemy.Name" /></label>
                    <label>HP <input type="number" @bind="enemy.Hp" style="width:5rem" /></label>
                    <button class="del" @onclick="() => _model.Enemies.Remove(enemy)">✕</button>
                </div>
                @StatusListEditor(enemy.StartingStatuses)
                <div class="sub-head">
                    <span>Intents (one per round)</span>
                    <button @onclick="() => enemy.Intents.Add(NewIntent())">+ intent</button>
                </div>
                @{ var roundNo = 0; }
                @foreach (var intent in enemy.Intents)
                {
                    roundNo++;
                    <div class="intent-box">
                        <div class="row">
                            <strong>R@(roundNo)</strong>
                            <label>Label <input @bind="intent.Label" style="width:7rem" /></label>
                            <label>Kind
                                <select @bind="intent.Kind">
                                    @foreach (var k in Enum.GetValues<IntentKind>())
                                    {
                                        <option value="@k">@k</option>
                                    }
                                </select>
                            </label>
                            <button class="del" @onclick="() => enemy.Intents.Remove(intent)">✕</button>
                        </div>
                        @EffectEditor(intent.Effects)
                    </div>
                }
            </div>
        }
    </section>

    <section class="panel">
        <div class="panel-head">
            <h2>Hero turns</h2>
            <button @onclick="AddRound">+ round</button>
        </div>
        @{ var rIndex = 0; }
        @foreach (var round in _model.Rounds)
        {
            rIndex++;
            <div class="card-box">
                <div class="sub-head">
                    <strong>Round @rIndex</strong>
                    <span>
                        <button @onclick="() => round.HeroPlays.Add(new PlayModel())">+ play</button>
                        <button class="del" @onclick="() => _model.Rounds.Remove(round)">✕ round</button>
                    </span>
                </div>
                @foreach (var play in round.HeroPlays)
                {
                    <div class="row">
                        <label>Plays
                            <select @bind="play.CardName">
                                <option value="">— card —</option>
                                @foreach (var card in _model.Cards)
                                {
                                    <option value="@card.Name">@card.Name</option>
                                }
                            </select>
                        </label>
                        <label>at
                            <select @bind="play.TargetEnemy">
                                <option value="">(no target)</option>
                                @foreach (var enemy in _model.Enemies)
                                {
                                    <option value="@enemy.Name">@enemy.Name</option>
                                }
                            </select>
                        </label>
                        <button class="del" @onclick="() => round.HeroPlays.Remove(play)">✕</button>
                    </div>
                }
            </div>
        }
    </section>
</div>

<div class="run-bar">
    <button class="run" @onclick="Run">▶ Run fight</button>
    <button class="play" @onclick="StartPlay">🎮 Play interactively</button>
    <button @onclick="LoadDemo">load demo</button>
    <button @onclick="Reset">clear</button>
</div>

@if (_error is not null)
{
    <pre class="error">@_error</pre>
}
@if (_log is not null)
{
    <pre class="log">@_log</pre>
}

<details class="saveload">
    <summary>Save / Load (JSON)</summary>
    <div class="run-bar">
        <button @onclick="ExportJson">Export ↓</button>
        <button @onclick="ImportJson">Import ↑</button>
        <span class="muted">Export to copy your setup; paste JSON and Import to restore it.</span>
    </div>
    <textarea @bind="_json" rows="10" spellcheck="false" placeholder="(JSON appears here on Export; paste here then Import)"></textarea>
</details>
}
else
{
    <div class="run-bar">
        <button @onclick="BackToEditor">← back to editor</button>
        <span class="status">
            <strong>Round @_combat.Round</strong> —
            @if (_combat.IsOver)
            {
                <span>combat over: <strong>@_combat.Result</strong></span>
            }
            else if (_combat.IsHeroTurn)
            {
                <span>your turn · Energy @_combat.HeroEnergy/@_combat.HeroEnergyMax@HeroResourcesLine()</span>
            }
            else
            {
                <span>resolving…</span>
            }
            @if (_model.Hero.UseRealDeck)
            {
                <span class="piles">· @PileLine()</span>
            }
        </span>
    </div>

    <div class="grid">
        <section class="panel">
            <h2>Combatants</h2>
            @foreach (var c in _combat.State.Combatants)
            {
                <div class="unit @(c.Id == _combat.HeroId ? "hero" : "enemy") @(c.IsAlive ? "" : "downed")">
                    <div class="unit-head">
                        <strong>@DisplayName(c.Id)</strong>
                        <span>@c.Health.Current/@c.Health.Max HP@(Block(c) > 0 ? $" · 🛡{Block(c)}" : "")@DefensivePoolsLine(c) @(c.IsAlive ? "" : "💀")</span>
                    </div>
                    <div class="hpbar"><div class="hpfill" style="width:@HpPercent(c)%"></div></div>
                    @if (c.Statuses.Count > 0)
                    {
                        <div class="statuses">@StatusLine(c)</div>
                    }
                </div>
            }
        </section>

        <section class="panel">
            <h2>Your hand</h2>
            @if (!_combat.IsHeroTurn)
            {
                <p class="muted">Not your turn.</p>
            }
            else
            {
                <div class="row">
                    <label>Target
                        <select @bind="_target">
                            <option value="">(none)</option>
                            @foreach (var c in _combat.State.Combatants.Where(c => c.Id != _combat.HeroId && c.IsAlive))
                            {
                                <option value="@c.Id.value">@DisplayName(c.Id)</option>
                            }
                        </select>
                    </label>
                </div>
                <div class="hand">
                    @foreach (var card in _combat.Hand)
                    {
                        var cost = CardCost(card.DefinitionId.value);
                        var affordable = cost <= _combat.HeroEnergy;
                        <button class="hand-card" disabled="@(!affordable)" title="@CardTooltip(card.DefinitionId.value)" @onclick="() => PlayHand(card.Id)">
                            @CardName(card.DefinitionId.value) <span class="cost">⚡@cost</span>
                        </button>
                    }
                    @if (_combat.Hand.Count == 0)
                    {
                        <span class="muted">(empty hand)</span>
                    }
                </div>
                <div class="run-bar">
                    <button class="run" @onclick="EndTurn">End turn ▸</button>
                </div>
            }
        </section>
    </div>

    <pre class="log">@(new NarrativeLogRenderer(NameMap()).Render(_combat.ToReport()))</pre>
}

<style>
    .muted { color:#666; max-width:60rem; }
    .grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; align-items:start; }
    .panel { border:1px solid #ccc; border-radius:.5rem; padding:.75rem; }
    .panel-head, .sub-head { display:flex; justify-content:space-between; align-items:center; }
    .panel h2 { margin:.2rem 0; font-size:1.1rem; }
    .row { display:flex; gap:.5rem; align-items:center; flex-wrap:wrap; margin:.25rem 0; }
    .card-box { border:1px solid #e0e0e0; border-radius:.4rem; padding:.5rem; margin:.4rem 0; background:#fafafa; }
    .intent-box { border-left:3px solid #c9c9f0; padding:.3rem .5rem; margin:.3rem 0; background:#fff; }
    .effect-line { display:flex; gap:.4rem; align-items:center; margin:.2rem 0 0; flex-wrap:wrap; }
    .effect-desc { font-size:.8rem; color:#777; margin:0 0 .4rem 0; }
    .amount-label { font-size:.8rem; color:#888; }
    .effect-node { border-left:2px solid #e3e3e3; padding-left:.4rem; margin:.15rem 0; }
    .line-kind { background:#f0f0f5; }
    .nested { margin:.1rem 0 .3rem 1rem; border-left:2px dashed #ccd; padding-left:.5rem; }
    .nested-label { font-size:.75rem; color:#88a; font-weight:bold; }
    .sub-head { margin:.3rem 0; font-size:.9rem; color:#555; }
    input, select { padding:.15rem .3rem; }
    button { cursor:pointer; padding:.2rem .5rem; }
    button.del { color:#a00; border:none; background:none; }
    .run-bar { margin:1rem 0; display:flex; gap:.5rem; }
    button.run { background:#2a7; color:#fff; border:none; border-radius:.4rem; padding:.5rem 1rem; font-size:1rem; }
    button.play { background:#36a; color:#fff; border:none; border-radius:.4rem; padding:.5rem 1rem; font-size:1rem; }
    pre.log { background:#1e1e1e; color:#e0e0e0; padding:1rem; border-radius:.5rem; overflow:auto; }
    pre.error { background:#fee; color:#900; padding:1rem; border-radius:.5rem; white-space:pre-wrap; }
    .saveload { margin:1rem 0; border:1px solid #ddd; border-radius:.4rem; padding:.5rem; }
    .saveload summary { cursor:pointer; font-weight:bold; }
    .saveload textarea { width:100%; font-family:monospace; font-size:.8rem; }
    .status { margin-left:1rem; }
    .unit { border:1px solid #ddd; border-radius:.4rem; padding:.4rem .6rem; margin:.4rem 0; }
    .unit.hero { border-left:4px solid #2a7; }
    .unit.enemy { border-left:4px solid #c44; }
    .unit.downed { opacity:.5; }
    .unit-head { display:flex; justify-content:space-between; }
    .hpbar { height:6px; background:#eee; border-radius:3px; margin:.25rem 0; overflow:hidden; }
    .hpfill { height:100%; background:#5a5; }
    .unit.enemy .hpfill { background:#c66; }
    .statuses { font-size:.8rem; color:#666; }
    .hand { display:flex; gap:.5rem; flex-wrap:wrap; margin:.5rem 0; }
    button.hand-card { border:1px solid #36a; border-radius:.4rem; padding:.5rem .8rem; background:#eef; }
    button.hand-card:disabled { opacity:.45; cursor:not-allowed; }
    .hand-card .cost { color:#36a; font-weight:bold; }
</style>

@code {
    private SandboxModel _model = DemoModel();
    private string? _log;
    private string? _error;
    private InteractiveCombat? _combat;
    private string? _target;
    private string _json = "";

    private void ExportJson()
    {
        _error = null;
        try { _json = SandboxModelJson.Export(_model); }
        catch (Exception ex) { _error = $"Export failed:\n{ex.Message}"; }
    }

    private void ImportJson()
    {
        _error = null;
        _log = null;
        try { _model = SandboxModelJson.Import(_json); }
        catch (Exception ex) { _error = $"Import failed:\n{ex.Message}"; }
    }

    private void StartPlay()
    {
        _error = null;
        _log = null;
        try
        {
            _combat = new ScenarioComposer().StartInteractive(_model);
            _target = _combat.State.Combatants
                .FirstOrDefault(c => c.Id != _combat.HeroId && c.IsAlive)?.Id.value;
        }
        catch (Exception ex)
        {
            _error = $"Could not start the fight:\n{ex.Message}";
            _combat = null;
        }
    }

    private void BackToEditor() => _combat = null;

    private void PlayHand(CardInstanceId cardId)
    {
        var target = string.IsNullOrEmpty(_target) ? (CombatantId?)null : new CombatantId(_target);
        _combat?.PlayCard(cardId, target);
    }

    private void EndTurn() => _combat?.EndTurn();

    // " · Mana 2/3 · Blood 1/5" for the hero's custom resources (everything but Energy), shown in the play bar.
    private string HeroResourcesLine()
    {
        if (_combat is null || _model.Resources.Count == 0)
            return "";
        var hero = _combat.State.GetCombatant(_combat.HeroId);
        var parts = new List<string>();
        foreach (var res in _model.Resources)
        {
            if (string.IsNullOrWhiteSpace(res.Name))
                continue;
            if (hero.Resources.TryGetValue(new ResourceId(ScenarioComposer.Slug(res.Name)), out var pool))
                parts.Add($"{res.Name} {pool.Current}/{pool.Max ?? pool.Current}");
        }
        return parts.Count == 0 ? "" : " · " + string.Join(" · ", parts);
    }

    private string PileLine()
    {
        if (_combat is null) return "";
        var zones = _combat.State.GetCardZones(_combat.HeroId);
        return $"Draw {zones.GetCardsInZone(CardZone.DrawPile).Count} · " +
               $"Discard {zones.GetCardsInZone(CardZone.DiscardPile).Count} · " +
               $"Exhaust {zones.GetCardsInZone(CardZone.ExhaustPile).Count} · " +
               $"Banish {zones.GetCardsInZone(CardZone.BanishedPile).Count}";
    }

    // ── Play-view display helpers ──
    private string DisplayName(CombatantId id)
    {
        var slug = id.value;
        if (slug == ScenarioComposer.Slug(_model.Hero.Name))
            return _model.Hero.Name;
        return _model.Enemies.FirstOrDefault(e => ScenarioComposer.Slug(e.Name) == slug)?.Name ?? slug;
    }

    private string CardName(string slug) =>
        _model.Cards.FirstOrDefault(c => ScenarioComposer.Slug(c.Name) == slug)?.Name ?? slug;

    private int CardCost(string slug) =>
        _model.Cards.FirstOrDefault(c => ScenarioComposer.Slug(c.Name) == slug)?.Cost ?? 0;

    private static int Block(CombatantState c) =>
        c.DefensivePools.TryGetValue(StandardCombatIds.BlockDefensivePool, out var pool) ? pool.Current : 0;

    // " · 🛡Ward 4" for each custom defensive pool the combatant currently holds, shown beside its HP/Block.
    private string DefensivePoolsLine(CombatantState c)
    {
        if (_model.DefensivePools.Count == 0)
            return "";
        var parts = new List<string>();
        foreach (var pool in _model.DefensivePools)
        {
            if (string.IsNullOrWhiteSpace(pool.Name))
                continue;
            if (c.DefensivePools.TryGetValue(new DefensivePoolId(ScenarioComposer.Slug(pool.Name)), out var p) && p.Current > 0)
                parts.Add($"🛡{pool.Name} {p.Current}");
        }
        return parts.Count == 0 ? "" : " · " + string.Join(" · ", parts);
    }

    private static int HpPercent(CombatantState c) =>
        c.Health.Max <= 0 ? 0 : (int)(100.0 * c.Health.Current / c.Health.Max);

    // slug → display name for the log: combatants, cards, and each enemy's per-round action (its intent label).
    private Dictionary<string, string> NameMap()
    {
        var map = new Dictionary<string, string>();
        map[ScenarioComposer.Slug(_model.Hero.Name)] = _model.Hero.Name;
        foreach (var card in _model.Cards)
            map[ScenarioComposer.Slug(card.Name)] = card.Name;
        foreach (var enemy in _model.Enemies)
        {
            map[ScenarioComposer.Slug(enemy.Name)] = enemy.Name;
            for (var i = 0; i < enemy.Intents.Count; i++)
                map[$"{ScenarioComposer.Slug(enemy.Name)}_intent{i}"] = enemy.Intents[i].Label;
        }
        return map;
    }

    private string CardTooltip(string slug)
    {
        var card = _model.Cards.FirstOrDefault(c => ScenarioComposer.Slug(c.Name) == slug);
        if (card is null)
            return slug;
        return string.Join("; ", card.Effects.Select(DescribeEffect));
    }

    private static string StatusLine(CombatantState c) =>
        string.Join("  ", c.Statuses.Select(s =>
        {
            var name = s.DefinitionId.value.Replace("standard.", "");
            var magnitude = s.Stacks > 0 ? $"×{s.Stacks}"
                : s.DurationTurns > 0 ? $" {s.DurationTurns}t"
                : s.Charges > 0 ? $" {s.Charges}c" : "";
            return $"{name}{magnitude}";
        }));

    private void Run()
    {
        _log = null;
        _error = null;
        try
        {
            var playthrough = new ScenarioComposer().Compose(_model);
            var report = new ScenarioRunner().Run(playthrough);
            _log = new NarrativeLogRenderer(NameMap()).Render(report);
        }
        catch (Exception ex)
        {
            _error = $"Could not run the fight:\n{ex.Message}";
        }
    }

    private static void ToggleCardTag(CardModel card, string tag, bool on)
    {
        if (on)
        {
            if (!card.Tags.Contains(tag))
                card.Tags.Add(tag);
        }
        else
        {
            card.Tags.Remove(tag);
        }
    }

