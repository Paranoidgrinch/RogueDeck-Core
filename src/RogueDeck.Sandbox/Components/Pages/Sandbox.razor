    // The default Knight-vs-Ogre-&-Imp fight, so the page does something the moment it loads.
    private static SandboxModel DemoModel()
    {
        EffectLineModel Dmg(int n, EffectTarget t = EffectTarget.Target) =>
            new() { Kind = EffectKind.DealDamage, Target = t, Amount = n };
        EffectLineModel Block(int n) => new() { Kind = EffectKind.GainBlock, Target = EffectTarget.Self, Amount = n };
        EffectLineModel Status(string id, int n, EffectTarget t) =>
            new() { Kind = EffectKind.ApplyStatus, Target = t, StatusId = id, Amount = n };

        return new SandboxModel
        {
            Hero = new HeroModel { Name = "Knight", Hp = 50, Energy = 3 },
            Cards =
            {
                new CardModel { Name = "Strike", Cost = 1, Effects = { Dmg(8) } },
                new CardModel { Name = "Guard", Cost = 1, Effects = { Block(6) } },
                new CardModel { Name = "Venom", Cost = 1, Effects = { Status("standard.poison", 3, EffectTarget.Target) } },
                new CardModel { Name = "Rally", Cost = 1, Effects = { Status("standard.strength", 2, EffectTarget.Self) } },
            },
            Enemies =
            {
                new EnemyModel
                {
                    Name = "Ogre", Hp = 40,
                    Intents =
                    {
                        new IntentModel { Label = "Smash", Kind = IntentKind.Attack, Effects = { Dmg(12) } },
                        new IntentModel { Label = "Harden", Kind = IntentKind.Defend, Effects = { Block(10) } },
                    },
                },
                new EnemyModel
                {
                    Name = "Imp", Hp = 14,
                    Intents =
                    {
                        new IntentModel { Label = "Hex", Kind = IntentKind.Debuff, Effects = { Status("standard.weak", 2, EffectTarget.Target) } },
                    },
                },
            },
            Rounds =
            {
                new RoundModel { HeroPlays = { Play("Rally"), Play("Venom", "Ogre"), Play("Strike", "Ogre") } },
                new RoundModel { HeroPlays = { Play("Guard"), Play("Strike", "Ogre") } },
            },
        };
    }

    private static PlayModel Play(string card, string? target = null) => new() { CardName = card, TargetEnemy = target };

    // Inline editor for a combatant's starting statuses (shared by the hero and enemies).
    private RenderFragment StatusListEditor(List<StartingStatusModel> statuses) => __builder =>
    {
        <div class="sub-head">
            <span>Start statuses</span>
            <button @onclick="() => statuses.Add(new StartingStatusModel())">+ status</button>
        </div>
        @foreach (var status in statuses)
        {
            <div class="effect-line">
                <select @bind="status.StatusId">
                    @foreach (var s in AllStatuses())
                    {
                        <option value="@s.Id">@s.Label</option>
                    }
                </select>
                <input type="number" @bind="status.Amount" style="width:4rem" title="stacks" />
                <span class="amount-label">stk</span>
                <input type="number" @bind="status.DurationTurns" style="width:4rem" title="duration (turns, 0 = none)" />
                <span class="amount-label">turns</span>
                <button class="del" @onclick="() => statuses.Remove(status)">✕</button>
            </div>
            @if (StatusInfoFor(status.StatusId) is { } info)
            {
                <div class="effect-desc">@info.Label: @info.Description</div>
            }
        }
    };

    // Inline editor for a list of effect lines (shared by cards and enemy intents).
    private RenderFragment EffectEditor(List<EffectLineModel> effects) => __builder =>
    {
        <div class="sub-head">
            <span>Effects</span>
            <button @onclick="() => effects.Add(new EffectLineModel())">+ effect</button>
        </div>
        @foreach (var line in effects)
        {
            <div class="effect-node">
                <div class="effect-line">
                    <select @bind="line.Line" class="line-kind">
                        @foreach (var lk in Enum.GetValues<LineKind>())
                        {
                            <option value="@lk">@LineKindLabel(lk)</option>
                        }
                    </select>

                    @if (line.Line == LineKind.Effect)
                    {
                        var info = EffectCatalog.For(line.Kind);
                        <select @bind="line.Kind">
                            @foreach (var k in EffectCatalog.Kinds)
                            {
                                <option value="@k.Kind">@k.Label</option>
                            }
                        </select>
                        @if (info.UsesAmount)
                        {
                            <span class="amount-label">@info.AmountLabel</span>
                            <select @bind="line.AmountSource">
                                @foreach (var a in Enum.GetValues<AmountSource>())
                                {
                                    <option value="@a">@AmountSourceLabel(a)</option>
                                }
                            </select>
                            @if (line.AmountSource == AmountSource.Constant)
                            {
                                <input type="number" @bind="line.Amount" style="width:4rem" />
                            }
                            else if (line.AmountSource is AmountSource.TargetStatusStacks or AmountSource.SelfStatusStacks)
                            {
                                <select @bind="line.AmountStatusId">
                                    @foreach (var s in AllStatuses())
                                    {
                                        <option value="@s.Id">@s.Label</option>
                                    }
                                </select>
                            }
                            else if (line.AmountSource is AmountSource.SelfResourceCurrent or AmountSource.SelfResourceMax or AmountSource.SelfResourceMissing)
                            {
                                <select @bind="line.AmountResourceId">
                                    <option value="">⚡ energy</option>
                                    @foreach (var res in _model.Resources)
                                    {
                                        <option value="@res.Name">@res.Name</option>
                                    }
                                </select>
                            }
                            else if (line.AmountSource == AmountSource.TargetDefensivePool)
                            {
                                <select @bind="line.DefensivePoolName">
                                    <option value="">🛡 block</option>
                                    @foreach (var pool in _model.DefensivePools)
                                    {
                                        <option value="@pool.Name">@pool.Name</option>
                                    }
                                </select>
                            }
                            <select @bind="line.ArithmeticOp" title="arithmetic">
                                @foreach (var op in Enum.GetValues<ArithmeticOp>())
                                {
                                    <option value="@op">@ArithmeticOpLabel(op)</option>
                                }
                            </select>
                            @if (line.ArithmeticOp != ArithmeticOp.None)
                            {
                                <input type="number" @bind="line.ArithmeticOperand" style="width:4rem" />
                            }
                        }
                        @if (info.UsesTarget)
                        {
                            <select @bind="line.Target" title="who it hits">
                                @foreach (var t in EffectCatalog.Targets)
                                {
                                    <option value="@t.Target">@t.Label</option>
                                }
                            </select>
                        }
                        @if (info.UsesStatus)
                        {
                            <select @bind="line.StatusId" title="which status">
                                @foreach (var s in AllStatuses())
                                {
                                    <option value="@s.Id">@s.Label</option>
                                }
                            </select>
                        }
                        @if (info.UsesResource)
                        {
                            <select @bind="line.ResourceName" title="which resource">
                                <option value="">⚡ energy</option>
                                @foreach (var res in _model.Resources)
                                {
                                    <option value="@res.Name">@res.Name</option>
                                }
                            </select>
                        }
                        @if (info.UsesDefensivePool)
                        {
                            <select @bind="line.DefensivePoolName" title="which defensive pool">
                                <option value="">🛡 block</option>
                                @foreach (var pool in _model.DefensivePools)
                                {
                                    <option value="@pool.Name">@pool.Name</option>
                                }
                            </select>
                        }
                        @if (info.UsesPolarity)
                        {
                            <select @bind="line.Polarity" title="which polarity">
                                @foreach (var p in Enum.GetValues<StatusPolarity>())
                                {
                                    <option value="@p">@p</option>
                                }
                            </select>
                        }
                        @if (info.UsesTeam)
                        {
                            <select @bind="line.Team" title="which team">
                                @foreach (var tc in Enum.GetValues<TeamChoice>())
                                {
                                    <option value="@tc">@tc</option>
                                }
                            </select>
                        }
                        @if (info.UsesResult)
                        {
                            <select @bind="line.Result" title="combat result">
                                <option value="@CombatResult.Victory">Victory</option>
                                <option value="@CombatResult.Defeat">Defeat</option>
                                <option value="@CombatResult.Draw">Draw</option>
                            </select>
                        }
                        @if (info.UsesCardRef)
                        {
                            <select @bind="line.CreateCardName" title="which card">
                                <option value="">— card —</option>
                                @foreach (var card in _model.Cards)
                                {
                                    <option value="@card.Name">@card.Name</option>
                                }
                            </select>
                        }
                        @if (info.UsesCardInstanceRef)
                        {
                            <select @bind="line.CardRef" title="which card instance">
                                <option value="@CardRef.ThisCard">this card</option>
                                <option value="@CardRef.TriggeringCard">the played card</option>
                            </select>
                        }
                        @if (info.UsesZone)
                        {
                            <span class="amount-label">to</span>
                            <select @bind="line.MoveToZone" title="destination pile">
                                @foreach (var z in Enum.GetValues<CardZone>())
                                {
                                    <option value="@z">@z</option>
                                }
                            </select>
                        }
                        @if (info.UsesRuleName)
                        {
                            <input @bind="line.RuleName" placeholder="rule name" style="width:8rem" title="which named rule to remove" />
                        }
                        @if (line.Kind == EffectKind.DealDamage)
                        {
                            <label title="ignore block (true damage)"><input type="checkbox" @bind="line.IgnoresBlock" /> true</label>
                        }
                        @if (line.Kind == EffectKind.ApplyStatus)
                        {
                            <input type="number" @bind="line.DurationTurns" style="width:4rem" title="duration (turns, 0 = none)" />
                            <span class="amount-label">turns</span>
                        }
                    }
                    else if (line.Line == LineKind.If)
                    {
                        <span>if</span>
                        <select @bind="line.ConditionLeft">
                            @foreach (var a in ReadSources)
                            {
                                <option value="@a">@AmountSourceLabel(a)</option>
                            }
                        </select>
                        <select @bind="line.ConditionOp">
                            @foreach (var op in Enum.GetValues<ComparisonOperator>())
                            {
                                <option value="@op">@OperatorLabel(op)</option>
                            }
                        </select>
                        <select @bind="line.ConditionRightSource">
                            <option value="@AmountSource.Constant">a number</option>
                            @foreach (var a in ReadSources)
                            {
                                <option value="@a">@AmountSourceLabel(a)</option>
                            }
                        </select>
                        @if (line.ConditionRightSource == AmountSource.Constant)
                        {
                            <input type="number" @bind="line.ConditionRight" style="width:4rem" />
                        }
                    }
                    else if (line.Line == LineKind.Repeat)
                    {
                        <span>repeat</span>
                        <input type="number" @bind="line.RepeatCount" style="width:4rem" />
                        <span>times</span>
                    }
                    else if (line.Line == LineKind.ForEach)
                    {
                        <span>for each</span>
                        <select @bind="line.ForEachOver">
                            <option value="@EffectTarget.AllEnemies">enemy</option>
                            <option value="@EffectTarget.AllAllies">ally</option>
                            <option value="@EffectTarget.DamagedAllies">damaged ally</option>
                            <option value="@EffectTarget.AllCombatants">combatant</option>
                        </select>
                    }
                    else if (line.Line == LineKind.Causal)
                    {
                        <span>in order (reactions settle between steps)</span>
                    }
                    else if (line.Line == LineKind.RandomTargets)
                    {
                        <span>for</span>
                        <input type="number" @bind="line.RepeatCount" style="width:4rem" />
                        <span>random</span>
                        <select @bind="line.ForEachOver">
                            <option value="@EffectTarget.AllEnemies">enemy</option>
                            <option value="@EffectTarget.AllAllies">ally</option>
                            <option value="@EffectTarget.AllCombatants">combatant</option>
                        </select>
                    }
                    else if (line.Line == LineKind.RepeatUntil)
                    {
                        <span>repeat until</span>
                        <select @bind="line.ConditionLeft">
                            @foreach (var a in ReadSources)
                            {
                                <option value="@a">@AmountSourceLabel(a)</option>
                            }
                        </select>
                        <select @bind="line.ConditionOp">
                            @foreach (var op in Enum.GetValues<ComparisonOperator>())
                            {
                                <option value="@op">@OperatorLabel(op)</option>
                            }
                        </select>
                        <select @bind="line.ConditionRightSource">
                            <option value="@AmountSource.Constant">a number</option>
                            @foreach (var a in ReadSources)
                            {
                                <option value="@a">@AmountSourceLabel(a)</option>
                            }
                        </select>
                        @if (line.ConditionRightSource == AmountSource.Constant)
                        {
                            <input type="number" @bind="line.ConditionRight" style="width:4rem" />
                        }
                    }
                    else if (line.Line == LineKind.InstallRule)
                    {
                        <span>install rule on</span>
                        <select @bind="line.RuleEvent">
                            @foreach (var ev in TempRuleEvents)
                            {
                                <option value="@ev">@TriggerEventLabel(ev)</option>
                            }
                        </select>
                        <span class="amount-label">named</span>
                        <input @bind="line.RuleName" placeholder="(optional)" style="width:7rem" title="name so a Remove rule can target it" />
                        <select @bind="line.RuleLifetime" title="lifetime">
                            @foreach (var lk in Enum.GetValues<RuleLifetimeKind>())
                            {
                                <option value="@lk">@RuleLifetimeLabel(lk)</option>
                            }
                        </select>
                        @if (line.RuleLifetime == RuleLifetimeKind.Activations)
                        {
                            <input type="number" @bind="line.RuleActivations" style="width:4rem" />
                            <span class="amount-label">times</span>
                        }
                        else if (line.RuleLifetime == RuleLifetimeKind.UntilRound)
                        {
                            <span class="amount-label">until round</span>
                            <input type="number" @bind="line.RuleExpiryRound" style="width:4rem" />
                        }
                    }

                    <button class="del" @onclick="() => effects.Remove(line)">✕</button>
                </div>

                @if (line.Line == LineKind.Effect)
                {
                    <div class="effect-desc">@DescribeEffect(line)</div>
                }
                else if (line.Line == LineKind.If)
                {
                    <div class="nested"><div class="nested-label">then</div>@EffectEditor(line.Then)</div>
                    <div class="nested"><div class="nested-label">else</div>@EffectEditor(line.Else)</div>
                }
                else
                {
                    <div class="nested"><div class="nested-label">do</div>@EffectEditor(line.Body)</div>
                }
            </div>
        }
    };

    private static readonly AmountSource[] ReadSources =
    {
        AmountSource.SelfCurrentHp, AmountSource.SelfMissingHp, AmountSource.SelfMaxHp, AmountSource.SelfStatusStacks,
        AmountSource.TargetCurrentHp, AmountSource.TargetMissingHp, AmountSource.TargetMaxHp,
        AmountSource.TargetBlock, AmountSource.TargetDefensivePool, AmountSource.TargetStatusStacks, AmountSource.CardsInHand,
        AmountSource.EventAmount,
        AmountSource.SelfHealthPercent, AmountSource.TargetHealthPercent,
        AmountSource.SelfEnergy, AmountSource.SelfMaxEnergy, AmountSource.SelfMissingEnergy,
        AmountSource.SelfResourceCurrent, AmountSource.SelfResourceMax, AmountSource.SelfResourceMissing,
        AmountSource.SelfBuffStacks, AmountSource.SelfDebuffStacks,
        AmountSource.TargetBuffStacks, AmountSource.TargetDebuffStacks,
        AmountSource.RoundNumber, AmountSource.TurnNumber,
        AmountSource.SelfCardsPlayedThisTurn, AmountSource.SelfDamageDealtThisTurn,
    };

    private static string ArithmeticOpLabel(ArithmeticOp op) => op switch
    {
        ArithmeticOp.None => "(as is)",
        ArithmeticOp.Multiply => "×",
        ArithmeticOp.Divide => "÷",
        ArithmeticOp.Add => "+",
        ArithmeticOp.Subtract => "−",
        ArithmeticOp.Modulo => "mod",
        ArithmeticOp.Min => "min",
        ArithmeticOp.Max => "max",
        _ => op.ToString(),
    };

    private static string LineKindLabel(LineKind k) => k switch
    {
        LineKind.Effect => "effect",
        LineKind.If => "if…",
        LineKind.Repeat => "repeat…",
        LineKind.ForEach => "for each…",
        LineKind.Causal => "in order…",
        LineKind.RandomTargets => "random…",
        LineKind.RepeatUntil => "until…",
        LineKind.InstallRule => "install rule…",
        _ => k.ToString(),
    };

    // Events an unbound temporary rule can listen for (the cleanly-unbindable subset of TriggerEvent).
    private static readonly TriggerEvent[] TempRuleEvents =
    {
        TriggerEvent.TurnStarted, TriggerEvent.TurnEnded, TriggerEvent.DamageTaken, TriggerEvent.DamageDealt,
        TriggerEvent.Healed, TriggerEvent.CardPlayed, TriggerEvent.ResourceGained, TriggerEvent.CardCostPaid,
    };

    private static string RuleLifetimeLabel(RuleLifetimeKind k) => k switch
    {
        RuleLifetimeKind.Unlimited => "forever",
        RuleLifetimeKind.OneShot => "once",
        RuleLifetimeKind.Activations => "N times",
        RuleLifetimeKind.UntilRound => "until round",
        _ => k.ToString(),
    };

    private static string OperatorLabel(ComparisonOperator op) => op switch
    {
        ComparisonOperator.Equal => "=",
        ComparisonOperator.NotEqual => "≠",
        ComparisonOperator.Less => "<",
        ComparisonOperator.LessOrEqual => "≤",
        ComparisonOperator.Greater => ">",
        ComparisonOperator.GreaterOrEqual => "≥",
        _ => op.ToString(),
    };
}
