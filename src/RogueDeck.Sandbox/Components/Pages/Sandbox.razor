    // The standard statuses plus every custom status the user has defined.
    private IReadOnlyList<StatusInfo> AllStatuses() =>
        EffectCatalog.Statuses
            .Concat(_model.Statuses.Select(s => new StatusInfo(
                ScenarioComposer.Slug(s.Name), s.Name, EffectCatalog.DescribePassiveModifier(s))))
            .ToList();

    private StatusInfo? StatusInfoFor(string id) => AllStatuses().FirstOrDefault(s => s.Id == id);

    private string DescribeEffect(EffectLineModel line)
    {
        var kind = EffectCatalog.For(line.Kind);
        var description = kind.Description;
        if (kind.UsesStatus && StatusInfoFor(line.StatusId) is { } status)
            description += $" — {status.Label}: {status.Description}";
        return description;
    }

