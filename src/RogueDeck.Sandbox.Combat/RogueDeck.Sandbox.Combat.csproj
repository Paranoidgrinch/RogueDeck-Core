<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <!-- Components-only reference (not the full ASP.NET Core framework) so the library loads under browser-wasm
         (RogueDeck.Studio.Web) as well as in the server host. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RogueDeck.Core\RogueDeck.Core.csproj" />
    <ProjectReference Include="..\RogueDeck.Scenario\RogueDeck.Scenario.csproj" />
  </ItemGroup>

</Project>
