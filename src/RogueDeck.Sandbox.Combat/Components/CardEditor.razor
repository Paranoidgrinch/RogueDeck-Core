@rendermode InteractiveServer
@using System.Text.Json
@inject CardDraft Draft

<section style="padding:1rem; max-width:64rem">
    <h1>Card authoring (data)</h1>
    <p class="muted">Author a card's effect <code>Program</code> visually; anything outside the visual subset stays
        editable as <code>CardData</code> JSON below (both round-trip through <code>CombatJson</code>).</p>

    <div style="margin:0.6rem 0">
        <span class="muted">Program:</span>
        @if (_card is null)
        {
            <span class="error"> — fix the JSON below, then Parse</span>
        }
        else if (_model is not null)
        {
            <CombatProgramEditor Node="_model" NodeChanged="OnModelChanged" />
        }
        else if (_card.Program is null)
        {
            <span class="muted"> no program yet — </span>
            <button class="mini" @onclick="AddProgram">+ program</button>
        }
        else
        {
            <span class="muted"> — advanced program (outside the visual subset); edit as JSON below</span>
        }
    </div>

    <details style="margin:0.6rem 0">
        <summary class="muted">CardData JSON (advanced / escape)</summary>
        <textarea style="width:100%; height:20rem; font-family:monospace; font-size:0.85rem" @bind="_json" @bind:event="oninput"></textarea>
        <div style="margin:0.4rem 0">
            <button class="play" @onclick="Validate">Parse &amp; validate</button>
            <button class="play" @onclick="LoadDemo">Reset demo</button>
        </div>
    </details>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }
    @if (_summary is not null)
    {
        <pre style="background:#1b1f27; color:#cbd5e1; padding:0.75rem; border-radius:6px">@_summary</pre>
    }
</section>

@code {
    private readonly JsonSerializerOptions _options = CombatJson.CreateOptions<CardPlayContext>();
    // The card JSON lives in the circuit-scoped CardDraft so switching tabs keeps it (see CardDraft).
    private string _json { get => Draft.Json ?? ""; set => Draft.Json = value; }
    private string? _error;
    private string? _summary;

    // The last successfully-parsed card + its program classified into the visual model (null = no/advanced program).
    private CardData? _card;
    private CombatNodeModel? _model;

    protected override void OnInitialized()
    {
        if (Draft.Json is null)
            LoadDemo();
        else
            Validate(); // rebuild _card/_model from the persisted draft
    }

    private void LoadDemo()
    {
        _json = JsonSerializer.Serialize(DemoCard(), _options);
        Validate();
    }

    private void Validate()
    {
        _error = null;
        _summary = null;
        try
        {
            var data = JsonSerializer.Deserialize<CardData>(_json, _options)
                ?? throw new InvalidOperationException("Deserialized to null.");
            // Prove it maps to a runnable definition.
            _ = data.ToBlueprint().Compile().Build();

            _card = data;
            _model = data.Program is { } program ? CombatProgramModel.Classify(program) : null;

            var root = data.Program?.Root;
            _summary =
                $"✔ Deserialized and compiled card '{data.Id}'.\n" +
                $"  costs: {data.Costs.Count}   tags: {data.Tags.Count}\n" +
                $"  program root: {root?.GetType().Name ?? "(none)"}" +
                (root is null ? "" : $" ({root.Children.Count} children)") + "\n" +
                $"  visual editor: {(_model is not null ? "yes" : "no (JSON)")}";
        }
        catch (Exception ex)
        {
            _card = null;
            _model = null;
            _error = $"{ex.GetType().Name}: {ex.Message}";
        }
    }

    // A visual edit rebuilds the card's program from the model and re-serializes it into the JSON draft, keeping the
    // two views in sync (the JSON textarea is the escape / advanced view of the same document).
    private void OnModelChanged(CombatNodeModel node)
    {
        if (_card is null)
            return;
        _model = node;
        _card = _card with { Program = CombatProgramModel.Build<CardPlayContext>(node) };
        _json = JsonSerializer.Serialize(_card, _options);
    }

    private void AddProgram() => OnModelChanged(CombatProgramModel.NewNode("dealDamage"));

    private static CardData DemoCard()
    {
        // Uses catalog target selectors so the demo program classifies into the visual editor out of the box.
        var card = new CardBlueprint("cleave")
        {
            Program = new EffectProgram<CardPlayContext>(
                new SequenceEffectNode<CardPlayContext>(new IEffectNode<CardPlayContext>[]
                {
                    new DealDamageNode<CardPlayContext>(
                        CombatantTargetSelectors.AllEnemiesOfSource, new ConstantExpression<CardPlayContext>(8)),
                    new GainBlockNode<CardPlayContext>(
                        CombatantTargetSelectors.Source, new ConstantExpression<CardPlayContext>(5)),
                })),
        };
        card.Cost(new ResourceId("energy"), 1);
        card.Tags.Add(new TagId("attack"));
        return CardData.From(card);
    }
}
