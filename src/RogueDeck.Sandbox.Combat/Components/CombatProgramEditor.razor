@* Recursive visual editor for one combat effect node (CombatNodeModel). A leaf (deal damage / heal / gain block /
   gain resource) renders as a one-line row; a composite (sequence / for-each / repeat / if) renders as a titled
   block whose sub-nodes recurse back into this same component — so the markup lives in ONE place and serves every
   depth. It is context-FREE: it edits a CombatNodeModel only; the host classifies a program into a model to feed
   it and builds a model back into an EffectProgram<TContext> on change (that TContext boundary stays in the host).
   Anything outside the modelled subset never reaches here — the host keeps the JSON escape when Classify returns
   null. See CombatProgramModel for the classify/build layer this drives. *@

@if (CombatProgramModel.IsComposite(Node.Kind))
{
    <div class="fx-block">
        <div class="run-bar">
            @KindSelect
            @if (Node.Kind == "forEachTarget")
            {
                <span class="muted">of</span>
                @SelectorSelect(CombatProgramModel.SelectorKeys, Node.SelectorKey, key => Set(Node with { SelectorKey = key }))
            }
            else if (Node.Kind == "forEachCardInZone")
            {
                <span class="muted">of</span>
                @SelectorSelect(CombatProgramModel.SelectorKeys, Node.SelectorKey, key => Set(Node with { SelectorKey = key }))
                <span class="muted">in</span>
                @ZoneSelect(Node.FromZone, z => Set(Node with { FromZone = z }))
                <span class="muted">only</span>
                <input value="@Node.ToDefinition" style="width:7rem" placeholder="any card"
                       @onchange="e => Set(Node with { ToDefinition = AsString(e.Value) })" />
            }
            else if (Node.Kind == "repeat")
            {
                @AmountControls(Node.AmountOrDefault, spec => Set(Node with { Amount = spec }))
                <span class="muted">×</span>
            }
            else if (Node.Kind == "conditional")
            {
                @ConditionControls(Node.Condition ?? new CombatConditionSpec(), spec => Set(Node with { Condition = spec }))
            }
            @RemoveButton
        </div>

        @if (Node.Kind == "sequence")
        {
            var children = Node.ChildrenOrEmpty;
            @for (var i = 0; i < children.Count; i++)
            {
                var ix = i;
                <div class="fx-body">
                    <CombatProgramEditor Node="children[ix]"
                                         NodeChanged="c => ReplaceChild(ix, c)"
                                         Removed="() => RemoveChild(ix)" />
                </div>
            }
            <div class="fx-body">
                <span class="muted">add:</span>
                @foreach (var (kind, label) in CombatProgramModel.AllKinds)
                {
                    var k = kind;
                    <button class="mini" @onclick="() => AddChild(k)">+ @label</button>
                }
            </div>
        }
        else if (Node.Kind == "conditional")
        {
            var children = Node.ChildrenOrEmpty;
            var thenNode = children.Count > 0 ? children[0] : CombatProgramModel.NewNode("dealDamage");
            <div class="fx-body">
                <span class="muted">then:</span>
                <CombatProgramEditor Node="thenNode" NodeChanged="SetThen" />
            </div>
            @if (children.Count > 1)
            {
                <div class="fx-body">
                    <span class="muted">else:</span>
                    <CombatProgramEditor Node="children[1]" NodeChanged="SetElse" Removed="RemoveElse" />
                </div>
            }
            else
            {
                <div class="fx-body">
                    <button class="mini" @onclick="AddElse">+ else</button>
                </div>
            }
        }
        else
        {
            @* forEachTarget / repeat: a single body node *@
            var children = Node.ChildrenOrEmpty;
            var body = children.Count > 0 ? children[0] : CombatProgramModel.NewNode("dealDamage");
            <div class="fx-body">
                <CombatProgramEditor Node="body" NodeChanged="SetBody" />
            </div>
        }
    </div>
}
else
{
    <span class="fx">
        @KindSelect
        @if (CombatProgramModel.UsesSelector(Node.Kind))
        {
            @SelectorSelect(CombatProgramModel.SelectorKeys, Node.SelectorKey, key => Set(Node with { SelectorKey = key }))
        }
        @if (CombatProgramModel.UsesLifecycleState(Node.Kind))
        {
            <select value="@Node.LifecycleState" @onchange="e => Set(Node with { LifecycleState = ParseLifecycleState(e.Value) })">
                @foreach (var s in Enum.GetValues<CombatantLifecycleState>())
                {
                    <option value="@s" selected="@(s == Node.LifecycleState)">@s</option>
                }
            </select>
        }
        @if (CombatProgramModel.UsesTeamId(Node.Kind))
        {
            <input value="@Node.TeamId" style="width:7rem" placeholder="team id"
                   @onchange="e => Set(Node with { TeamId = AsString(e.Value) })" />
        }
        @if (CombatProgramModel.UsesCombatResult(Node.Kind))
        {
            <select value="@Node.CombatResult" @onchange="e => Set(Node with { CombatResult = ParseCombatResult(e.Value) })">
                @foreach (var r in Enum.GetValues<CombatResult>())
                {
                    <option value="@r" selected="@(r == Node.CombatResult)">@r</option>
                }
            </select>
        }
        @if (CombatProgramModel.UsesRuleId(Node.Kind))
        {
            <input value="@Node.RuleId" style="width:9rem" placeholder="temporary rule id"
                   @onchange="e => Set(Node with { RuleId = AsString(e.Value) })" />
        }
        @if (CombatProgramModel.UsesSummon(Node.Kind))
        {
            <input value="@Node.TeamId" style="width:6rem" placeholder="team id"
                   @onchange="e => Set(Node with { TeamId = AsString(e.Value) })" />
            <input value="@Node.SummonDefinitionId" style="width:7rem" placeholder="definition id"
                   @onchange="e => Set(Node with { SummonDefinitionId = AsString(e.Value) })" />
            <input value="@Node.SummonDisplayName" style="width:7rem" placeholder="display name"
                   @onchange="e => Set(Node with { SummonDisplayName = AsString(e.Value) })" />
            <span class="muted">HP</span>
            @AmountControls(Node.AmountOrDefault, spec => Set(Node with { Amount = spec }))
            <label class="muted"><input type="checkbox" checked="@HasPosition"
                   @onchange="e => TogglePosition(AsBool(e.Value))" /> at</label>
            @if (HasPosition)
            {
                <input type="number" value="@Node.PositionX" style="width:3rem" placeholder="x"
                       @onchange="e => Set(Node with { PositionX = AsInt(e.Value, 0) })" />
                <input type="number" value="@Node.PositionY" style="width:3rem" placeholder="y"
                       @onchange="e => Set(Node with { PositionY = AsInt(e.Value, 0) })" />
            }
            <div class="fx-body">
                <span class="muted">starting statuses:</span>
                @{
                    var grants = Node.StartingStatusesOrEmpty;
                }
                @for (var i = 0; i < grants.Count; i++)
                {
                    var ix = i;
                    var g = grants[ix];
                    <span class="fx">
                        <input value="@g.StatusDefinitionId.value" style="width:8rem" placeholder="status id"
                               @onchange="e => UpdateGrant(ix, g with { StatusDefinitionId = new StatusDefinitionId(AsString(e.Value)) })" />
                        <span class="muted">stacks</span>
                        <input type="number" value="@g.Stacks" style="width:3.5rem"
                               @onchange="e => UpdateGrant(ix, g with { Stacks = AsInt(e.Value, g.Stacks) })" />
                        <span class="muted">turns</span>
                        <input type="number" value="@g.DurationTurns" style="width:3.5rem"
                               @onchange="e => UpdateGrant(ix, g with { DurationTurns = AsInt(e.Value, g.DurationTurns) })" />
                        <span class="muted">charges</span>
                        <input type="number" value="@g.Charges" style="width:3.5rem"
                               @onchange="e => UpdateGrant(ix, g with { Charges = AsInt(e.Value, g.Charges) })" />
                        <button class="mini" @onclick="() => RemoveGrant(ix)">✕</button>
                    </span>
                }
                <button class="mini" @onclick="AddGrant">+ status</button>
            </div>
        }
        @if (CombatProgramModel.UsesAmount(Node.Kind))
        {
            @AmountControls(Node.AmountOrDefault, spec => Set(Node with { Amount = spec }))
        }
        @if (Node.Kind == "dealDamage")
        {
            <input value="@Node.Element" style="width:6rem" placeholder="element"
                   @onchange="e => Set(Node with { Element = AsString(e.Value) })" />
            <label class="muted"><input type="checkbox" checked="@Node.IgnoresBlock"
                   @onchange="e => Set(Node with { IgnoresBlock = AsBool(e.Value) })" /> ignores block</label>
        }
        @if (CombatProgramModel.UsesResourceId(Node.Kind))
        {
            <input value="@Node.ResourceId" style="width:8rem" placeholder="resource id"
                   @onchange="e => Set(Node with { ResourceId = AsString(e.Value) })" />
        }
        @if (CombatProgramModel.UsesPoolId(Node.Kind))
        {
            <input value="@Node.PoolId" style="width:8rem" placeholder="pool id"
                   @onchange="e => Set(Node with { PoolId = AsString(e.Value) })" />
        }
        @if (CombatProgramModel.UsesResourceSelection(Node.Kind))
        {
            @ResourceSelectionControls(Node.ResourceSelectionOrDefault, spec => Set(Node with { ResourceSelection = spec }))
        }
        @if (CombatProgramModel.UsesDefaultMax(Node.Kind))
        {
            <span class="muted">max</span>
            <input type="number" value="@Node.DefaultMax" style="width:4rem"
                   placeholder="@(Node.Kind == "gainResource" ? "uncapped" : "")"
                   @onchange="e => Set(Node with { DefaultMax = AsNullableInt(e.Value) })" />
        }
        @if (CombatProgramModel.UsesMinMax(Node.Kind))
        {
            <span class="muted">min</span>
            <input type="number" value="@Node.Min" style="width:4rem" placeholder="none"
                   @onchange="e => Set(Node with { Min = AsNullableInt(e.Value) })" />
            <span class="muted">max</span>
            <input type="number" value="@Node.Max" style="width:4rem" placeholder="none"
                   @onchange="e => Set(Node with { Max = AsNullableInt(e.Value) })" />
        }
        @if (CombatProgramModel.UsesStatusId(Node.Kind))
        {
            <input value="@Node.StatusId" style="width:8rem" placeholder="status id"
                   @onchange="e => Set(Node with { StatusId = AsString(e.Value) })" />
        }
        @if (CombatProgramModel.UsesCounterId(Node.Kind))
        {
            <input value="@Node.CounterId" style="width:8rem" placeholder="counter id"
                   @onchange="e => Set(Node with { CounterId = AsString(e.Value) })" />
            <label class="muted"><input type="checkbox" checked="@Node.Relative"
                   @onchange="e => Set(Node with { Relative = AsBool(e.Value) })" /> relative</label>
        }
        @if (Node.Kind == "applyStatus")
        {
            <span class="muted">turns</span>
            <input type="number" value="@Node.DurationTurns" style="width:3.5rem"
                   @onchange="e => Set(Node with { DurationTurns = AsInt(e.Value, Node.DurationTurns) })" />
            <span class="muted">charges</span>
            <input type="number" value="@Node.Charges" style="width:3.5rem"
                   @onchange="e => Set(Node with { Charges = AsInt(e.Value, Node.Charges) })" />
        }
        @if (Node.Kind == "cleanse")
        {
            <select value="@Node.Polarity"
                    @onchange="e => Set(Node with { Polarity = ParsePolarity(e.Value) })">
                @foreach (var p in Enum.GetValues<StatusPolarity>())
                {
                    <option value="@p" selected="@(p == Node.Polarity)">@p</option>
                }
            </select>
        }
        @if (CombatProgramModel.UsesStatusSelection(Node.Kind))
        {
            @SelectionControls(Node.SelectionOrDefault, spec => Set(Node with { Selection = spec }))
        }
        @if (CombatProgramModel.UsesToSelector(Node.Kind))
        {
            <span class="muted">to</span>
            @SelectorSelect(CombatProgramModel.SelectorKeys, Node.ToSelectorKey, key => Set(Node with { ToSelectorKey = key }))
        }
        @if (CombatProgramModel.UsesZones(Node.Kind))
        {
            <span class="muted">from</span>
            <select value="@Node.FromZone" @onchange="e => Set(Node with { FromZone = ParseZone(e.Value) })">
                @foreach (var z in Enum.GetValues<CardZone>())
                {
                    <option value="@z" selected="@(z == Node.FromZone)">@z</option>
                }
            </select>
            <span class="muted">to</span>
            <select value="@Node.ToZone" @onchange="e => Set(Node with { ToZone = ParseZone(e.Value) })">
                @foreach (var z in Enum.GetValues<CardZone>())
                {
                    <option value="@z" selected="@(z == Node.ToZone)">@z</option>
                }
            </select>
        }
        @if (CombatProgramModel.UsesCard(Node.Kind))
        {
            @CardControls(Node.CardOrDefault, spec => Set(Node with { Card = spec }))
        }
        @if (CombatProgramModel.UsesMoveToZone(Node.Kind))
        {
            <span class="muted">to</span>
            @ZoneSelect(Node.ToZone, z => Set(Node with { ToZone = z }))
            <select value="@Node.Placement" @onchange="e => Set(Node with { Placement = ParsePlacement(e.Value) })">
                @foreach (var p in Enum.GetValues<ZonePlacement>())
                {
                    <option value="@p" selected="@(p == Node.Placement)">@(p == ZonePlacement.Top ? "on top" : "at bottom")</option>
                }
            </select>
        }
        @if (Node.Kind == "transformCard")
        {
            <span class="muted">→</span>
            <input value="@Node.ToDefinition" style="width:9rem" placeholder="target definition id"
                   @onchange="e => Set(Node with { ToDefinition = AsString(e.Value) })" />
        }
        @if (Node.Kind == "createCardInstance")
        {
            <input value="@Node.ToDefinition" style="width:9rem" placeholder="card definition id"
                   @onchange="e => Set(Node with { ToDefinition = AsString(e.Value) })" />
        }
        @if (CombatProgramModel.UsesCreateZone(Node.Kind))
        {
            <span class="muted">into</span>
            @ZoneSelect(Node.ToZone, z => Set(Node with { ToZone = z }))
        }
        @if (CombatProgramModel.UsesMovement(Node.Kind))
        {
            <select value="@Node.MovementMode"
                    @onchange="e => Set(CombatProgramModel.WithMovementMode(Node, ParseMovementMode(e.Value)))">
                @foreach (var m in Enum.GetValues<MovementMode>())
                {
                    <option value="@m" selected="@(m == Node.MovementMode)">@m</option>
                }
            </select>
            @if (Node.MovementMode == MovementMode.ToAbsolute)
            {
                <span class="muted">x</span>
                @AmountControls(Node.MoveX ?? CombatAmountSpec.FromConst(0), spec => Set(Node with { MoveX = spec }))
                <span class="muted">y</span>
                @AmountControls(Node.MoveY ?? CombatAmountSpec.FromConst(0), spec => Set(Node with { MoveY = spec }))
            }
            else
            {
                <span class="muted">step</span>
                @AmountControls(Node.MoveStep ?? CombatAmountSpec.FromConst(1), spec => Set(Node with { MoveStep = spec }))
            }
        }
        @RemoveButton
    </span>
}

@code {
    [Parameter] public CombatNodeModel Node { get; set; } = new();
    [Parameter] public EventCallback<CombatNodeModel> NodeChanged { get; set; }

    // Set by a parent that renders this node as a removable list item (a sequence child / an else branch); when it
    // has no delegate (the program root, a fixed body slot) no ✕ is shown.
    [Parameter] public EventCallback Removed { get; set; }

    private static string AsString(object? v) => v?.ToString() ?? "";
    private static int AsInt(object? v, int fallback) => int.TryParse(v?.ToString(), out var n) ? n : fallback;
    // Blank input ⇒ null (an uncapped max / no clamp); otherwise the parsed int.
    private static int? AsNullableInt(object? v) => int.TryParse(v?.ToString(), out var n) ? n : (int?)null;
    private static bool AsBool(object? v) => v is bool b ? b : bool.TryParse(v?.ToString(), out var p) && p;
    private static MovementMode ParseMovementMode(object? v) =>
        Enum.TryParse<MovementMode>(AsString(v), out var m) ? m : MovementMode.ToAbsolute;
    private static CombatantLifecycleState ParseLifecycleState(object? v) =>
        Enum.TryParse<CombatantLifecycleState>(AsString(v), out var s) ? s : CombatantLifecycleState.Alive;
    private static CombatResult ParseCombatResult(object? v) =>
        Enum.TryParse<CombatResult>(AsString(v), out var r) ? r : CombatResult.Ongoing;
    private static StatusPolarity ParsePolarity(object? v) =>
        Enum.TryParse<StatusPolarity>(AsString(v), out var p) ? p : StatusPolarity.Debuff;
    private static CardZone ParseZone(object? v) =>
        Enum.TryParse<CardZone>(AsString(v), out var z) ? z : CardZone.Hand;
    private static ZonePlacement ParsePlacement(object? v) =>
        Enum.TryParse<ZonePlacement>(AsString(v), out var p) ? p : ZonePlacement.Bottom;

    private void Set(CombatNodeModel node) => _ = NodeChanged.InvokeAsync(node);

    // ── summon combatant: position + starting-status list ────────────────────────
    private bool HasPosition => Node.PositionX is not null && Node.PositionY is not null;

    private void TogglePosition(bool on) =>
        Set(on ? Node with { PositionX = 0, PositionY = 0 } : Node with { PositionX = null, PositionY = null });

    private void AddGrant() =>
        Set(Node with { StartingStatuses = Node.StartingStatusesOrEmpty.Append(new StatusGrant(new StatusDefinitionId("poison"), 1)).ToList() });

    private void RemoveGrant(int i)
    {
        var list = Node.StartingStatusesOrEmpty.ToList();
        if (i >= 0 && i < list.Count)
            list.RemoveAt(i);
        Set(Node with { StartingStatuses = list.Count > 0 ? list : null });
    }

    private void UpdateGrant(int i, StatusGrant grant)
    {
        var list = Node.StartingStatusesOrEmpty.ToList();
        if (i >= 0 && i < list.Count)
            list[i] = grant;
        Set(Node with { StartingStatuses = list });
    }

    // ── node kind + shared widgets ───────────────────────────────────────────────
    private RenderFragment KindSelect => builder =>
    {
        builder.OpenElement(0, "select");
        builder.AddAttribute(1, "value", Node.Kind);
        builder.AddAttribute(2, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(
            this, e => Set(CombatProgramModel.ChangeKind(Node, AsString(e.Value)))));
        var seq = 3;
        foreach (var (kind, label) in CombatProgramModel.AllKinds)
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", kind);
            builder.AddContent(seq++, label);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    private RenderFragment RemoveButton => builder =>
    {
        if (!Removed.HasDelegate)
            return;
        builder.OpenElement(0, "button");
        builder.AddAttribute(1, "class", "mini");
        builder.AddAttribute(2, "onclick", EventCallback.Factory.Create(this, () => Removed.InvokeAsync()));
        builder.AddContent(3, "✕");
        builder.CloseElement();
    };

    private RenderFragment SelectorSelect(IEnumerable<string> keys, string current, Action<string> onChange) => builder =>
    {
        builder.OpenElement(0, "select");
        builder.AddAttribute(1, "value", current);
        builder.AddAttribute(2, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(AsString(e.Value))));
        var seq = 3;
        foreach (var key in keys)
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", key);
            builder.AddContent(seq++, key);
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    // A CardZone dropdown, reused by the targeted card ops and the card-selector widget.
    private RenderFragment ZoneSelect(CardZone current, Action<CardZone> onChange) => builder =>
    {
        builder.OpenElement(0, "select");
        builder.AddAttribute(1, "value", current.ToString());
        builder.AddAttribute(2, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e => onChange(ParseZone(e.Value))));
        var seq = 3;
        foreach (var z in Enum.GetValues<CardZone>())
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", z.ToString());
            builder.AddAttribute(seq++, "selected", z == current);
            builder.AddContent(seq++, z.ToString());
            builder.CloseElement();
        }
        builder.CloseElement();
    };

    // The card-selector widget (which card a targeted card op points at): a kind dropdown (position / player-chooses /
    // random / current-loop-card) plus its zone, and either a position index (inZone) or a prompt (chosen).
    private static readonly (string Kind, string Label)[] CardKinds =
    {
        ("inZone", "at position"),
        ("chosen", "player chooses"),
        ("random", "random"),
        ("iterated", "current (loop card)"),
    };

    private RenderFragment CardControls(CombatCardSpec spec, Action<CombatCardSpec> onChange) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "select");
        builder.AddAttribute(seq++, "value", spec.Kind);
        builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            onChange(spec with { Kind = AsString(e.Value) })));
        foreach (var (kind, label) in CardKinds)
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", kind);
            builder.AddContent(seq++, label);
            builder.CloseElement();
        }
        builder.CloseElement();

        if (spec.UsesZone)
        {
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "value", spec.Zone.ToString());
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                onChange(spec with { Zone = ParseZone(e.Value) })));
            foreach (var z in Enum.GetValues<CardZone>())
            {
                builder.OpenElement(seq++, "option");
                builder.AddAttribute(seq++, "value", z.ToString());
                builder.AddAttribute(seq++, "selected", z == spec.Zone);
                builder.AddContent(seq++, z.ToString());
                builder.CloseElement();
            }
            builder.CloseElement();
        }

        if (spec.Kind == "inZone")
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "muted");
            builder.AddContent(seq++, "#");
            builder.CloseElement();
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "value", spec.Index);
            builder.AddAttribute(seq++, "style", "width:3.5rem");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                onChange(spec with { Index = AsInt(e.Value, spec.Index) })));
            builder.CloseElement();
        }
        else if (spec.Kind == "chosen")
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "value", spec.Purpose);
            builder.AddAttribute(seq++, "style", "width:9rem");
            builder.AddAttribute(seq++, "placeholder", "prompt");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                onChange(spec with { Purpose = AsString(e.Value) })));
            builder.CloseElement();
        }
    };

    // Amount: a kind dropdown (constant / event amount / a combatant counter) plus its parameter — an int input for a
    // constant, or a single-target selector + counter-id for a counter read (e.g. "equal to your combo counter").
    private RenderFragment AmountControls(CombatAmountSpec spec, Action<CombatAmountSpec> onChange) => builder =>
    {
        var seq = 0;
        builder.OpenElement(seq++, "select");
        builder.AddAttribute(seq++, "value", spec.Kind);
        builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            onChange(AmountForKind(AsString(e.Value), spec))));
        foreach (var (kind, label) in new[] { ("const", "constant"), ("event", "event amount"), ("counter", "counter") })
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", kind);
            builder.AddContent(seq++, label);
            builder.CloseElement();
        }
        builder.CloseElement();

        if (spec.Kind == "counter")
        {
            builder.AddContent(seq++, SelectorSelect(
                CombatProgramModel.SingleTargetSelectorKeys, spec.SelectorKey, key => onChange(spec with { SelectorKey = key })));
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "value", spec.CounterId);
            builder.AddAttribute(seq++, "style", "width:7rem");
            builder.AddAttribute(seq++, "placeholder", "counter id");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                onChange(spec with { CounterId = AsString(e.Value) })));
            builder.CloseElement();
        }
        else if (spec.Kind != "event")
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "value", spec.Const);
            builder.AddAttribute(seq++, "style", "width:4rem");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                onChange(CombatAmountSpec.FromConst(AsInt(e.Value, spec.Const)))));
            builder.CloseElement();
        }
    };

    // Seed a fresh amount spec when the amount KIND changes, carrying over the counter target/id sensibly.
    private static CombatAmountSpec AmountForKind(string kind, CombatAmountSpec prev) => kind switch
    {
        "event" => CombatAmountSpec.Event,
        "counter" => CombatAmountSpec.Counter(
            prev.SelectorKey == "" ? "source" : prev.SelectorKey, prev.CounterId == "" ? "combo" : prev.CounterId),
        _ => CombatAmountSpec.FromConst(prev.Const),
    };

    // Status-instance selection (removeSelectedStatus / modifySelectedStatusStacks / stealSelectedStatus): which ONE
    // status on the target — a polarity filter, a pick mode (first / random), and an index for the first-pick.
    private RenderFragment SelectionControls(StatusSelectionSpec spec, Action<StatusSelectionSpec> onChange) => builder =>
    {
        var seq = 0;
        // polarity filter
        builder.OpenElement(seq++, "select");
        builder.AddAttribute(seq++, "value", spec.Polarity.ToString());
        builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            onChange(spec with { Polarity = ParseSelectionPolarity(e.Value) })));
        foreach (var f in Enum.GetValues<StatusPolarityFilter>())
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", f.ToString());
            builder.AddAttribute(seq++, "selected", f == spec.Polarity);
            builder.AddContent(seq++, f.ToString().ToLowerInvariant());
            builder.CloseElement();
        }
        builder.CloseElement();

        // pick mode
        builder.OpenElement(seq++, "select");
        builder.AddAttribute(seq++, "value", spec.Pick.ToString());
        builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            onChange(spec with { Pick = ParseStatusPick(e.Value) })));
        foreach (var p in Enum.GetValues<StatusPick>())
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", p.ToString());
            builder.AddAttribute(seq++, "selected", p == spec.Pick);
            builder.AddContent(seq++, p.ToString().ToLowerInvariant());
            builder.CloseElement();
        }
        builder.CloseElement();

        // index (only meaningful for the deterministic first-pick)
        if (spec.Pick == StatusPick.First)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "muted");
            builder.AddContent(seq++, "#");
            builder.CloseElement();
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "value", spec.Index);
            builder.AddAttribute(seq++, "style", "width:3.5rem");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                onChange(spec with { Index = AsInt(e.Value, spec.Index) })));
            builder.CloseElement();
        }
    };

    private static StatusPolarityFilter ParseSelectionPolarity(object? v) =>
        Enum.TryParse<StatusPolarityFilter>(AsString(v), out var f) ? f : StatusPolarityFilter.Any;
    private static StatusPick ParseStatusPick(object? v) =>
        Enum.TryParse<StatusPick>(AsString(v), out var p) ? p : StatusPick.First;

