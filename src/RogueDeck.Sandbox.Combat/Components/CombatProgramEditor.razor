    // ── condition widget (for the conditional node) ──────────────────────────────
    private static readonly (string Kind, string Label)[] ConditionKinds =
    {
        ("compare", "value compares"),
        ("hasStatus", "has status"),
        ("isAlive", "is alive"),
        ("downed", "is downed"),
        ("exists", "exists"),
    };

    private static readonly (string Kind, string Label)[] CompareValues =
    {
        ("currentHealth", "current HP"),
        ("maxHealth", "max HP"),
        ("missingHealth", "missing HP"),
        ("healthPercentage", "HP %"),
        ("currentResource", "resource…"),
        ("statusStacks", "status stacks…"),
    };

    private RenderFragment ConditionControls(CombatConditionSpec spec, Action<CombatConditionSpec> onChange) => builder =>
    {
        var seq = 0;
        // condition kind
        builder.OpenElement(seq++, "select");
        builder.AddAttribute(seq++, "value", spec.Kind);
        builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            onChange(spec with { Kind = AsString(e.Value) })));
        foreach (var (kind, label) in ConditionKinds)
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", kind);
            builder.AddContent(seq++, label);
            builder.CloseElement();
        }
        builder.CloseElement();

        // target selector (single-target only — scalar reads reject multi-target selectors)
        builder.OpenElement(seq++, "select");
        builder.AddAttribute(seq++, "value", spec.SelectorKey);
        builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
            onChange(spec with { SelectorKey = AsString(e.Value) })));
        foreach (var key in CombatProgramModel.SingleTargetSelectorKeys)
        {
            builder.OpenElement(seq++, "option");
            builder.AddAttribute(seq++, "value", key);
            builder.AddContent(seq++, key);
            builder.CloseElement();
        }
        builder.CloseElement();

        if (spec.Kind == "compare")
        {
            // value kind
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "value", spec.ValueKind);
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                onChange(spec with { ValueKind = AsString(e.Value) })));
            foreach (var (kind, label) in CompareValues)
            {
                builder.OpenElement(seq++, "option");
                builder.AddAttribute(seq++, "value", kind);
                builder.AddContent(seq++, label);
                builder.CloseElement();
            }
            builder.CloseElement();

            // operator
            builder.OpenElement(seq++, "select");
            builder.AddAttribute(seq++, "value", spec.Op.ToString());
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                onChange(spec with { Op = Enum.Parse<ComparisonOperator>(AsString(e.Value)) })));
            foreach (var op in Enum.GetValues<ComparisonOperator>())
            {
                builder.OpenElement(seq++, "option");
                builder.AddAttribute(seq++, "value", op.ToString());
                builder.AddContent(seq++, OpSymbol(op));
                builder.CloseElement();
            }
            builder.CloseElement();

            // right-hand constant
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "value", spec.Right);
            builder.AddAttribute(seq++, "style", "width:4rem");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                onChange(spec with { Right = AsInt(e.Value, spec.Right) })));
            builder.CloseElement();

            if (spec.ValueKind is "currentResource" or "statusStacks")
            {
                builder.OpenElement(seq++, "input");
                builder.AddAttribute(seq++, "value", spec.Id);
                builder.AddAttribute(seq++, "style", "width:8rem");
                builder.AddAttribute(seq++, "placeholder", spec.ValueKind == "currentResource" ? "resource id" : "status id");
                builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                    onChange(spec with { Id = AsString(e.Value) })));
                builder.CloseElement();
            }
        }
        else if (spec.Kind == "hasStatus")
        {
            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "value", spec.Id);
            builder.AddAttribute(seq++, "style", "width:8rem");
            builder.AddAttribute(seq++, "placeholder", "status id");
            builder.AddAttribute(seq++, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                onChange(spec with { Id = AsString(e.Value) })));
            builder.CloseElement();
        }
    };

    private static string OpSymbol(ComparisonOperator op) => op switch
    {
        ComparisonOperator.Equal => "=",
        ComparisonOperator.NotEqual => "≠",
        ComparisonOperator.Less => "<",
        ComparisonOperator.LessOrEqual => "≤",
        ComparisonOperator.Greater => ">",
        ComparisonOperator.GreaterOrEqual => "≥",
        _ => op.ToString(),
    };

    // ── children / body / branch mutation ────────────────────────────────────────
    private void ReplaceChild(int i, CombatNodeModel child)
    {
        var list = Node.ChildrenOrEmpty.ToList();
        if (i >= 0 && i < list.Count)
            list[i] = child;
        Set(Node with { Children = list });
    }

    private void RemoveChild(int i)
    {
        var list = Node.ChildrenOrEmpty.ToList();
        if (i >= 0 && i < list.Count)
            list.RemoveAt(i);
        Set(Node with { Children = list });
    }

    private void AddChild(string kind) =>
        Set(Node with { Children = Node.ChildrenOrEmpty.Append(CombatProgramModel.NewNode(kind)).ToList() });

    private void SetBody(CombatNodeModel body) => Set(Node with { Children = new[] { body } });

    private void SetThen(CombatNodeModel then)
    {
        var children = Node.ChildrenOrEmpty;
        Set(Node with { Children = children.Count > 1 ? new[] { then, children[1] } : new[] { then } });
    }

    private void SetElse(CombatNodeModel @else)
    {
        var then = Node.ChildrenOrEmpty.Count > 0 ? Node.ChildrenOrEmpty[0] : CombatProgramModel.NewNode("dealDamage");
        Set(Node with { Children = new[] { then, @else } });
    }

    private void AddElse() => SetElse(CombatProgramModel.NewNode("dealDamage"));

    private void RemoveElse()
    {
        var then = Node.ChildrenOrEmpty.Count > 0 ? Node.ChildrenOrEmpty[0] : CombatProgramModel.NewNode("dealDamage");
        Set(Node with { Children = new[] { then } });
    }
}
